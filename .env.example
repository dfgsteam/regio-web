# Website URL / Domain
SITE_URL=https://regio.hnld.de

# CiviCRM APIv4 at https://civi.smj-wegweiser.de (build-time only)
CIVICRM_API_KEY=
# Only required when AuthX uses the site-key guard.
CIVICRM_SITE_KEY=
# Set to false after the old CiviCRM instance is shut down.
CIVICRM_LEGACY_LINKS_ENABLED=true

# Contact form mail transport
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@smj-wegweiser.de
# Matomo Analytics (Cookie-Free & Privacy-Friendly)
PUBLIC_MATOMO_URL=https://tracking.hunold24.de/
PUBLIC_MATOMO_SITE_ID=6

INSTAGRAM_ACCESS_TOKEN=

# Toolbox: configure these in the web host's PHP environment, not only in .env.
AUTHENTIK_URL=https://auth.smj-wegweiser.de
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
TOOLBOX_APP_SECRET=
TOOLBOX_REDIRECT_URI=https://smj-wegweiser.de/toolbox-auth/callback.php
TOOLBOX_ALLOWED_GROUPS=
