# Lokaler Build und Sync: als .env oder .env.local im Projektroot speichern.
# Diese Datei NICHT auf den Webserver hochladen. In GitHub werden die Werte
# unter Settings -> Secrets and variables -> Actions hinterlegt.

# Website-URL fuer Canonical-Links, Sitemap und QR-Codes.
SITE_URL=https://regio.hnld.de

# CiviCRM APIv4: nur beim Sync/Build, nicht fuer die PHP-Laufzeit.
CIVICRM_API_KEY=
# Nur falls AuthX einen Site-Key verlangt.
CIVICRM_SITE_KEY=
# Nach Abschaltung des alten CiviCRM auf false setzen.
CIVICRM_LEGACY_LINKS_ENABLED=true

# Optionaler Kalender-Feed; ohne Wert wird der feste Google-Kalender genutzt.
CALENDAR_ICS_URL=

# Oeffentliche Matomo-Konfiguration fuer den Build.
PUBLIC_MATOMO_URL=https://tracking.hunold24.de/
PUBLIC_MATOMO_SITE_ID=6

# Nur fuer manuellen Aufruf von npm run sync:instagram, nicht im Deploy-Workflow.
INSTAGRAM_ACCESS_TOKEN=
GEMINI_API_KEY=
