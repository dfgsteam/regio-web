# ==============================================================================
# Apache Configuration for SMJ Regio Wegweiser (Astro Static / Plesk Webhosting)
# ==============================================================================

# 1. Custom Error Pages (404 Not Found)
# ------------------------------------------------------------------------------
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /404.html

# 2. Character Encoding & UTF-8
# ------------------------------------------------------------------------------
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .xml .ics

# 3. MIME Types
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType text/calendar .ics
  AddType image/svg+xml .svg .svgz
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType application/manifest+json .webmanifest
</IfModule>

# 4. URL Rewriting & Clean Routing
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect old WordPress URLs (Backward Compatibility)
  RewriteRule ^veranstaltungen/?(.*)$ /abenteuer/$1 [R=301,L]
  RewriteRule ^zeltlager/?(.*)$ /abenteuer/zeltlager/$1 [R=301,L]

  # Ensure trailing slash for directory routes (e.g. /ueber-uns -> /ueber-uns/)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,5}|/)$
  RewriteRule ^(.*)$ /$1/ [L,R=301]

  # If requested physical file exists, serve directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # If directory with index.html exists, serve index.html
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)/?$ /$1/index.html [L]

  # Fallback to 404 page if no route matches
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /404.html [L]
</IfModule>

# 5. Security Headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# 6. GZIP Compression
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/rss+xml application/atom+xml
  AddOutputFilterByType DEFLATE text/calendar
</IfModule>

# 7. Browser Caching (Leverage Browser Cache)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Default expiration
  ExpiresDefault "access plus 1 month"

  # HTML: Always check for updates (1 hour)
  ExpiresByType text/html "access plus 1 hour"

  # ICS Calendar Feed: Frequent check (1 hour)
  ExpiresByType text/calendar "access plus 1 hour"

  # Static Assets (Images, Fonts, Hashed Astro CSS/JS): 1 Year
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# 8. Disable Directory Browsing
# ------------------------------------------------------------------------------
Options -Indexes
