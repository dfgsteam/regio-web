---
import { getCollection } from 'astro:content'
import ContentLayout from '../../layouts/ContentLayout.astro'
import Container from '../../components/common/Container.astro'
import Eyebrow from '../../components/common/Eyebrow.astro'

const posts = await getCollection('posts', ({ data }) => !data.draft)
const sorted = posts.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
---

<ContentLayout
  title="Journal – SMJ Regio Wegweiser"
  description="Aktuelle Berichte, Vereinsnachrichten, pädagogische Einblicke und Geschichten aus der Region Wegweiser."
>
  <section class="texture-paper relative bg-paper pb-24 pt-40 text-forest-950">
    <Container>
      <Eyebrow label="Journal & Vereinsleben" muted />
      <h1 class="display display-xl mt-6 text-forest-950">
        Berichte, Einblicke<br />
        <span class="text-orange whitespace-nowrap">&amp; Vereinsleben.</span>
      </h1>
      <p class="mt-8 max-w-2xl leading-relaxed text-forest-950/75">
        Neuigkeiten aus der Region, Verbandsentscheidungen, Einblicke in unser Leitungsmodell und Geschichten von Zeltlagern und Aktionen.
      </p>
    </Container>
  </section>

  <section class="bg-forest-950 py-20">
    <Container class="space-y-14">
      {sorted.map((post) => (
        <article class="grid gap-8 border-t border-paper/15 pt-10 lg:grid-cols-[1fr_1.4fr]">
          <div>
            <p class="mono-label">
              {post.data.publishedAt.toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' })} · {post.data.author}
            </p>
            {post.data.tags.length > 0 && (
              <p class="mono-label mt-3 text-orange">{post.data.tags.join(' · ')}</p>
            )}
          </div>
          <div class="grid gap-8 sm:grid-cols-[220px_1fr]">
            <img
              src={post.data.image.src}
              alt={post.data.image.alt}
              loading="lazy"
              class="aspect-[4/3] w-full object-cover"
            />
            <div>
              <h2 class="display display-md text-paper">
                <a href={`/journal/${post.id}/`} class="transition-colors hover:text-orange">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-4 max-w-xl leading-relaxed text-paper/75">{post.data.description}</p>
              <a href={`/journal/${post.id}/`} class="mt-5 inline-block border-b-2 border-orange pb-1 font-mono text-xs font-bold uppercase tracking-[0.2em] text-paper transition-colors hover:text-orange">
                Weiterlesen →
              </a>
            </div>
          </div>
        </article>
      ))}
    </Container>
  </section>
</ContentLayout>
