---
import ContentLayout from '../../../layouts/ContentLayout.astro'
import Container from '../../../components/common/Container.astro'
import Eyebrow from '../../../components/common/Eyebrow.astro'
import Button from '../../../components/common/Button.astro'
import { getAllCamps, getCurrentCamp } from '../../../lib/camps'

const [currentCamp, camps] = await Promise.all([getCurrentCamp(), getAllCamps()])
---

<ContentLayout
  title="Zeltlager – SMJ Regio Wegweiser"
  description="Das Zeltlager der SMJ Regio Wegweiser: jedes Jahr ein neues Motto, jedes Jahr zehn Tage, die anders sind als alles davor."
>
  <section class="texture-paper relative bg-paper pb-24 pt-40 text-forest-950">
    <Container>
      <Eyebrow label="Abenteuer · Zeltlager" muted />
      <h1 class="display display-xl mt-6 text-forest-950">
        Das große<br />
        <span class="text-orange">Ding.</span>
      </h1>
    </Container>
  </section>

  {currentCamp ? (
    <section class="bg-forest-950 pb-20 pt-8">
      <Container>
        <div class="grid items-center gap-12 lg:grid-cols-[1.2fr_1fr]">
          <div>
            <p class="eyebrow mb-4">Zeltlager {currentCamp.data.year}</p>
            <h2 class="display display-lg text-paper">{currentCamp.data.motto}</h2>
            <p class="mt-6 max-w-xl leading-relaxed text-paper/75">{currentCamp.data.story}</p>
            <div class="mt-10">
              <Button href={`/abenteuer/zeltlager/${currentCamp.data.year}/`} variant="primary" size="lg">
                Zum Zeltlager {currentCamp.data.year}
              </Button>
            </div>
          </div>
          <img
            src={currentCamp.data.theme.assets.hero}
            alt={`Zeltlager ${currentCamp.data.year} – ${currentCamp.data.motto}`}
            class="aspect-[3/4] w-full object-cover"
            loading="lazy"
          />
        </div>
      </Container>
    </section>
  ) : (
    <section class="bg-forest-950 py-24">
      <Container>
        <p class="font-mono text-sm uppercase tracking-[0.18em] text-muted">
          Das nächste Zeltlager wird gerade vorbereitet. Schau bald wieder vorbei.
        </p>
      </Container>
    </section>
  )}

  {camps.length > 1 && (
    <section class="bg-forest-900 py-20">
      <Container>
        <Eyebrow label="Vergangene Lager" />
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {camps
            .filter((camp) => camp.data.year !== currentCamp?.data.year)
            .map((camp) => (
              <a
                href={`/abenteuer/zeltlager/${camp.data.year}/`}
                class="group border border-paper/15 bg-forest-950 p-6 transition-colors hover:border-orange"
              >
                <p class="mono-label">Zeltlager {camp.data.year}</p>
                <h3 class="display display-sm mt-3 text-paper transition-colors group-hover:text-orange">
                  {camp.data.motto}
                </h3>
                <p class="mt-3 text-sm text-paper/60">
                  {camp.data.date.start.toLocaleDateString('de-DE')} – {camp.data.date.end.toLocaleDateString('de-DE')} · {camp.data.location.name}
                </p>
              </a>
            ))}
        </div>
      </Container>
    </section>
  )}
</ContentLayout>
