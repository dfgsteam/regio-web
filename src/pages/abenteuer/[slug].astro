---
import ContentLayout from '../../layouts/ContentLayout.astro'
import Container from '../../components/common/Container.astro'
import Eyebrow from '../../components/common/Eyebrow.astro'
import Button from '../../components/common/Button.astro'
import {
  Calendar,
  MapPin,
  Target,
  Banknote,
  Check,
  Phone,
} from '@lucide/astro'
import {
  eventProvider,
  formatDateRange,
  formatAgeRange,
  getEventTemplateType,
  getSlugVariants,
} from '../../lib/events'
import type { Event } from '../../lib/events'

import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const [events, camps] = await Promise.all([
    eventProvider.getEvents(),
    getCollection('camps'),
  ])
  const campYears = new Set(camps.map((c) => c.data.year))

  // Only filter out camps that already have a dedicated MDX page in camps collection (e.g. 2026, 2027)
  const nonDedicatedCampEvents = events.filter((event) => {
    const isCamp = event.category === 'camp' || event.title.toLowerCase().includes('zeltlager')
    if (!isCamp) return true
    const eventYear = event.start.getFullYear()
    return !campYears.has(eventYear)
  })

  const paths: { params: { slug: string }; props: { event: Event } }[] = []
  const seenSlugs = new Set<string>()

  for (const event of nonDedicatedCampEvents) {
    const variants = getSlugVariants(event.slug, event.title, event.start.getFullYear())
    for (const slug of variants) {
      if (slug === 'zeltlager') continue
      if (!seenSlugs.has(slug)) {
        seenSlugs.add(slug)
        paths.push({
          params: { slug },
          props: { event },
        })
      }
    }
  }

  return paths
}

interface Props {
  event?: Event
}

let event = Astro.props.event
if (!event) {
  const currentSlug = Astro.params.slug
  const allEvents = await eventProvider.getEvents()
  event = allEvents.find((e) => {
    const variants = getSlugVariants(e.slug, e.title, e.start.getFullYear())
    return variants.includes(currentSlug ?? '')
  })
}

if (!event) {
  return Astro.redirect('/abenteuer/')
}
const templateType = getEventTemplateType(event.title, event.category)
const age = formatAgeRange(event.ageMin, event.ageMax)
const formattedDate = formatDateRange(event.start, event.end)
const isPast = event.end < new Date()

// Determine template eyebrow and badges
const eyebrowLabel = isPast
  ? templateType === 'actionwochenende'
    ? 'Actionwochenende · Rückblick & Historie'
    : templateType === 'sterntreffen'
      ? 'Sterntreffen · Rückblick & Historie'
      : 'Veranstaltung · Rückblick & Historie'
  : templateType === 'actionwochenende'
    ? 'Actionwochenende · SMJ Regio Wegweiser'
    : templateType === 'sterntreffen'
      ? 'Sterntreffen · Zeltlager-Nachtreffen'
      : 'Veranstaltung · SMJ Regio Wegweiser'

const eventStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  description: event.teaser ?? event.description,
  startDate: event.start.toISOString(),
  endDate: event.end.toISOString(),
  eventStatus: isPast ? 'https://schema.org/EventMovedOnline' : 'https://schema.org/EventScheduled',
  location: {
    '@type': 'Place',
    name: event.location,
    address: event.address ?? event.location,
  },
  offers: event.price && !isPast
    ? {
        '@type': 'Offer',
        price: event.price.replace(/[^0-9]/g, ''),
        priceCurrency: 'EUR',
        availability: 'https://schema.org/InStock',
        url: event.registrationUrl,
      }
    : undefined,
}
---

<ContentLayout
  title={`${event.title} – SMJ Regio Wegweiser`}
  description={event.teaser ?? `${event.title} der SMJ Regio Wegweiser vom ${formattedDate}.`}
  image={event.image ?? '/placeholders/wide.svg'}
  structuredData={eventStructuredData}
>
  <!-- Header / Hero Section -->
  <section class="texture-topo relative overflow-hidden bg-forest-950 pb-16 pt-36 sm:pt-44 border-b border-paper/10">
    <div class="texture-grain absolute inset-0 opacity-50" aria-hidden="true" />

    <Container class="relative">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <Eyebrow label={eyebrowLabel} />
        {isPast ? (
          <span class="border border-paper/30 bg-forest-900 px-3 py-1 font-mono text-[0.65rem] font-bold uppercase tracking-[0.2em] text-paper/70">
            Historie · Abgeschlossen
          </span>
        ) : templateType === 'actionwochenende' ? (
          <span class="border border-orange/40 bg-orange/10 px-3 py-1 font-mono text-[0.65rem] font-bold uppercase tracking-[0.2em] text-orange">
            100% Analog
          </span>
        ) : null}
      </div>

      <!-- Main Title: Fit in one line on desktop/tablets -->
      <h1 class="display text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl mt-4 text-paper max-w-5xl tracking-tight leading-[0.92]">
        {event.title}
      </h1>

      <!-- Meta Badges -->
      <div class="mt-8 flex flex-wrap gap-4 font-mono text-xs uppercase tracking-[0.16em] text-paper">
        <div class="inline-flex items-center gap-2 border border-paper/20 bg-forest-900 px-4 py-2">
          <Calendar class="h-4 w-4 text-orange" />
          <span>{formattedDate}</span>
        </div>
        {event.location && (
          <div class="inline-flex items-center gap-2 border border-paper/20 bg-forest-900 px-4 py-2">
            <MapPin class="h-4 w-4 text-orange" />
            <span>{event.location}</span>
          </div>
        )}
        {age && (
          <div class="inline-flex items-center gap-2 border border-paper/20 bg-forest-900 px-4 py-2">
            <Target class="h-4 w-4 text-orange" />
            <span>{age}</span>
          </div>
        )}
        {event.price && (
          <div class="inline-flex items-center gap-2 border border-orange/40 bg-forest-900 px-4 py-2 text-orange font-bold">
            <Banknote class="h-4 w-4 text-orange" />
            <span>{event.price.split('(')[0]?.trim()}</span>
          </div>
        )}
      </div>
    </Container>
  </section>

  <!-- Main Content & Details Grid -->
  <section class="bg-forest-950 py-16 sm:py-24">
    <Container class="grid gap-14 lg:grid-cols-[1.5fr_1fr] items-start">
      <!-- Left Column: Story, Highlights, Info & Google Maps -->
      <div class="space-y-14">
        {event.description && (
          <div>
            <h2 class="display display-sm text-paper mb-6">
              {templateType === 'blanko' ? 'Über die Veranstaltung' : isPast ? 'Rückblick & Programm' : 'Was geht ab?'}
            </h2>
            <p class="text-base sm:text-lg leading-relaxed text-paper/80 whitespace-pre-line">
              {event.description}
            </p>
          </div>
        )}

        <!-- Highlights (rendered if present) -->
        {event.highlights && event.highlights.length > 0 && (
          <div id="highlights-container">
            <h2 class="display display-sm text-paper mb-6">Die Highlights</h2>
            <div class="grid gap-4 sm:grid-cols-2">
              {event.highlights.map((highlight, index) => (
                <div class="highlight-card border-2 border-paper/15 bg-forest-900 p-5 transition-all hover:border-orange">
                  <span class="font-mono text-xs text-orange font-bold block mb-2">0{index + 1}</span>
                  <p class="font-display text-lg uppercase text-paper">{highlight}</p>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Packing List (rendered if present) -->
        {event.packingList && event.packingList.length > 0 && (
          <div id="packing-list-container" class="border-2 border-paper/15 bg-forest-900 p-7 sm:p-9">
            <div class="flex items-center justify-between gap-4 mb-6">
              <h2 class="display display-sm text-paper">Was muss mit? (Packliste)</h2>
              <span class="mono-label text-xs text-orange">Checkliste</span>
            </div>
            <ul class="grid gap-3 sm:grid-cols-2">
              {event.packingList.map((item) => (
                <li class="packing-item flex items-start gap-3 text-sm text-paper/85 font-mono">
                  <Check class="h-4 w-4 text-orange shrink-0 mt-0.5" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Parent & Safety Info for Actionwochenende & Sterntreffen -->
        {(templateType === 'actionwochenende' || templateType === 'sterntreffen') && (
          <div class="border-l-2 border-orange bg-forest-900/70 p-6 sm:p-8">
            <p class="eyebrow mb-2">Wichtig für Eltern & Teilnehmer</p>
            <h3 class="display text-2xl text-paper mb-4">Echtes Miteinander & Sicherheit</h3>
            <p class="text-sm leading-relaxed text-paper/85 mb-4">
              <strong>Elektronische Geräte wie Handy oder Tablet bleiben zu Hause:</strong> Wir setzen auf echtes Miteinander, echte Erlebnisse und ungestörte Gemeinschaft im Wald und am Kamin.
            </p>
            <p class="text-sm leading-relaxed text-paper/75 mb-4">
              Die Aktion wird von geschulten und erfahrenen Gruppenleitern der SMJ Regio Wegweiser verantwortungsvoll geleitet.
            </p>
            <p class="inline-flex items-center gap-2 font-mono text-xs text-orange">
              <Phone class="h-4 w-4 text-orange shrink-0" />
              <span>Für Eltern: Im Notfall ist die Leitung rund um die Uhr telefonisch erreichbar.</span>
            </p>
          </div>
        )}

        <!-- Location & Google Maps Section (Left side at the end) -->
        {(event.location || event.address) && (
          <div class="border-2 border-paper/15 bg-forest-900 p-7 sm:p-9">
            <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
              <div>
                <p class="eyebrow mb-1">Anfahrt & Standort</p>
                <h2 class="display display-sm text-paper">{event.location}</h2>
                {event.address && (
                  <p class="font-mono text-xs text-paper/70 mt-1">{event.address}</p>
                )}
              </div>
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(event.address || event.location || '')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 border border-paper/20 bg-forest-950 px-4 py-2 font-mono text-xs font-bold uppercase tracking-[0.14em] text-paper transition-colors hover:border-orange hover:text-orange"
              >
                <MapPin class="h-3.5 w-3.5 text-orange" />
                <span>In Google Maps öffnen ↗</span>
              </a>
            </div>

            <div class="relative overflow-hidden border border-paper/20 bg-forest-950 aspect-[16/9] sm:aspect-[21/9]">
              <iframe
                src={
                  (event.address?.toLowerCase().includes('thalwenden') || event.location?.toLowerCase().includes('wiesental'))
                    ? 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1964.2454756106645!2d10.039520446705568!3d51.35948962622321!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47a4cf150cc882b7%3A0x4fa94a70581fdedf!2sWiesental!5e1!3m2!1sen!2sde!4v1786707983103!5m2!1sen!2sde'
                    : `https://maps.google.com/maps?q=${encodeURIComponent(event.address || event.location || 'Pater-Kentenich-Weg 3, 37308 Heilbad Heiligenstadt')}&t=&z=15&ie=UTF8&iwloc=&output=embed`
                }
                class="absolute inset-0 h-full w-full border-0 grayscale invert contrast-125 opacity-85 hover:grayscale-0 hover:invert-0 hover:opacity-100 transition-all duration-300"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title={`Karte von ${event.location}`}
              />
            </div>
          </div>
        )}
      </div>

      <!-- Right Column: Sticky Action & Factsheet Box -->
      <aside class="sticky top-28 space-y-6">
        <div class="border-2 border-orange bg-forest-900 p-7 sm:p-8 shadow-2xl">
          <p class="eyebrow mb-2">Fakten & Details</p>
          <h3 class="display display-sm text-paper">
            {isPast ? 'Historie & Details' : event.registrationUrl ? 'Dabei sein' : 'Einfach vorbeikommen'}
          </h3>

          <dl class="mt-6 space-y-4 font-mono text-xs uppercase tracking-[0.14em] border-y border-paper/15 py-6">
            <div>
              <dt class="text-muted text-[0.68rem]">Zeitraum</dt>
              <dd class="text-paper text-sm mt-1 font-bold">{formattedDate}</dd>
            </div>
            {event.location && (
              <div>
                <dt class="text-muted text-[0.68rem]">Ort</dt>
                <dd class="text-paper mt-1">{event.location}</dd>
                {event.address && (
                  <dd class="text-paper/60 text-[0.7rem] normal-case mt-0.5">{event.address}</dd>
                )}
              </div>
            )}
            {age && (
              <div>
                <dt class="text-muted text-[0.68rem]">Zielgruppe</dt>
                <dd class="text-paper mt-1">{age}</dd>
              </div>
            )}
            {event.price && (
              <div>
                <dt class="text-muted text-[0.68rem]">Teilnahmebeitrag</dt>
                <dd class="text-orange text-sm font-bold mt-1">{event.price}</dd>
              </div>
            )}
          </dl>

          {isPast ? (
            <div class="mt-8 space-y-3">
              <div class="border border-paper/20 bg-forest-950 p-4 text-center">
                <p class="mono-label text-xs text-orange">Veranstaltung abgeschlossen</p>
                <p class="mt-2 text-xs text-paper/70">Dieses Event liegt in der Vergangenheit.</p>
              </div>
              <Button href="/abenteuer/" variant="ghost" class="w-full justify-center text-center">
                Kommende Termine ansehen
              </Button>
            </div>
          ) : event.registrationUrl ? (
            <div class="mt-8 space-y-3">
              <Button href={event.registrationUrl} variant="primary" size="lg" class="w-full justify-center text-center">
                Jetzt online anmelden
              </Button>
              {event.registrationDeadline && (
                <p class="mono-label text-center text-[0.65rem] text-paper/60">
                  Meldeschluss: {event.registrationDeadline.toLocaleDateString('de-DE')}
                </p>
              )}
            </div>
          ) : (
            <div class="mt-8 border-2 border-dashed border-orange/40 bg-forest-950 p-5 text-center space-y-2">
              <div class="inline-flex items-center gap-2 text-orange font-bold font-mono text-xs uppercase tracking-wider">
                <Check class="h-4 w-4 text-orange" />
                <span>Ohne Voranmeldung</span>
              </div>
              <p class="font-display text-lg text-paper uppercase">Einfach vorbeikommen!</p>
              <p class="text-xs text-paper/75 leading-relaxed">
                Für diese Veranstaltung ist keine Anmeldung erforderlich. Du kannst einfach direkt vorbeikommen und mitmachen!
              </p>
            </div>
          )}

          {event.contact && (
            <div class="mt-8 border-t border-paper/15 pt-6">
              <p class="mono-label mb-2 text-muted text-[0.68rem]">Fragen zur Veranstaltung?</p>
              <p class="font-display text-lg text-paper uppercase">{event.contact.name}</p>
              {event.contact.role && (
                <p class="font-mono text-xs text-orange">{event.contact.role}</p>
              )}
              {event.contact.phone && (
                <a
                  href={`tel:${event.contact.phone.replace(/\s+/g, '')}`}
                  class="mt-2 block font-mono text-xs text-paper/80 hover:text-orange underline"
                >
                  Tel.: {event.contact.phone}
                </a>
              )}
              {event.contact.email && (
                <a
                  href={`mailto:${event.contact.email}`}
                  class="mt-1 inline-block font-mono text-xs text-paper/80 hover:text-orange underline"
                >
                  {event.contact.email}
                </a>
              )}
            </div>
          )}
        </div>

        <div class="border border-paper/15 bg-forest-900/60 p-6 flex items-center justify-between gap-4">
          <div>
            <p class="font-display text-sm text-paper uppercase">Termin exportieren</p>
            <p class="font-mono text-[0.68rem] text-muted">Direkt in den Kalender laden</p>
          </div>
          <a
            href="/api/calendar.ics"
            class="inline-flex items-center gap-2 border border-paper/20 px-3 py-2 font-mono text-[0.68rem] font-bold uppercase tracking-[0.14em] text-paper transition-colors hover:border-orange hover:text-orange"
          >
            <Calendar class="h-3.5 w-3.5 text-orange" />
            <span>iCal</span>
          </a>
        </div>
      </aside>
    </Container>
  </section>

  <!-- Back Navigation -->
  <section class="border-t border-paper/10 bg-forest-900 py-12">
    <Container class="flex flex-wrap items-center justify-between gap-6">
      <a
        href="/abenteuer/"
        class="inline-flex items-center gap-3 font-mono text-xs font-bold uppercase tracking-[0.2em] text-paper transition-colors hover:text-orange"
      >
        ← Alle Termine ansehen
      </a>
      <a
        href="/abenteuer/zeltlager/"
        class="inline-flex items-center gap-3 font-mono text-xs font-bold uppercase tracking-[0.2em] text-orange transition-colors hover:underline"
      >
        Zum großen Sommerzeltlager →
      </a>
    </Container>
  </section>
</ContentLayout>

<script>
  import '../../scripts/animations/packing-list'
</script>
