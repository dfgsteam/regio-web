---
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import PostLayout from '../../layouts/PostLayout.astro'
import Container from '../../components/common/Container.astro'
import Eyebrow from '../../components/common/Eyebrow.astro'
import BrandIcon from '../../components/common/BrandIcon.astro'

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft && !data.disabled && data.active !== false)
  const sorted = posts.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  return sorted.map((post, idx) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: sorted[idx + 1] ?? null,
      nextPost: sorted[idx - 1] ?? null,
    },
  }))
}

interface Props {
  post: CollectionEntry<'posts'>
  prevPost: CollectionEntry<'posts'> | null
  nextPost: CollectionEntry<'posts'> | null
}

const { post, prevPost, nextPost } = Astro.props
const { data } = post
const { Content } = await render(post)

const date = data.publishedAt.toLocaleDateString('de-DE', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
})

// Reading time calculation (avg 200 words/min)
const words = (data.description + ' ' + (post.body || '')).trim().split(/\s+/).length
const readingTimeMinutes = Math.max(1, Math.ceil(words / 200))
---

<PostLayout
  title={`${data.title} – SMJ Regio Wegweiser`}
  description={data.description}
  image={data.image.src}
  imageAlt={data.image.alt}
  publishedAt={data.publishedAt}
  author={data.author}
  tags={data.tags}
>
  <article class="texture-paper relative bg-paper pb-16 pt-36 text-forest-950">
    <Container class="max-w-3xl">
      <!-- Breadcrumb Navigation -->
      <nav class="mb-6 flex items-center gap-2 font-mono text-[0.7rem] uppercase tracking-wider text-forest-950/60" aria-label="Breadcrumb">
        <a href="/" class="hover:text-orange transition-colors">Start</a>
        <span>/</span>
        <a href="/aktuelles/" class="hover:text-orange transition-colors">Aktuelles</a>
        <span>/</span>
        <span class="text-orange truncate max-w-[200px] sm:max-w-xs">{data.title}</span>
      </nav>

      <Eyebrow label={data.tags[0] || 'Bericht'} muted />
      <h1 class="display display-lg mt-4 text-forest-950">{data.title}</h1>

      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 border-y border-forest-950/15 py-3 font-mono text-xs text-forest-950/70">
        <time datetime={data.publishedAt.toISOString()} class="text-orange font-bold">
          {date}
        </time>
        <span>·</span>
        <span>{data.author}</span>
        <span>·</span>
        <span>ca. {readingTimeMinutes} Min. Lesezeit</span>
      </div>
    </Container>
  </article>

  <section class="bg-forest-950 py-16">
    <Container class="max-w-3xl">
      <figure class="mb-12 border-2 border-paper/15 overflow-hidden bg-forest-900">
        <img
          src={data.image.src}
          alt={data.image.alt}
          data-photo-viewer="true"
          data-caption={data.title}
          data-date={date}
          data-link-url={data.instagramUrl}
          class="aspect-[16/10] w-full object-cover cursor-zoom-in transition-transform duration-500 hover:scale-102"
        />
      </figure>

      <article class="prose-rough">
        <Content />
      </article>

      {data.instagramUrl && (
        <div class="mt-12 border border-paper/15 bg-forest-900/60 p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <BrandIcon name="instagram" class="h-6 w-6 fill-current text-orange shrink-0" />
            <div>
              <span class="mono-label text-[0.65rem] text-orange">// INSTAGRAM @REGIO.WEGWEISER</span>
              <p class="font-display text-lg text-paper uppercase mt-0.5">Diesen Beitrag auf Instagram ansehen</p>
            </div>
          </div>
          <a
            href={data.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 border border-orange bg-orange/10 px-5 py-2.5 font-mono text-xs font-bold uppercase tracking-wider text-orange hover:bg-orange hover:text-forest-950 transition-colors shrink-0"
          >
            <span>Auf Instagram öffnen</span>
            <span>↗</span>
          </a>
        </div>
      )}

      <!-- Previous / Next Article Navigation -->
      <nav class="mt-16 border-t border-paper/15 pt-8 grid gap-6 sm:grid-cols-2">
        {prevPost ? (
          <a
            href={`/aktuelles/${prevPost.id}/`}
            class="group border border-paper/15 bg-forest-900/50 p-5 transition-all hover:border-orange hover:bg-forest-900"
          >
            <span class="mono-label text-[0.62rem] text-paper/50 flex items-center gap-1">
              <span>←</span> <span>VORHERIGER BEITRAG</span>
            </span>
            <p class="display text-lg text-paper mt-1 group-hover:text-orange transition-colors line-clamp-2">
              {prevPost.data.title}
            </p>
          </a>
        ) : (
          <div />
        )}

        {nextPost && (
          <a
            href={`/aktuelles/${nextPost.id}/`}
            class="group border border-paper/15 bg-forest-900/50 p-5 text-right transition-all hover:border-orange hover:bg-forest-900 sm:col-start-2"
          >
            <span class="mono-label text-[0.62rem] text-paper/50 flex items-center justify-end gap-1">
              <span>NÄCHSTER BEITRAG</span> <span>→</span>
            </span>
            <p class="display text-lg text-paper mt-1 group-hover:text-orange transition-colors line-clamp-2">
              {nextPost.data.title}
            </p>
          </a>
        )}
      </nav>

      <div class="mt-10 text-center">
        <a href="/aktuelles/" class="inline-flex items-center gap-3 border-b-2 border-orange pb-1 font-mono text-xs font-bold uppercase tracking-[0.2em] text-paper transition-colors hover:text-orange">
          ← Zurück zur Beitragsübersicht
        </a>
      </div>
    </Container>
  </section>
</PostLayout>
