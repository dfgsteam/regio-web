---
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import PostLayout from '../../layouts/PostLayout.astro'
import Container from '../../components/common/Container.astro'
import Eyebrow from '../../components/common/Eyebrow.astro'

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft)
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

interface Props {
  post: CollectionEntry<'posts'>
}

const { post } = Astro.props
const { Content } = await render(post)
const { data } = post
---

<PostLayout
  title={`${data.title} – SMJ Regio Wegweiser`}
  description={data.description}
  image={data.image.src}
  publishedAt={data.publishedAt}
  author={data.author}
>
  <section class="texture-paper relative bg-paper pb-24 pt-40 text-forest-950">
    <Container>
      <Eyebrow label="Aktuelles" muted />
      <h1 class="display display-xl mt-6 max-w-5xl text-forest-950">{data.title}</h1>
      <p class="mono-label mt-6">
        {data.publishedAt.toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' })} · {data.author}
      </p>
      {data.tags.length > 0 && (
        <p class="mono-label mt-3 text-orange">{data.tags.join(' · ')}</p>
      )}
    </Container>
  </section>

  <section class="bg-forest-950 py-16">
    <Container class="max-w-4xl">
      <figure class="mb-14">
        <img src={data.image.src} alt={data.image.alt} class="aspect-[16/10] w-full object-cover" />
      </figure>
      <article class="prose-rough">
        <Content />
      </article>

      {data.instagramUrl && (
        <div class="mt-12 border border-paper/15 bg-forest-900/60 p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <span class="mono-label text-[0.65rem] text-orange">// INSTAGRAM @REGIO.WEGWEISER</span>
            <p class="font-display text-lg text-paper uppercase mt-1">Diesen Beitrag auf Instagram ansehen</p>
          </div>
          <a
            href={data.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 border border-orange bg-orange/10 px-5 py-2.5 font-mono text-xs font-bold uppercase tracking-wider text-orange hover:bg-orange hover:text-forest-950 transition-colors shrink-0"
          >
            <span>Auf Instagram öffnen</span>
            <span>↗</span>
          </a>
        </div>
      )}

      <a href="/aktuelles/" class="mt-14 inline-flex items-center gap-3 border-b-2 border-orange pb-1 font-mono text-xs font-bold uppercase tracking-[0.2em] text-paper transition-colors hover:text-orange">
        ← Zurück zu allen Beiträgen
      </a>
    </Container>
  </section>
</PostLayout>
