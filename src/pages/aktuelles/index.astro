---
import { getCollection } from 'astro:content'
import ContentLayout from '../../layouts/ContentLayout.astro'
import Container from '../../components/common/Container.astro'
import Eyebrow from '../../components/common/Eyebrow.astro'
import BrandIcon from '../../components/common/BrandIcon.astro'
import { Search, X, Calendar, ArrowUpDown } from '@lucide/astro'

const posts = await getCollection('posts', ({ data }) => !data.draft && !data.disabled && data.active !== false)
const sorted = posts.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())

// Extract unique years and count
const years = Array.from(new Set(sorted.map((p) => p.data.publishedAt.getFullYear()))).sort((a, b) => b - a)
const yearCounts = years.reduce((acc, y) => {
  acc[y] = sorted.filter((p) => p.data.publishedAt.getFullYear() === y).length
  return acc
}, {} as Record<number, number>)
---

<ContentLayout
  title="Aktuelles – SMJ Regio Wegweiser"
  description="Aktuelle Berichte, Vereinsnachrichten, Zeltlager-Rückblicke und Geschichten aus der Region Wegweiser mit interaktiver Suche und Jahresarchiv."
>
  <!-- Hero Section -->
  <section class="texture-paper relative bg-paper pb-20 pt-40 text-forest-950">
    <Container>
      <Eyebrow label="Journal & Berichte" muted />
      <h1 class="display display-xl mt-6 text-forest-950">
        Aktuelles aus der<br />
        <span class="text-orange">Region.</span>
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-forest-950/75">
        Geschichten vom Lagerfeuer, Einblicke in unsere Aktionen und offizielle Berichte der SMJ Regio Wegweiser.
      </p>
    </Container>
  </section>

  <!-- Filter, Search & Archive Bar -->
  <section class="bg-forest-900 border-y border-paper/15 py-6">
    <Container>
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <!-- Search Input -->
        <div class="relative flex-1 max-w-md">
          <label for="post-search" class="sr-only">Beiträge durchsuchen</label>
          <div class="relative">
            <input
              type="text"
              id="post-search"
              placeholder="Beiträge durchsuchen (z.B. Zeltlager, 2024, Burg)..."
              class="w-full bg-forest-950 border border-paper/20 px-4 py-2.5 pl-10 pr-10 font-mono text-xs text-paper placeholder:text-paper/40 focus:border-orange focus:outline-none transition-colors"
            />
            <Search class="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-orange" />
            <button
              id="search-clear"
              type="button"
              class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-paper/40 hover:text-orange transition-colors p-1"
              title="Suche zurücksetzen"
            >
              <X class="h-3.5 w-3.5" />
            </button>
          </div>
        </div>

        <!-- Sort Select & Result Count -->
        <div class="flex items-center gap-4">
          <div class="flex items-center gap-2">
            <ArrowUpDown class="h-3.5 w-3.5 text-orange shrink-0" />
            <select
              id="sort-select"
              class="bg-forest-950 border border-paper/20 px-3 py-2 font-mono text-xs text-paper focus:border-orange focus:outline-none"
            >
              <option value="date-desc">Neueste zuerst</option>
              <option value="date-asc">Älteste zuerst</option>
              <option value="title-asc">Titel A–Z</option>
            </select>
          </div>
          <span id="post-counter" class="font-mono text-xs text-paper/60 whitespace-nowrap">
            {sorted.length} {sorted.length === 1 ? 'Beitrag' : 'Beiträge'}
          </span>
        </div>
      </div>

      <!-- Year Filter Pills -->
      <div class="mt-4 pt-4 border-t border-paper/10 flex items-center gap-2 overflow-x-auto pb-1 text-xs">
        <span class="font-mono text-[0.65rem] uppercase text-paper/50 tracking-wider mr-1 shrink-0 flex items-center gap-1">
          <Calendar class="h-3 w-3 text-orange" />
          Jahr:
        </span>
        <button
          type="button"
          data-year-filter="all"
          class="year-filter-btn px-3 py-1 font-mono text-xs font-bold uppercase tracking-wider transition-colors shrink-0 bg-orange text-forest-950 border border-orange"
        >
          Alle ({sorted.length})
        </button>
        {
          years.map((y) => (
            <button
              type="button"
              data-year-filter={String(y)}
              class="year-filter-btn px-3 py-1 font-mono text-xs font-bold uppercase tracking-wider transition-colors shrink-0 bg-forest-950 text-paper/70 border border-paper/20 hover:border-orange hover:text-paper"
            >
              {y} ({yearCounts[y]})
            </button>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Posts Grid Section -->
  <section class="bg-forest-950 py-16 sm:py-24">
    <Container>
      <!-- No Results State -->
      <div id="no-results-message" class="hidden text-center py-16 border-2 border-dashed border-paper/15 p-8">
        <p class="font-display text-2xl text-paper">Keine passenden Beiträge gefunden</p>
        <p class="font-mono text-xs text-paper/60 mt-2 max-w-md mx-auto">
          Probiere einen anderen Suchbegriff oder setze die Filter zurück.
        </p>
        <button
          id="reset-filter-btn"
          type="button"
          class="mt-6 inline-flex items-center gap-2 border border-orange bg-orange px-5 py-2.5 font-mono text-xs font-bold uppercase tracking-wider text-forest-950 hover:bg-paper hover:border-paper transition-colors"
        >
          Filter zurücksetzen
        </button>
      </div>

      <div id="posts-grid" class="space-y-12">
        {sorted.map((post) => {
          const postYear = post.data.publishedAt.getFullYear()
          const searchKeywords = `${post.data.title} ${post.data.description} ${post.data.tags.join(' ')} ${postYear}`.toLowerCase()
          return (
            <article
              class="post-card group grid gap-8 border border-paper/10 bg-forest-900/40 p-6 transition-all hover:border-paper/25 sm:p-8 lg:grid-cols-[380px_1fr]"
              data-year={postYear}
              data-date={post.data.publishedAt.getTime()}
              data-title={post.data.title.toLowerCase()}
              data-search={searchKeywords}
            >
              <!-- Thumbnail Column -->
              <div class="relative overflow-hidden aspect-[16/10] bg-forest-950">
                <img
                  src={post.data.image.src}
                  alt={post.data.image.alt}
                  data-photo-viewer="true"
                  data-caption={post.data.title}
                  data-date={post.data.publishedAt.toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' })}
                  data-link-url={post.data.instagramUrl}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 cursor-zoom-in"
                />
                {post.data.tags.length > 0 && (
                  <span class="absolute bottom-2 left-2 bg-forest-950/90 px-2 py-0.5 font-mono text-[0.65rem] uppercase tracking-wider text-orange border border-paper/10">
                    {post.data.tags[0]}
                  </span>
                )}
                {post.data.instagramUrl && (
                  <span class="absolute top-2 right-2 bg-forest-950/80 p-1 text-orange border border-paper/10" title="Instagram Post">
                    <BrandIcon name="instagram" class="h-3.5 w-3.5 fill-current" />
                  </span>
                )}
              </div>

              <!-- Content Column -->
              <div class="flex flex-col justify-center">
                <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-xs text-paper/60 mb-3">
                  <time datetime={post.data.publishedAt.toISOString()} class="text-orange font-bold">
                    {post.data.publishedAt.toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' })}
                  </time>
                  <span>·</span>
                  <span class="text-paper/80">{post.data.author}</span>
                  {post.data.tags.length > 1 && (
                    <>
                      <span>·</span>
                      <span class="text-paper/60 uppercase tracking-wider text-[0.68rem]">
                        {post.data.tags.slice(1, 4).join(' · ')}
                      </span>
                    </>
                  )}
                </div>

                <h2 class="display display-md text-paper group-hover:text-orange transition-colors">
                  <a href={`/aktuelles/${post.id}/`}>
                    {post.data.title}
                  </a>
                </h2>

                <p class="mt-4 max-w-2xl text-sm sm:text-base leading-relaxed text-paper/75 line-clamp-3">
                  {post.data.description}
                </p>

                <div class="mt-6 flex items-center gap-6">
                  <a
                    href={`/aktuelles/${post.id}/`}
                    class="inline-flex items-center gap-2 border-b-2 border-orange pb-1 font-mono text-xs font-bold uppercase tracking-[0.2em] text-paper transition-all hover:text-orange hover:gap-3"
                  >
                    <span>Artikel lesen</span>
                    <span>→</span>
                  </a>

                  {post.data.instagramUrl && (
                    <a
                      href={post.data.instagramUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 font-mono text-[0.68rem] uppercase tracking-wider text-paper/50 transition-colors hover:text-orange"
                    >
                      <span>Instagram ↗</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          )
        })}
      </div>
    </Container>
  </section>
</ContentLayout>

<!-- Client-side Fast Filtering & Sorting Script -->
<script>
  function setupPostsFilter() {
    const searchInput = document.getElementById('posts-search-input') as HTMLInputElement | null
    const clearBtn = document.getElementById('posts-search-clear') as HTMLButtonElement | null
    const sortSelect = document.getElementById('posts-sort-select') as HTMLSelectElement | null
    const resultsCount = document.getElementById('posts-results-count')
    const emptyState = document.getElementById('posts-empty-state')
    const resetBtn = document.getElementById('posts-reset-btn')
    const container = document.getElementById('posts-container')
    const yearButtons = document.querySelectorAll<HTMLButtonElement>('.year-filter-btn')

    if (!container) return

    const postElements = Array.from(container.querySelectorAll<HTMLElement>('.post-item'))
    const totalCount = postElements.length

    let selectedYear = 'all'
    let searchQuery = ''
    let sortOrder: 'newest' | 'oldest' = 'newest'

    function filterAndSort() {
      const query = searchQuery.trim().toLowerCase()
      let visibleCount = 0

      // Filter elements
      postElements.forEach((el) => {
        const itemYear = el.dataset.year || ''
        const tokens = el.dataset.searchTokens || ''

        const matchesYear = selectedYear === 'all' || itemYear === selectedYear
        const matchesSearch = query === '' || tokens.includes(query)

        if (matchesYear && matchesSearch) {
          el.style.display = 'grid'
          visibleCount++
        } else {
          el.style.display = 'none'
        }
      })

      // Sort elements
      const sortedElements = [...postElements].sort((a, b) => {
        const timeA = Number(a.dataset.timestamp || 0)
        const timeB = Number(b.dataset.timestamp || 0)
        return sortOrder === 'newest' ? timeB - timeA : timeA - timeB
      })

      if (container) {
        sortedElements.forEach((el) => container.appendChild(el))
      }

      // Update Results Counter
      if (resultsCount) {
        resultsCount.textContent = `${visibleCount} VON ${totalCount} BEITRÄGEN`
      }

      // Empty State
      if (emptyState && container) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden')
          container.classList.add('hidden')
        } else {
          emptyState.classList.add('hidden')
          container.classList.remove('hidden')
        }
      }

      // Clear button visibility
      if (clearBtn) {
        if (searchQuery.length > 0) {
          clearBtn.classList.remove('hidden')
          clearBtn.classList.add('inline-flex')
        } else {
          clearBtn.classList.remove('inline-flex')
          clearBtn.classList.add('hidden')
        }
      }
    }

    // Search Input Listener
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value
      filterAndSort()
    })

    // Clear Search Button
    clearBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = ''
      searchQuery = ''
      filterAndSort()
      searchInput?.focus()
    })

    // Year Filter Buttons
    yearButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const y = btn.dataset.yearFilter || 'all'
        selectedYear = y

        yearButtons.forEach((b) => {
          b.classList.remove('active', 'border-orange', 'bg-orange', 'text-forest-950')
          b.classList.add('border-paper/20', 'bg-forest-900', 'text-paper/80')
        })

        btn.classList.remove('border-paper/20', 'bg-forest-900', 'text-paper/80')
        btn.classList.add('active', 'border-orange', 'bg-orange', 'text-forest-950')

        filterAndSort()
      })
    })

    // Sort Order Selector
    sortSelect?.addEventListener('change', (e) => {
      sortOrder = (e.target as HTMLSelectElement).value as 'newest' | 'oldest'
      filterAndSort()
    })

    // Reset Button
    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = ''
      searchQuery = ''
      selectedYear = 'all'

      yearButtons.forEach((b) => {
        if (b.dataset.yearFilter === 'all') {
          b.classList.add('active', 'border-orange', 'bg-orange', 'text-forest-950')
          b.classList.remove('border-paper/20', 'bg-forest-900', 'text-paper/80')
        } else {
          b.classList.remove('active', 'border-orange', 'bg-orange', 'text-forest-950')
          b.classList.add('border-paper/20', 'bg-forest-900', 'text-paper/80')
        }
      })

      filterAndSort()
    })

    // Initial trigger
    filterAndSort()
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPostsFilter)
  } else {
    setupPostsFilter()
  }

  document.addEventListener('astro:page-load', setupPostsFilter)
</script>
