---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Logo from '../../components/common/Logo.astro'
import {
  Calendar,
  MapPin,
  Users,
  Banknote,
  Printer,
  ArrowLeft,
  ExternalLink,
  Compass,
} from '@lucide/astro'
import { eventProvider, formatDateRange, formatAgeRange, getSlugVariants } from '../../lib/events'
import type { Event } from '../../lib/events'
import { getAllCamps } from '../../lib/camps'
import type { CampEntry } from '../../lib/camps'
import { generateQrSvg } from '../../scripts/qrcode-renderer'

const BASE_DOMAIN = 'https://smj-wegweiser.de'

export async function getStaticPaths() {
  const [events, camps] = await Promise.all([eventProvider.getEvents(), getAllCamps()])

  const paths: {
    params: { id: string }
    props: { eventData?: Event; campData?: CampEntry; isCustom?: boolean }
  }[] = []
  const seen = new Set<string>()

  // 1. Events
  for (const event of events) {
    const variants = getSlugVariants(event.slug, event.title, event.start.getFullYear())
    for (const slug of variants) {
      if (!seen.has(slug)) {
        seen.add(slug)
        paths.push({
          params: { id: slug },
          props: { eventData: event },
        })
      }
    }
  }

  // 2. Camps
  for (const camp of camps) {
    const campSlug = `zeltlager-${camp.data.year}`
    if (!seen.has(campSlug)) {
      seen.add(campSlug)
      paths.push({
        params: { id: campSlug },
        props: { campData: camp },
      })
    }
  }

  if (!seen.has('zeltlager')) {
    seen.add('zeltlager')
    paths.push({
      params: { id: 'zeltlager' },
      props: { campData: camps[0] },
    })
  }

  // 3. Custom dynamic flyer
  if (!seen.has('custom')) {
    seen.add('custom')
    paths.push({
      params: { id: 'custom' },
      props: { isCustom: true },
    })
  }

  return paths
}

const { eventData, campData } = Astro.props

// Resolve Flyer Fields
let title = 'Veranstaltung der SMJ'
let subtitle = 'Raus. Ins Abenteuer.'
let categoryLabel = 'Aktion & Abenteuer'
let dateStr = 'Demnächst'
let locationStr = 'Wiesental bei Thalwenden'
let ageStr = 'Jungs von 9–14 Jahren'
let priceStr = 'Auf Anfrage'
let targetUrl = `${BASE_DOMAIN}/abenteuer/`
let highlights = [
  { icon: 'flame', title: 'Lagerfeuer & Nachtspiele', desc: 'Echtes Outdoor-Feeling unter freiem Himmel.' },
  { icon: 'tree', title: 'Gemeinschaft & Natur', desc: 'Draußen sein, neue Freunde finden & Abenteuer erleben.' },
  { icon: 'shield', title: 'Jugend leitet Jugend', desc: 'Verlässliche und geschulte Gruppenleiter vor Ort.' },
]

if (campData) {
  title = campData.data.title
  subtitle = campData.data.motto
    ? `Motto: ${campData.data.motto}`
    : `Das große Sommerzeltlager ${campData.data.year} im Wiesental`
  categoryLabel = `Sommerzeltlager ${campData.data.year}`
  dateStr = formatDateRange(campData.data.date.start, campData.data.date.end)
  locationStr = campData.data.location.name || 'Wiesental bei Thalwenden'
  ageStr = formatAgeRange(campData.data.age.min, campData.data.age.max) || 'Jungs von 9–14 Jahren'
  priceStr = campData.data.price || '189 €'
  targetUrl = `${BASE_DOMAIN}/abenteuer/zeltlager-${campData.data.year}/`
  highlights = [
    { icon: 'flame', title: '10 Tage Zeltlager & Lagerfeuer', desc: 'Zelte bauen, Nachtwache halten & Geschichten am Feuer.' },
    { icon: 'tree', title: 'Großes Geländespiel & Mottotage', desc: 'Spannende Wettkämpfe, Workshops & Badespaß.' },
    { icon: 'shield', title: 'Erfahrene Leiterrunde', desc: 'Rundum betreut mit Vollverpflegung aus der Lagerküche.' },
  ]
} else if (eventData) {
  title = eventData.title
  subtitle = eventData.teaser || 'Ein Wochenende voller Action, Natur und starker Gemeinschaft.'
  categoryLabel =
    eventData.category === 'weekend'
      ? 'Aktionswochenende'
      : eventData.category === 'camp'
        ? 'Zeltlager'
        : 'Sonderaktion'
  dateStr = formatDateRange(eventData.start, eventData.end)
  locationStr = eventData.location || 'Klause 2.0, Heiligenstadt'
  ageStr = formatAgeRange(eventData.ageMin, eventData.ageMax) || 'Jungs von 9–14 Jahren'
  priceStr = eventData.price || 'Inkl. Verpflegung'
  targetUrl = `${BASE_DOMAIN}/abenteuer/${eventData.slug}/`

  if (eventData.highlights && eventData.highlights.length > 0) {
    highlights = eventData.highlights.slice(0, 3).map((h, i) => ({
      icon: i === 0 ? 'flame' : i === 1 ? 'tree' : 'shield',
      title: h,
      desc: 'Alle Details und Ablaufzeiten auf unserer Website.',
    }))
  }
}

// Generate Crisp SVG QR Code
const qrSvg = await generateQrSvg(targetUrl, { margin: 1, errorCorrectionLevel: 'M' })
const shortUrl = targetUrl.replace(/^https?:\/\//, '')
---

<BaseLayout
  title={`A4 Flyer: ${title} – SMJ Regio Wegweiser`}
  description={`Druckfertiger A4 Aushang-Flyer für ${title} mit allen Daten, Highlights und QR-Code.`}
  noIndex={true}
>
  <!-- Screen Navigation & Action Bar (Hidden when printed) -->
  <div class="no-print sticky top-0 z-50 border-b border-paper/20 bg-forest-950/95 px-4 py-3 backdrop-blur-md">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4">
      <a
        href="/qrcode/"
        class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-paper/70 transition-colors hover:text-orange"
      >
        <ArrowLeft class="h-4 w-4" />
        <span>Zurück zu allen QR-Codes</span>
      </a>

      <div class="flex items-center gap-3">
        <a
          href={targetUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 border border-paper/20 bg-forest-900 px-3 py-1.5 font-mono text-xs text-paper/80 hover:border-orange hover:text-orange transition-colors"
        >
          <span>Webseite öffnen</span>
          <ExternalLink class="h-3.5 w-3.5" />
        </a>

        <button
          type="button"
          id="print-flyer-btn"
          class="inline-flex items-center gap-2 border-2 border-orange bg-orange px-5 py-2 font-mono text-xs font-bold uppercase tracking-wider text-forest-950 shadow-lg transition-all hover:bg-paper hover:border-paper cursor-pointer"
        >
          <Printer class="h-4 w-4" />
          <span>A4 Flyer drucken / Als PDF</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Screen Background Container -->
  <main class="min-h-screen bg-forest-900 py-8 sm:py-12 print:bg-white print:p-0">
    <!-- Centered A4 Sheet Container -->
    <div
      class="a4-flyer-page mx-auto w-full max-w-[210mm] border-2 border-paper/20 bg-paper text-forest-950 shadow-2xl transition-all print:border-none print:shadow-none print:m-0 print:w-full print:max-w-none"
    >
      <!-- Inside Printable Area -->
      <div class="flex min-h-[295mm] flex-col justify-between p-8 sm:p-12 print:min-h-0 print:p-8">
        <!-- Top Section -->
        <div>
          <!-- Header Branding Bar -->
          <header class="flex items-center justify-between border-b-2 border-forest-950/20 pb-5">
            <div class="flex items-center gap-4">
              <div class="h-12 w-12 shrink-0">
                <Logo variant="icon" tone="dark" size="xl" />
              </div>
              <div>
                <span class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.25em] text-orange">
                  Schönstatt-Mannesjugend
                </span>
                <p class="font-display text-2xl uppercase tracking-wider text-forest-950 leading-none mt-0.5">
                  Regio Wegweiser
                </p>
              </div>
            </div>

            <div class="text-right">
              <span class="inline-block border border-orange bg-orange/10 px-3 py-1 font-mono text-xs font-bold uppercase tracking-widest text-orange">
                {categoryLabel}
              </span>
              <p class="font-mono text-[0.65rem] text-forest-950/60 uppercase tracking-widest mt-1">
                Raus. Ins Abenteuer.
              </p>
            </div>
          </header>

          <!-- Main Event Title -->
          <div class="mt-8">
            <h1 class="font-display text-4xl sm:text-5xl uppercase tracking-tight text-forest-950 leading-[0.95]">
              {title}
            </h1>
            <p class="mt-3 font-hand text-2xl sm:text-3xl text-orange font-bold leading-snug">
              // {subtitle}
            </p>
          </div>

          <!-- 4 Key Facts Highlight Boxes -->
          <div class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 font-mono">
            <!-- Date Box -->
            <div class="border-2 border-forest-950/15 bg-white/70 p-4 rounded-sm">
              <div class="flex items-center gap-2 text-orange mb-1">
                <Calendar class="h-4 w-4 shrink-0" />
                <span class="text-[0.68rem] font-bold uppercase tracking-wider text-forest-950/60">Wann?</span>
              </div>
              <p class="text-sm font-bold uppercase text-forest-950 leading-tight">
                {dateStr}
              </p>
            </div>

            <!-- Location Box -->
            <div class="border-2 border-forest-950/15 bg-white/70 p-4 rounded-sm">
              <div class="flex items-center gap-2 text-orange mb-1">
                <MapPin class="h-4 w-4 shrink-0" />
                <span class="text-[0.68rem] font-bold uppercase tracking-wider text-forest-950/60">Wo?</span>
              </div>
              <p class="text-sm font-bold text-forest-950 leading-tight truncate">
                {locationStr}
              </p>
            </div>

            <!-- Age Box -->
            <div class="border-2 border-forest-950/15 bg-white/70 p-4 rounded-sm">
              <div class="flex items-center gap-2 text-orange mb-1">
                <Users class="h-4 w-4 shrink-0" />
                <span class="text-[0.68rem] font-bold uppercase tracking-wider text-forest-950/60">Wer?</span>
              </div>
              <p class="text-sm font-bold uppercase text-forest-950 leading-tight">
                {ageStr}
              </p>
            </div>

            <!-- Price Box -->
            <div class="border-2 border-forest-950/15 bg-white/70 p-4 rounded-sm">
              <div class="flex items-center gap-2 text-orange mb-1">
                <Banknote class="h-4 w-4 shrink-0" />
                <span class="text-[0.68rem] font-bold uppercase tracking-wider text-forest-950/60">Beitrag</span>
              </div>
              <p class="text-sm font-bold uppercase text-forest-950 leading-tight">
                {priceStr}
              </p>
            </div>
          </div>

          <!-- Highlights List Section -->
          <div class="mt-8 border-2 border-forest-950/15 bg-white/50 p-6 rounded-sm">
            <h2 class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-forest-950/70 mb-4 flex items-center gap-2">
              <Compass class="h-4 w-4 text-orange" />
              <span>Was erwartet dich?</span>
            </h2>

            <div class="grid gap-3 sm:grid-cols-3">
              {
                highlights.map((h) => (
                  <div class="border-l-2 border-orange pl-3">
                    <h3 class="font-display text-base uppercase text-forest-950 leading-tight">
                      {h.title}
                    </h3>
                    <p class="mt-1 text-xs text-forest-950/75 leading-relaxed">
                      {h.desc}
                    </p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Bottom Registration & Big QR Code Call To Action -->
        <div class="mt-8 border-t-2 border-forest-950/20 pt-6">
          <div class="flex flex-col sm:flex-row items-center justify-between gap-6 border-2 border-orange bg-forest-950 p-6 text-paper rounded-sm shadow-md">
            <!-- Left Text Column -->
            <div class="flex-1 text-center sm:text-left">
              <div class="inline-flex items-center gap-2 bg-orange px-2.5 py-0.5 font-mono text-[0.68rem] font-bold uppercase text-forest-950 mb-2">
                <span>Jetzt Anmelden &amp; Informieren</span>
              </div>
              <h3 class="font-display text-2xl sm:text-3xl uppercase tracking-wide text-paper leading-tight">
                Scanne den QR-Code<br />
                <span class="text-orange">mit deinem Handy!</span>
              </h3>
              <p class="mt-2 font-mono text-xs text-paper/70">
                Direktlink zur Online-Anmeldung &amp; Packliste:
              </p>
              <p id="flyer-url-display" class="mt-1 font-mono text-xs font-bold text-orange underline">
                {shortUrl}
              </p>
            </div>

            <!-- Right QR Code Vector Preview -->
            <div class="shrink-0 bg-white p-2.5 border-4 border-paper shadow-xl rounded-sm">
              <div id="flyer-qr-container" class="h-36 w-36 [&>svg]:h-full [&>svg]:w-full [&>svg]:block" set:html={qrSvg} />
            </div>
          </div>

          <!-- Bottom Footer Legal & Info -->
          <footer class="mt-6 flex flex-wrap items-center justify-between gap-2 border-t border-forest-950/15 pt-4 font-mono text-[0.68rem] text-forest-950/60">
            <span>SMJ Regio Wegweiser · Schönstatt-Mannesjugend Diözese Erfurt</span>
            <span>E-Mail: kontakt@smj-wegweiser.de · Web: smj-wegweiser.de</span>
          </footer>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  @media print {
    @page {
      size: A4 portrait;
      margin: 6mm 8mm;
    }
    html,
    body {
      background: #ffffff !important;
      color: #111713 !important;
      margin: 0 !important;
      padding: 0 !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
    .no-print {
      display: none !important;
    }
    .a4-flyer-page {
      border: 2px solid #111713 !important;
      box-shadow: none !important;
      width: 100% !important;
      max-width: none !important;
      page-break-inside: avoid !important;
      break-inside: avoid !important;
      padding: 0 !important;
    }
  }
</style>

<script>
  import { generateQrSvg } from '../../scripts/qrcode-renderer'

  const printBtn = document.getElementById('print-flyer-btn')
  if (printBtn) {
    printBtn.addEventListener('click', () => {
      window.print()
    })
  }

  // Handle Custom Flyer dynamic URL params if route is /flyer/custom
  if (window.location.pathname.includes('/flyer/custom')) {
    const params = new URLSearchParams(window.location.search)
    const customTitle = params.get('title')
    const customDate = params.get('date')
    const customLoc = params.get('loc')
    const customUrl = params.get('url')

    if (customTitle) {
      const h1 = document.querySelector('h1')
      if (h1) h1.textContent = customTitle
      document.title = `A4 Flyer: ${customTitle} – SMJ Regio Wegweiser`
    }
    if (customDate) {
      const dateEl = document.querySelectorAll('.a4-flyer-page p.font-bold')[0]
      if (dateEl) dateEl.textContent = customDate
    }
    if (customLoc) {
      const locEl = document.querySelectorAll('.a4-flyer-page p.font-bold')[1]
      if (locEl) locEl.textContent = customLoc
    }
    if (customUrl) {
      const linkEl = document.getElementById('flyer-url-display')
      if (linkEl) linkEl.textContent = customUrl.replace(/^https?:\/\//, '')
      const qrContainer = document.getElementById('flyer-qr-container')
      if (qrContainer) {
        generateQrSvg(customUrl, { margin: 1, errorCorrectionLevel: 'M' })
          .then((svg) => {
            qrContainer.innerHTML = svg
          })
          .catch((e) => console.error(e))
      }
    }
  }
</script>
