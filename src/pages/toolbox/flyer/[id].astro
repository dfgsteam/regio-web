---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Logo from '../../../components/common/Logo.astro'
import {
  Calendar,
  MapPin,
  Users,
  Banknote,
  Download,
  Printer,
  ArrowLeft,
  ExternalLink,
  Compass,
  FileText,
  CircleCheck,
  Phone,
  Mail,
  UserCheck,
} from '@lucide/astro'
import { eventProvider, getSlugVariants } from '../../../lib/events'
import type { Event } from '../../../lib/events'
import { getAllCamps } from '../../../lib/camps'
import type { CampEntry } from '../../../lib/camps'
import { generateQrSvg } from '../../../scripts/qrcode-renderer'
import { resolveFlyerData } from '../../../lib/pdf/flyer-content'

export async function getStaticPaths() {
  const [events, camps] = await Promise.all([eventProvider.getEvents(), getAllCamps()])

  const paths: {
    params: { id: string }
    props: { eventData?: Event; campData?: CampEntry; isCustom?: boolean }
  }[] = []
  const seen = new Set<string>()

  // 1. Events
  for (const event of events) {
    const variants = getSlugVariants(event.slug, event.title, event.start.getFullYear())
    for (const slug of variants) {
      if (!seen.has(slug)) {
        seen.add(slug)
        paths.push({
          params: { id: slug },
          props: { eventData: event },
        })
      }
    }
  }

  // 2. Camps
  for (const camp of camps) {
    const campSlug = `zeltlager-${camp.data.year}`
    if (!seen.has(campSlug)) {
      seen.add(campSlug)
      paths.push({
        params: { id: campSlug },
        props: { campData: camp },
      })
    }
  }

  if (!seen.has('zeltlager')) {
    seen.add('zeltlager')
    paths.push({
      params: { id: 'zeltlager' },
      props: { campData: camps[0] },
    })
  }

  // 3. Custom dynamic flyer
  if (!seen.has('custom')) {
    seen.add('custom')
    paths.push({
      params: { id: 'custom' },
      props: { isCustom: true },
    })
  }

  return paths
}

const { id } = Astro.params
const { eventData, campData } = Astro.props

const flyerData = resolveFlyerData(id || 'custom', eventData, campData)

// Generate Crisp SVG QR Code
const qrSvg = await generateQrSvg(flyerData.targetUrl, { margin: 1, errorCorrectionLevel: 'M' })
const pdfUrl = id && id !== 'custom' ? `/toolbox/flyers/${id}.pdf` : null
---

<BaseLayout
  title={`A4 Flyer: ${flyerData.title} – SMJ Regio Wegweiser`}
  description={`Druckfertiger A4-Aushang für ${flyerData.title}`}
  noIndex={true}
>
  <!-- Screen Navigation Bar (Hidden when printing) -->
  <div class="no-print border-b border-paper/20 bg-forest-950 px-4 py-3 sticky top-0 z-50 shadow-md">
    <div class="max-w-4xl mx-auto flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <a
          href="/toolbox/"
          class="inline-flex items-center gap-1.5 font-mono text-xs font-bold uppercase tracking-wider text-paper/70 hover:text-paper transition-colors py-2 px-3 border border-paper/20 rounded-xs bg-forest-900/60"
        >
          <ArrowLeft class="h-4 w-4" />
          <span>Zurück zur Toolbox</span>
        </a>
        <span class="hidden sm:inline font-mono text-xs text-paper/40">|</span>
        <span class="hidden sm:inline-flex items-center gap-1.5 font-mono text-xs text-orange font-bold uppercase truncate max-w-xs">
          <FileText class="h-3.5 w-3.5" />
          <span>DIN A4 Flyer</span>
        </span>
      </div>

      <div class="flex items-center gap-3">
        {pdfUrl ? (
          <a
            href={pdfUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 border-2 border-orange bg-orange px-4 py-2 font-mono text-xs font-bold uppercase tracking-wider text-forest-950 hover:bg-paper hover:border-paper transition-all cursor-pointer shadow-md"
          >
            <Download class="h-4 w-4" />
            <span>PDF öffnen (.pdf) ↗</span>
          </a>
        ) : (
          <button
            type="button"
            id="client-pdf-btn"
            class="inline-flex items-center gap-2 border-2 border-orange bg-orange px-4 py-2 font-mono text-xs font-bold uppercase tracking-wider text-forest-950 hover:bg-paper hover:border-paper transition-all cursor-pointer shadow-md"
          >
            <Download class="h-4 w-4" />
            <span>PDF generieren (.pdf) ↗</span>
          </button>
        )}
        <button
          type="button"
          id="print-flyer-btn"
          class="inline-flex items-center gap-1.5 border border-paper/30 bg-forest-900 px-3 py-2 font-mono text-xs uppercase tracking-wider text-paper/80 hover:border-orange hover:text-orange transition-all cursor-pointer"
        >
          <Printer class="h-3.5 w-3.5" />
          <span>Drucken</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Main Container centered for screen preview -->
  <div class="bg-forest-900/80 min-h-screen py-6 sm:py-12 px-2 sm:px-4 flex justify-center items-start print:p-0 print:m-0 print:bg-white">
    
    <!-- Printable DIN A4 Flyer Container -->
    <article
      class="a4-flyer-page bg-paper text-forest-950 shadow-2xl relative flex flex-col justify-between"
      style="width: 210mm; height: 297mm; max-height: 297mm; overflow: hidden; padding: 10mm 12mm 8mm 12mm; box-sizing: border-box;"
    >
      
      <!-- Top Section -->
      <div>
        <header class="border-b-4 border-forest-950 pb-3 flex items-center justify-between gap-6">
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 shrink-0 flex items-center justify-center p-1 border-2 border-forest-950 bg-forest-950 text-paper">
              <Logo size="md" tone="dark" />
            </div>
            <div>
              <p class="font-mono text-xs font-bold uppercase tracking-widest text-orange">
                SMJ Regio Wegweiser &bull; Heiligenstadt
              </p>
              <p class="font-mono text-[0.65rem] tracking-wider uppercase text-forest-950/70">
                Schönstatt Mannesjugend &bull; smj-wegweiser.de
              </p>
            </div>
          </div>

          <div class="text-right shrink-0">
            <span class="inline-block border-2 border-forest-950 bg-forest-950 text-paper px-3 py-1 font-mono text-xs font-bold uppercase tracking-wider">
              {flyerData.categoryLabel}
            </span>
          </div>
        </header>

        <!-- Main Title Section -->
        <section class="mt-4 mb-3">
          <div class="flex items-center gap-2 mb-1.5 font-mono text-xs font-bold text-orange tracking-widest uppercase">
            <Compass class="h-4 w-4" />
            <span>RAUS. INS ABENTEUER.</span>
          </div>
          <h1 class="font-display text-4xl sm:text-5xl uppercase tracking-tight text-forest-950 leading-[0.95]">
            {flyerData.title}
          </h1>
          {flyerData.subtitle && (
            <p class="mt-1.5 font-hand text-xl text-orange font-bold">
              // {flyerData.subtitle}
            </p>
          )}
        </section>

        <!-- Key Facts Grid (Dark Cards for High Contrast) -->
        <section class="my-4 grid grid-cols-2 gap-2.5 sm:grid-cols-4">
          <div class="border-2 border-forest-950 bg-forest-950 text-paper p-2.5">
            <div class="flex items-center gap-1.5 text-orange mb-1 font-mono text-[0.65rem] font-bold uppercase">
              <Calendar class="h-3.5 w-3.5" />
              <span>Wann</span>
            </div>
            <p class="font-mono text-xs font-bold leading-tight">{flyerData.dateStr}</p>
          </div>

          <div class="border-2 border-forest-950 bg-forest-950 text-paper p-2.5">
            <div class="flex items-center gap-1.5 text-orange mb-1 font-mono text-[0.65rem] font-bold uppercase">
              <MapPin class="h-3.5 w-3.5" />
              <span>Wo</span>
            </div>
            <p class="font-mono text-xs font-bold leading-tight">{flyerData.locationStr}</p>
          </div>

          <div class="border-2 border-forest-950 bg-forest-950 text-paper p-2.5">
            <div class="flex items-center gap-1.5 text-orange mb-1 font-mono text-[0.65rem] font-bold uppercase">
              <Users class="h-3.5 w-3.5" />
              <span>Wer</span>
            </div>
            <p class="font-mono text-xs font-bold leading-tight">{flyerData.ageStr}</p>
          </div>

          <div class="border-2 border-forest-950 bg-forest-950 text-paper p-2.5">
            <div class="flex items-center gap-1.5 text-orange mb-1 font-mono text-[0.65rem] font-bold uppercase">
              <Banknote class="h-3.5 w-3.5" />
              <span>Beitrag</span>
            </div>
            <p class="font-mono text-xs font-bold leading-tight">{flyerData.priceStr}</p>
          </div>
        </section>

        <!-- Description Section (Das erwartet dich) -->
        {flyerData.description && (
          <section class="my-3">
            <h2 class="font-mono text-[0.7rem] font-bold uppercase tracking-widest text-forest-950/80 mb-1.5 border-b-2 border-forest-950/20 pb-0.5">
              Das erwartet dich bei dieser Aktion:
            </h2>
            <p class="font-sans text-xs text-forest-950 leading-relaxed max-w-3xl">
              {flyerData.description}
            </p>
          </section>
        )}

        <!-- Highlights & Program Points -->
        <section class="my-3">
          <h2 class="font-mono text-[0.7rem] font-bold uppercase tracking-widest text-forest-950/80 mb-2 border-b-2 border-forest-950/20 pb-0.5">
            Programm-Highlights:
          </h2>
          <div class="space-y-2">
            {flyerData.highlights.map((h) => (
              <div class="flex items-start gap-2.5 border-l-4 border-orange pl-2.5 py-0.5">
                <div>
                  <h3 class="font-display text-base uppercase text-forest-950 tracking-wide leading-tight">
                    {h.title}
                  </h3>
                  <p class="font-sans text-[0.7rem] text-forest-950/80 leading-snug">
                    {h.desc}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Packing List / Was du brauchst -->
        {flyerData.packingList && flyerData.packingList.length > 0 && (
          <section class="my-3">
            <h2 class="font-mono text-[0.7rem] font-bold uppercase tracking-widest text-forest-950/80 mb-1.5 border-b-2 border-forest-950/20 pb-0.5">
              Was du brauchst (Packliste &amp; Infos):
            </h2>
            <div class="grid grid-cols-2 gap-x-4 gap-y-1 font-sans text-[0.7rem] text-forest-950">
              {flyerData.packingList.slice(0, 6).map((item) => (
                <div class="flex items-center gap-1.5">
                  <CircleCheck class="h-3 w-3 text-orange shrink-0" />
                  <span class="truncate">{item}</span>
                </div>
              ))}
            </div>
          </section>
        )}
      </div>

      <!-- Bottom Registration & QR Code Call-to-Action with Contact Box -->
      <div>
        <section class="border-2 border-forest-950 bg-white p-4 my-2 flex items-center justify-between gap-6 relative overflow-hidden shadow-sm">
          <div class="space-y-2 flex-1">
            <span class="inline-block bg-orange text-forest-950 font-mono text-[0.65rem] font-bold uppercase tracking-wider px-2 py-0.5">
              Online-Anmeldung &amp; Infos
            </span>
            <h3 class="font-display text-2xl uppercase tracking-tight text-forest-950">
              Jetzt anmelden &amp; Plätze sichern!
            </h3>
            <p class="font-sans text-xs text-forest-950/80 max-w-md">
              Kamera ans Handy halten oder Link im Browser öffnen. Dort gibt es die offizielle Anmeldung, Packliste und alle Details für deine Eltern.
            </p>
            <p class="font-mono text-xs font-bold text-orange flex items-center gap-1.5">
              <ExternalLink class="h-3.5 w-3.5" />
              <span id="flyer-url-display">{flyerData.shortUrl}</span>
            </p>

            <!-- Direct Contact Person Information (Unmodified from Event Sync) -->
            {flyerData.contact && (flyerData.contact.name || flyerData.contact.email || flyerData.contact.phone) && (
              <div class="pt-2 mt-2 border-t border-forest-950/20">
                <p class="font-mono text-[0.65rem] font-bold uppercase text-orange mb-1">
                  Fragen zur Aktion? Dein Ansprechpartner:
                </p>
                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs text-forest-950">
                  {flyerData.contact.name && (
                    <div class="flex items-center gap-1 font-bold">
                      <UserCheck class="h-3 w-3 text-forest-950/60" />
                      <span>{flyerData.contact.name}</span>
                      {flyerData.contact.role && (
                        <span class="text-forest-950/60 font-normal">({flyerData.contact.role})</span>
                      )}
                    </div>
                  )}
                  {flyerData.contact.phone && (
                    <div class="flex items-center gap-1 text-forest-950/80">
                      <Phone class="h-3 w-3 text-orange" />
                      <span>{flyerData.contact.phone}</span>
                    </div>
                  )}
                  {flyerData.contact.email && (
                    <div class="flex items-center gap-1 text-forest-950/80">
                      <Mail class="h-3 w-3 text-orange" />
                      <span>{flyerData.contact.email}</span>
                    </div>
                  )}
                </div>
              </div>
            )}
          </div>

          <!-- Large Scannable QR Code -->
          <div class="shrink-0 flex flex-col items-center">
            <div class="border-2 border-forest-950 bg-white p-2 shadow-sm">
              <div id="flyer-qr-container" class="w-28 h-28 flex items-center justify-center" set:html={qrSvg}></div>
            </div>
            <span class="font-mono text-[0.6rem] font-bold tracking-widest text-forest-950 mt-1 uppercase">
              Hier scannen &uarr;
            </span>
          </div>
        </section>

        <!-- Footer Notice -->
        <footer class="mt-2 pt-2 border-t border-forest-950/20 flex justify-between items-center font-mono text-[0.55rem] text-forest-950/60">
          <span>SMJ Regio Wegweiser &bull; Jugend leitet Jugend &bull; Katholische Schönstatt-Mannesjugend</span>
          <span>Druckfertiger Aushang &bull; Stand: {new Date().getFullYear()}</span>
        </footer>
      </div>

    </article>
  </div>
</BaseLayout>

<style>
  @media print {
    @page {
      size: A4 portrait;
      margin: 0;
    }
    html,
    body {
      width: 210mm !important;
      height: 297mm !important;
      margin: 0 !important;
      padding: 0 !important;
      background: white !important;
      overflow: hidden !important;
    }
    .no-print {
      display: none !important;
    }
    .a4-flyer-page {
      width: 210mm !important;
      height: 297mm !important;
      max-height: 297mm !important;
      overflow: hidden !important;
      padding: 10mm 12mm 8mm 12mm !important;
      border: 2px solid #111713 !important;
      box-shadow: none !important;
      page-break-inside: avoid !important;
      page-break-after: avoid !important;
      break-inside: avoid !important;
    }
  }
</style>

<script>
  import { generateQrSvg } from '../../../scripts/qrcode-renderer'
  import { openOrDownloadClientFlyerPdf } from '../../../scripts/client-flyer-pdf'

  const printBtn = document.getElementById('print-flyer-btn')
  if (printBtn) {
    printBtn.addEventListener('click', () => {
      window.print()
    })
  }

  const clientPdfBtn = document.getElementById('client-pdf-btn')
  if (clientPdfBtn) {
    clientPdfBtn.addEventListener('click', async () => {
      const searchParams = new URLSearchParams(window.location.search)
      const customTitle = searchParams.get('title') || 'Aktion der SMJ'
      const customUrl = searchParams.get('url') || window.location.href
      await openOrDownloadClientFlyerPdf(
        {
          title: customTitle,
          targetUrl: customUrl,
          dateStr: searchParams.get('date') || undefined,
          locationStr: searchParams.get('loc') || undefined,
        },
        'open',
      )
    })
  }

  // Handle Custom Flyer dynamic URL params if route is /toolbox/flyer/custom
  const searchParams = new URLSearchParams(window.location.search)

  if (window.location.pathname.includes('/toolbox/flyer/custom')) {
    const customTitle = searchParams.get('title')
    const customDate = searchParams.get('date')
    const customLoc = searchParams.get('loc')
    const customUrl = searchParams.get('url')

    if (customTitle) {
      const h1 = document.querySelector('h1')
      if (h1) h1.textContent = customTitle
      document.title = `SMJ-Flyer-${customTitle.replace(/[^a-zA-Z0-9_-]/g, '_')}`
    }
    if (customDate) {
      const dateEl = document.querySelectorAll('.a4-flyer-page p.font-bold')[0]
      if (dateEl) dateEl.textContent = customDate
    }
    if (customLoc) {
      const locEl = document.querySelectorAll('.a4-flyer-page p.font-bold')[1]
      if (locEl) locEl.textContent = customLoc
    }
    if (customUrl) {
      const linkEl = document.getElementById('flyer-url-display')
      if (linkEl) linkEl.textContent = customUrl.replace(/^https?:\/\//, '')
      const qrContainer = document.getElementById('flyer-qr-container')
      if (qrContainer) {
        generateQrSvg(customUrl, { margin: 1, errorCorrectionLevel: 'M' })
          .then((svg) => {
            qrContainer.innerHTML = svg
          })
          .catch((e) => console.error(e))
      }
    }
  }
</script>
