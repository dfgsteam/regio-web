            <div class="bg-forest-900/80 px-4 py-3 border-b border-paper/15 flex items-center justify-between font-mono text-xs">
              <div class="flex items-center gap-3">
                <span class="text-paper/50">Betreff:</span>
                <span id="email-subject-preview" class="text-paper font-bold">
                  Einladung: {initialEvent.title} – SMJ Regio Wegweiser
                </span>
              </div>
              <span class="text-paper/50 text-[0.7rem]">Empfänger: CiviCRM Smartgruppe</span>
            </div>

            <div class="p-4 sm:p-8 bg-[#182019] flex justify-center overflow-x-auto">
              <div id="email-rendered-preview" class="w-full max-w-[620px] bg-white rounded-xs shadow-2xl overflow-hidden text-[#111713]">
                <!-- Injected via client script / initial bundle -->
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB PANEL 3: SMS SAMMELNACHRICHT           -->
        <!-- ========================================== -->
        <div id="tab-panel-sms" class="tab-panel p-6 space-y-6 hidden">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h3 class="display text-xl sm:text-2xl text-paper uppercase">
                SMS / Messenger Sammelnachricht
              </h3>
              <p class="font-mono text-xs text-paper/70 mt-1 max-w-2xl">
                Kurze, prägnante Einladung für direkte Benachrichtigungen per SMS, Signal oder WhatsApp mit dynamischen CiviCRM-Platzhaltern.
              </p>
            </div>

            <!-- Actions -->
            <div class="flex flex-wrap items-center gap-2">
              <button
                type="button"
                id="btn-copy-sms"
                class="inline-flex items-center gap-2 px-3.5 py-2 border border-paper/30 bg-forest-950 text-paper font-mono text-xs font-bold uppercase tracking-wider hover:border-paper hover:bg-forest-900 transition-all rounded-xs"
              >
                <Copy class="w-4 h-4 text-orange" />
                <span id="copy-sms-label">SMS kopieren</span>
              </button>

              <button
                type="button"
                id="btn-create-civi-sms"
                class="btn-trigger-sms-draft inline-flex items-center gap-2 px-4 py-2 bg-orange text-forest-950 font-mono text-xs font-bold uppercase tracking-wider hover:bg-paper transition-all rounded-xs shadow-md"
              >
                <Send class="w-4 h-4" />
                <span>SMS in CiviCRM vorbereiten ⚡</span>
              </button>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            
            <!-- Left: SMS Editor -->
            <div class="lg:col-span-7 space-y-4">
              <div class="border border-paper/20 bg-forest-950 p-4 rounded-xs space-y-3">
                <label for="sms-textarea" class="block font-mono text-xs font-bold uppercase text-orange">
                  SMS-Text bearbeiten
                </label>
                <textarea
                  id="sms-textarea"
                  rows="6"
                  class="w-full bg-forest-900 border border-paper/30 text-paper font-mono text-sm p-3 rounded-xs focus:outline-none focus:border-orange leading-relaxed"
                >{initialSms.text}</textarea>

                <div class="flex items-center justify-between text-xs font-mono text-paper/60 pt-1">
                  <div>
                    Zeichen: <strong id="sms-char-count" class="text-orange">{initialSms.characterCount}</strong>
                    &bull; Segmente: <strong id="sms-segment-count" class="text-paper">{initialSms.segmentCount} SMS</strong>
                  </div>
                  <div class="text-[0.7rem] text-paper/40">
                    Tokens: {'{contact.first_name}'}
                  </div>
                </div>
              </div>

              <div class="border border-paper/15 bg-forest-900/40 p-4 rounded-xs space-y-2 font-mono text-xs text-paper/70">
                <div class="text-paper font-bold uppercase flex items-center gap-1.5 text-orange">
                  <Info class="w-3.5 h-3.5" />
                  <span>CiviCRM SMS-Workflow</span>
                </div>
                <p>
                  Klicke auf "SMS in CiviCRM vorbereiten", um eine Aktivität für die ausgewählte Smartgruppe anzulegen. Von dort kann der Versand über das angebundene CiviCRM-SMS-Gateway ausgeführt werden.
                </p>
              </div>
            </div>

            <!-- Right: Smartphone Simulation -->
            <div class="lg:col-span-5 bg-[#1c221d] p-6 rounded-xs border border-paper/20 flex flex-col items-center">
              <div class="text-xs font-mono text-paper/60 mb-3">Vorschau auf Empfänger-Handy</div>
              
              <!-- Smartphone Frame -->
              <div class="w-[280px] bg-[#111713] rounded-[36px] p-3.5 shadow-2xl border-4 border-gray-700 space-y-3">
                <!-- Speaker notch -->
                <div class="flex justify-center">
                  <div class="w-20 h-3 bg-gray-800 rounded-full"></div>
                </div>

                <!-- Chat Header -->
                <div class="border-b border-gray-800 pb-2 text-center">
                  <div class="text-[11px] font-bold text-paper font-mono">SMJ Wegweiser</div>
                  <div class="text-[9px] text-paper/40 font-mono">SMS &bull; Heute</div>
                </div>

                <!-- Message Bubble -->
                <div class="bg-[#1f2b21] border border-orange/40 text-paper p-3 rounded-2xl rounded-tl-xs text-xs font-mono leading-relaxed space-y-1 shadow-inner">
                  <div id="phone-sms-preview" class="break-words">
                    {initialSms.text}
                  </div>
                  <div class="text-[9px] text-orange text-right">Jetzt &bull; Zugestellt</div>
                </div>

                <!-- Dummy Reply Input -->
                <div class="pt-8">
                  <div class="bg-gray-900 rounded-full px-3 py-1.5 text-[10px] text-gray-500 font-mono border border-gray-800">
                    Nachricht senden...
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>

    </div>
  </main>

  <!-- ======================================================== -->
  <!-- ACCESSIBLE STYLED DIALOG MODAL (REPLACES ALERT / CONFIRM) -->
  <!-- ======================================================== -->
  <dialog
    id="civi-dialog"
    class="backdrop:bg-forest-950/85 backdrop:backdrop-blur-sm bg-forest-900 text-paper border border-paper/25 rounded-xs p-0 shadow-2xl max-w-lg w-[90%] fixed inset-0 m-auto focus:outline-none"
  >
    <div class="p-6 space-y-5">
      
      <!-- Dialog Header -->
      <div class="flex items-start justify-between gap-4 border-b border-paper/15 pb-4">
        <div class="flex items-center gap-3">
          <div id="dialog-icon-loading" class="w-8 h-8 rounded-full bg-orange/20 border border-orange/50 flex items-center justify-center text-orange shrink-0">
            <Loader class="w-5 h-5 animate-spin" />
          </div>
          <div id="dialog-icon-success" class="hidden w-8 h-8 rounded-full bg-green-500/20 border border-green-500/50 flex items-center justify-center text-green-400 shrink-0">
            <CircleCheck class="w-5 h-5" />
          </div>
          <div id="dialog-icon-error" class="hidden w-8 h-8 rounded-full bg-red-500/20 border border-red-500/50 flex items-center justify-center text-red-400 shrink-0">
            <CircleAlert class="w-5 h-5" />
          </div>
          <div>
            <h4 id="dialog-title" class="display text-xl uppercase tracking-wide text-paper">
              CiviCRM Automation
            </h4>
            <div id="dialog-subtitle" class="font-mono text-xs text-orange">
              Aktion wird vorbereitet...
            </div>
          </div>
        </div>

        <button
          type="button"
          id="dialog-btn-close-x"
          class="text-paper/50 hover:text-paper p-1 rounded-xs hover:bg-forest-950 transition-colors"
          aria-label="Dialog schließen"
        >
          <X class="w-5 h-5" />
        </button>
      </div>

      <!-- Dialog Message Body -->
      <div id="dialog-body" class="font-mono text-xs sm:text-sm text-paper/80 leading-relaxed space-y-2">
        Entwurf wird über die CiviCRM APIv4 angelegt...
      </div>

      <!-- Details Summary Box -->
      <div id="dialog-details-box" class="bg-forest-950 border border-paper/15 p-3.5 rounded-xs font-mono text-xs space-y-1.5">
        <div class="flex items-center justify-between text-paper/60">
          <span>Zielgruppe:</span>
          <strong id="dialog-detail-group" class="text-paper">Smartgruppe 12</strong>
        </div>
        <div class="flex items-center justify-between text-paper/60">
          <span>Aktion:</span>
          <strong id="dialog-detail-event" class="text-orange truncate max-w-[240px]">Sommerzeltlager</strong>
        </div>
        <div id="dialog-detail-id-row" class="hidden flex items-center justify-between text-paper/60 border-t border-paper/10 pt-1.5">
          <span>CiviCRM Datensatz-ID:</span>
          <strong id="dialog-detail-id" class="text-green-400">#---</strong>
        </div>
      </div>

      <!-- Dialog Footer Buttons -->
      <div class="flex flex-wrap items-center justify-end gap-3 pt-2">
        <button
          type="button"
          id="dialog-btn-cancel"
          class="px-4 py-2 border border-paper/30 bg-forest-950 text-paper font-mono text-xs font-bold uppercase tracking-wider hover:border-paper hover:bg-forest-900 rounded-xs transition-colors"
        >
          Schließen
        </button>

        <a
          id="dialog-btn-civi"
          href="https://civi.smj-wegweiser.de"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden inline-flex items-center gap-2 px-5 py-2.5 bg-orange text-forest-950 font-mono text-xs font-bold uppercase tracking-wider hover:bg-paper rounded-xs transition-all shadow-md"
        >
          <ExternalLink class="w-4 h-4" />
          <span>In CiviCRM öffnen ↗</span>
        </a>
      </div>

    </div>
  </dialog>
</BaseLayout>

<script is:inline define:vars={{ clientData }}>
  let currentEvent = clientData.events[0]
  let currentGroupId = Number(clientData.groups[0]?.id || 12)
  let currentRecipients = clientData.groupRecipientsMap[currentGroupId] || clientData.defaultRecipients

  // DOM Elements
  const eventSelect = document.getElementById('event-select')
  const groupSelect = document.getElementById('group-select')

  const badgeLocation = document.getElementById('badge-location')
  const badgeAge = document.getElementById('badge-age')
  const badgePrice = document.getElementById('badge-price')

  const counterTotal = document.getElementById('counter-total')
  const counterPost = document.getElementById('counter-post')
  const counterEmail = document.getElementById('counter-email')
  const recipientCountBadge = document.getElementById('recipient-count-badge')
  const batchBtnLabel = document.getElementById('batch-btn-label')

  const btnDownloadSingle = document.getElementById('btn-download-single')
  const btnDownloadBatch = document.getElementById('btn-download-batch')

  const previewAddrName = document.getElementById('preview-addr-name')
  const previewAddrStreet = document.getElementById('preview-addr-street')
  const previewAddrCity = document.getElementById('preview-addr-city')
  const previewSubject = document.getElementById('preview-subject')
  const previewSalutation = document.getElementById('preview-salutation')
  const previewFactDate = document.getElementById('preview-fact-date')
  const previewFactLoc = document.getElementById('preview-fact-loc')
  const previewFactAge = document.getElementById('preview-fact-age')
  const previewFactPrice = document.getElementById('preview-fact-price')

  const recipientList = document.getElementById('recipient-list')

  const emailRenderedPreview = document.getElementById('email-rendered-preview')
  const emailSubjectPreview = document.getElementById('email-subject-preview')
  const btnCopyEmailHtml = document.getElementById('btn-copy-email-html')
  const copyEmailLabel = document.getElementById('copy-email-label')

  const smsTextarea = document.getElementById('sms-textarea')
  const smsCharCount = document.getElementById('sms-char-count')
  const smsSegmentCount = document.getElementById('sms-segment-count')
  const phoneSmsPreview = document.getElementById('phone-sms-preview')
  const btnCopySms = document.getElementById('btn-copy-sms')
  const copySmsLabel = document.getElementById('copy-sms-label')

  // Showcase Elements
  const showcaseCurrentTitle = document.getElementById('showcase-current-title')
  const showcaseBtnMusterPdf = document.getElementById('showcase-btn-muster-pdf')
  const showcaseBtnPlakat = document.getElementById('showcase-btn-plakat')
  const showcaseBtnStory = document.getElementById('showcase-btn-story')
  const showcaseBtnFeed = document.getElementById('showcase-btn-feed')

  // Modal Dialog Elements
  const civiDialog = document.getElementById('civi-dialog')
  const dialogIconLoading = document.getElementById('dialog-icon-loading')
  const dialogIconSuccess = document.getElementById('dialog-icon-success')
  const dialogIconError = document.getElementById('dialog-icon-error')
  const dialogTitle = document.getElementById('dialog-title')
  const dialogSubtitle = document.getElementById('dialog-subtitle')
  const dialogBody = document.getElementById('dialog-body')
  const dialogDetailGroup = document.getElementById('dialog-detail-group')
  const dialogDetailEvent = document.getElementById('dialog-detail-event')
  const dialogDetailIdRow = document.getElementById('dialog-detail-id-row')
  const dialogDetailId = document.getElementById('dialog-detail-id')
  const dialogBtnCloseX = document.getElementById('dialog-btn-close-x')
  const dialogBtnCancel = document.getElementById('dialog-btn-cancel')
  const dialogBtnCivi = document.getElementById('dialog-btn-civi')

  // Initial Email Render
  if (emailRenderedPreview) {
    emailRenderedPreview.innerHTML = clientData.defaultEmailHtml
  }

  // Dialog Helper
  function openDialogLoading(actionTitle) {
    if (!civiDialog) return
    dialogIconLoading.classList.remove('hidden')
    dialogIconSuccess.classList.add('hidden')
    dialogIconError.classList.add('hidden')
    
    dialogTitle.textContent = actionTitle
    dialogSubtitle.textContent = 'Verbinde mit CiviCRM APIv4...'
    dialogBody.textContent = 'Der Entwurf wird direkt im CiviCRM angelegt. Bitte kurz warten...'
    
    const grp = clientData.groups.find((g) => g.id === currentGroupId)
    if (dialogDetailGroup) dialogDetailGroup.textContent = grp ? grp.title : `Gruppe ${currentGroupId}`
    if (dialogDetailEvent) dialogDetailEvent.textContent = currentEvent.title
    if (dialogDetailIdRow) dialogDetailIdRow.classList.add('hidden')
    if (dialogBtnCivi) dialogBtnCivi.classList.add('hidden')

    civiDialog.showModal()
  }

  function updateDialogSuccess(title, message, civiId, civiUrl) {
    if (!civiDialog) return
    dialogIconLoading.classList.add('hidden')
    dialogIconSuccess.classList.remove('hidden')
    dialogIconError.classList.add('hidden')

    dialogTitle.textContent = title
    dialogSubtitle.textContent = 'Erfolgreich in CiviCRM angelegt'
    dialogBody.innerHTML = message

    if (civiId && dialogDetailIdRow && dialogDetailId) {
      dialogDetailId.textContent = `#${civiId}`
      dialogDetailIdRow.classList.remove('hidden')
    }

    if (civiUrl && dialogBtnCivi) {
      dialogBtnCivi.href = civiUrl
      dialogBtnCivi.classList.remove('hidden')
    }
  }

  function updateDialogError(title, errorMessage, fallbackUrl) {
    if (!civiDialog) return
    dialogIconLoading.classList.add('hidden')
    dialogIconSuccess.classList.add('hidden')
    dialogIconError.classList.remove('hidden')

    dialogTitle.textContent = title
    dialogSubtitle.textContent = 'Fehler aufgetreten'
    dialogBody.innerHTML = `<span class="text-red-400 font-bold">${errorMessage}</span><br><br>Hinweis: Prüfe bitte deine CiviCRM-Verbindung oder öffne CiviCRM direkt über die Schaltfläche unten.`

    if (dialogBtnCivi) {
      dialogBtnCivi.href = fallbackUrl || 'https://civi.smj-wegweiser.de'
      dialogBtnCivi.classList.remove('hidden')
    }
  }

  if (dialogBtnCloseX) dialogBtnCloseX.addEventListener('click', () => civiDialog.close())
  if (dialogBtnCancel) dialogBtnCancel.addEventListener('click', () => civiDialog.close())

  // Close modal when clicking outside dialog backdrop
  if (civiDialog) {
    civiDialog.addEventListener('click', (e) => {
      const rect = civiDialog.getBoundingClientRect()
      const isInDialog = (
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width
      )
      if (!isInDialog) civiDialog.close()
    })
  }

  // Update Event Logic
  function updateEvent(eventId) {
    currentEvent = clientData.events.find((e) => e.id === eventId) || clientData.events[0]

    // Badges
    if (badgeLocation) badgeLocation.textContent = currentEvent.locationStr
    if (badgeAge) badgeAge.textContent = currentEvent.ageStr
    if (badgePrice) badgePrice.textContent = currentEvent.priceStr

    // PDF links
    if (btnDownloadSingle) btnDownloadSingle.href = `/toolbox/briefe/${currentEvent.id}-muster.pdf`
    if (btnDownloadBatch) btnDownloadBatch.href = `/toolbox/briefe/${currentEvent.id}-batch.pdf`

    // Letter Preview
    if (previewSubject) previewSubject.textContent = `DEIN NÄCHSTES ABENTEUER: ${currentEvent.title}`
    if (previewFactDate) previewFactDate.textContent = currentEvent.dateStr
    if (previewFactLoc) previewFactLoc.textContent = currentEvent.locationStr
    if (previewFactAge) previewFactAge.textContent = currentEvent.ageStr
    if (previewFactPrice) previewFactPrice.textContent = currentEvent.priceStr

    // SMS Text
    const shortUrl = currentEvent.registrationUrl.replace(/^https?:\/\//, '')
    const sms = `Hallo {contact.first_name|Abenteurer}! Lust auf echtes Abenteuer? Die SMJ laedt dich ein: ${currentEvent.title} (${currentEvent.dateStr}, ${currentEvent.locationStr}). Jetzt Platz sichern: ${shortUrl} - Dein SMJ Team`
    if (smsTextarea) smsTextarea.value = sms
    if (phoneSmsPreview) phoneSmsPreview.textContent = sms
    updateSmsMetrics(sms)

    // Email Subject
    if (emailSubjectPreview) {
      emailSubjectPreview.textContent = `Einladung: ${currentEvent.title} – SMJ Regio Wegweiser`
    }

    // Showcase Sync
    if (showcaseCurrentTitle) showcaseCurrentTitle.textContent = currentEvent.title
    if (showcaseBtnMusterPdf) showcaseBtnMusterPdf.href = `/toolbox/briefe/${currentEvent.id}-muster.pdf`
    if (showcaseBtnPlakat) showcaseBtnPlakat.href = `/toolbox/flyer/${currentEvent.id}/`
    if (showcaseBtnStory) showcaseBtnStory.href = `/toolbox/social/${currentEvent.id}/?format=story`
    if (showcaseBtnFeed) showcaseBtnFeed.href = `/toolbox/social/${currentEvent.id}/?format=feed`

    document.querySelectorAll('.showcase-sync-title').forEach(el => el.textContent = currentEvent.title)
    document.querySelectorAll('.showcase-sync-date').forEach(el => el.textContent = currentEvent.dateStr)
    document.querySelectorAll('.showcase-sync-loc').forEach(el => el.textContent = currentEvent.locationStr)
    document.querySelectorAll('.showcase-sync-age').forEach(el => el.textContent = currentEvent.ageStr)
    document.querySelectorAll('.showcase-sync-price').forEach(el => el.textContent = currentEvent.priceStr)
    document.querySelectorAll('.showcase-sync-cat').forEach(el => el.textContent = currentEvent.category)
    document.querySelectorAll('.showcase-sync-sms').forEach(el => el.textContent = sms)
  }

  function updateSmsMetrics(text) {
    const len = text.length
    const segs = len <= 160 ? 1 : Math.ceil(len / 153)
    if (smsCharCount) smsCharCount.textContent = len
    if (smsSegmentCount) smsSegmentCount.textContent = `${segs} SMS`
  }

  function updateRecipientsList(recipients) {
    currentRecipients = recipients
    const total = recipients.length
    const withPost = recipients.filter(r => r.hasValidAddress).length
    const withEmail = recipients.filter(r => r.hasValidEmail).length

    if (counterTotal) counterTotal.textContent = total
    if (counterPost) counterPost.textContent = withPost
    if (counterEmail) counterEmail.textContent = withEmail
    if (recipientCountBadge) recipientCountBadge.textContent = total
    if (batchBtnLabel) batchBtnLabel.textContent = `Sammel-PDF herunterladen (${total} Briefe) ↗`

    if (!recipientList) return

    recipientList.innerHTML = recipients.map((rec, idx) => `
      <div
        class="recipient-card p-3 rounded-xs border transition-all cursor-pointer ${
          idx === 0 ? 'border-orange bg-forest-900' : 'border-paper/10 bg-forest-900/40 hover:border-paper/30'
        }"
        data-rec-id="${rec.id}"
        data-rec-name="${rec.displayName}"
        data-rec-salutation="${rec.salutation}"
        data-rec-street="${rec.address?.street || ''}"
        data-rec-city="${rec.address ? `${rec.address.postalCode} ${rec.address.city}` : ''}"
        data-rec-age="${rec.age || ''}"
      >
        <div class="flex items-start justify-between gap-2">
          <div>
            <div class="font-mono text-xs font-bold text-paper flex items-center gap-1.5">
              <span>${rec.displayName}</span>
              ${rec.age ? `<span class="text-[0.65rem] text-orange border border-orange/30 px-1 py-0.2 rounded-xs">${rec.age} J.</span>` : ''}
            </div>
            <div class="text-[0.7rem] font-mono text-paper/60 mt-0.5">
              ${rec.hasValidAddress ? `${rec.address?.street}, ${rec.address?.postalCode} ${rec.address?.city}` : 'Keine vollständige Adresse'}
            </div>
            ${rec.parentNames ? `<div class="text-[0.65rem] font-mono text-paper/40 mt-0.5">Eltern: ${rec.parentNames}</div>` : ''}
          </div>
          <div>
            ${rec.hasValidAddress ? `
              <span class="inline-flex items-center gap-1 text-[0.65rem] font-mono text-green-400 border border-green-500/30 px-1.5 py-0.5 rounded-xs bg-green-950/40">
                <span>Bereit</span>
              </span>
            ` : `
              <span class="inline-flex items-center gap-1 text-[0.65rem] font-mono text-yellow-400 border border-yellow-500/30 px-1.5 py-0.5 rounded-xs bg-yellow-950/40">
                <span>Adresse fehlt</span>
              </span>
            `}
          </div>
        </div>
      </div>
    `).join('')

    // Reattach click handlers
    const cards = recipientList.querySelectorAll('.recipient-card')
    cards.forEach((card) => {
      card.addEventListener('click', () => {
        cards.forEach((c) => {
          c.classList.remove('border-orange', 'bg-forest-900')
          c.classList.add('border-paper/10', 'bg-forest-900/40')
        })
        card.classList.remove('border-paper/10', 'bg-forest-900/40')
        card.classList.add('border-orange', 'bg-forest-900')

        const name = card.dataset.recName
        const salutation = card.dataset.recSalutation
        const street = card.dataset.recStreet
        const city = card.dataset.recCity

        if (previewAddrName) previewAddrName.textContent = name || 'Jonas Müller'
        if (previewAddrStreet) previewAddrStreet.textContent = street || 'Lindenallee 14'
        if (previewAddrCity) previewAddrCity.textContent = city || '37308 Heilbad Heiligenstadt'
        if (previewSalutation) previewSalutation.textContent = `${salutation || 'Lieber Jonas'},`
      })
    })

    // Update preview with first recipient
    const first = recipients[0]
    if (first) {
      if (previewAddrName) previewAddrName.textContent = first.displayName
      if (previewAddrStreet) previewAddrStreet.textContent = first.address?.street || ''
      if (previewAddrCity) previewAddrCity.textContent = first.address ? `${first.address.postalCode} ${first.address.city}` : ''
      if (previewSalutation) previewSalutation.textContent = `${first.salutation},`
    }
  }

  // Event Selection Change
  if (eventSelect) {
    eventSelect.addEventListener('change', (e) => {
      updateEvent(e.target.value)
    })
  }

  async function fetchLiveGroupContacts(groupId) {
    try {
      const res = await fetch(`/toolbox-auth/civicrm-api.php?action=contacts&group_id=${groupId}`)
      if (res.ok) {
        const data = await res.json()
        if (data.success && Array.isArray(data.contacts) && data.contacts.length > 0) {
          clientData.groupRecipientsMap[groupId] = data.contacts
          updateRecipientsList(data.contacts)
          return
        }
      }
    } catch (err) {
      console.log('[civi] PHP endpoint offline or unreachable, using local cache:', err)
    }
    // Fallback to precomputed cache
    const fallbackRecs = clientData.groupRecipientsMap[groupId] || []
    updateRecipientsList(fallbackRecs)
  }

  // Group Selection Change
  if (groupSelect) {
    groupSelect.addEventListener('change', (e) => {
      currentGroupId = Number(e.target.value)
      fetchLiveGroupContacts(currentGroupId)
    })
  }

  // Initial live sync on page load
  fetchLiveGroupContacts(currentGroupId)

  // Handle URL query param: ?event=...
  const urlParams = new URLSearchParams(window.location.search)
  const initialParamEvent = urlParams.get('event')
  if (initialParamEvent && clientData.events.some((e) => e.id === initialParamEvent)) {
    if (eventSelect) eventSelect.value = initialParamEvent
    updateEvent(initialParamEvent)
  }

  // SMS Textarea input
  if (smsTextarea) {
    smsTextarea.addEventListener('input', (e) => {
      const val = e.target.value
      if (phoneSmsPreview) phoneSmsPreview.textContent = val
      document.querySelectorAll('.showcase-sync-sms').forEach(el => el.textContent = val)
      updateSmsMetrics(val)
    })
  }

  // Copy SMS
  if (btnCopySms) {
    btnCopySms.addEventListener('click', () => {
      const text = smsTextarea ? smsTextarea.value : ''
      navigator.clipboard.writeText(text).then(() => {
        if (copySmsLabel) copySmsLabel.textContent = 'Kopiert!'
        setTimeout(() => {
          if (copySmsLabel) copySmsLabel.textContent = 'SMS kopieren'
        }, 2000)
      })
    })
  }

  // Copy Email HTML
  if (btnCopyEmailHtml) {
    btnCopyEmailHtml.addEventListener('click', () => {
      const html = clientData.defaultEmailHtml
      navigator.clipboard.writeText(html).then(() => {
        if (copyEmailLabel) copyEmailLabel.textContent = 'Kopiert!'
        setTimeout(() => {
          if (copyEmailLabel) copyEmailLabel.textContent = 'HTML kopieren'
        }, 2000)
      })
    })
  }

  // Real CiviCRM Draft Creation API
  async function triggerCiviDraft(type) {
    const isEmail = type === 'email'
    const grp = clientData.groups.find((g) => g.id === currentGroupId)
    const groupName = grp ? grp.title : `Gruppe ${currentGroupId}`
    const actionTitle = isEmail ? 'E-Mail Mailing-Entwurf' : 'SMS-Aktivitätsentwurf'
    const fallbackCiviUrl = isEmail
      ? 'https://civi.smj-wegweiser.de/civicrm/mailing/browse/unscheduled?reset=1'
      : 'https://civi.smj-wegweiser.de/civicrm/activity?action=browse&reset=1'

    openDialogLoading(actionTitle)

    const payload = isEmail
      ? {
          type: 'email',
          campaignName: `${currentEvent.title} (Einladung)`,
          subject: `Einladung: ${currentEvent.title} – SMJ Regio Wegweiser`,
          bodyHtml: clientData.defaultEmailHtml,
          groupId: currentGroupId,
        }
      : {
          type: 'sms',
          campaignName: currentEvent.title,
          text: smsTextarea ? smsTextarea.value : '',
          groupId: currentGroupId,
        }

    try {
      const res = await fetch('/toolbox-auth/civicrm-api.php?action=draft', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })

      const contentType = res.headers.get('content-type') || ''
      if (!contentType.includes('application/json')) {
        const text = await res.text()
        throw new Error(text.slice(0, 150) || `Server antwortete mit Status ${res.status}`)
      }

      const result = await res.json()
      if (result.success) {
        const msg = isEmail
          ? `Der Mailing-Entwurf für <strong>${currentEvent.title}</strong> wurde erfolgreich in CiviCRM angelegt!<br><br>Zielgruppe: <strong>${groupName}</strong> (${currentRecipients.length} Kontakte).<br>Du kannst das Mailing jetzt in CiviCRM prüfen und terminieren.`
          : `Die SMS-Aktivität für <strong>${currentEvent.title}</strong> wurde erfolgreich in CiviCRM vorbereitet!<br><br>Zielgruppe: <strong>${groupName}</strong>.`

        updateDialogSuccess(
          `${actionTitle} erstellt!`,
          msg,
          result.civicrmId,
          result.civiUrl || fallbackCiviUrl
        )
      } else {
        updateDialogError('Fehler beim Anlegen', result.message || 'CiviCRM API hat einen Fehler zurückgemeldet.', fallbackCiviUrl)
      }
    } catch (e) {
      updateDialogError('Netzwerk- oder Serverfehler', e.message || 'Konnte keine Verbindung zum CiviCRM-Endpunkt aufbauen.', fallbackCiviUrl)
    }
  }

  // Bind Civi Draft Triggers across panels & showcase
  document.querySelectorAll('.btn-trigger-email-draft').forEach((btn) => {
    btn.addEventListener('click', () => triggerCiviDraft('email'))
  })

  document.querySelectorAll('.btn-trigger-sms-draft').forEach((btn) => {
    btn.addEventListener('click', () => triggerCiviDraft('sms'))
  })

  // Tab Switching
  const tabButtons = document.querySelectorAll('.tab-btn')
  const tabPanels = document.querySelectorAll('.tab-panel')

  function switchTab(targetId) {
    tabButtons.forEach((b) => {
      if (b.dataset.target === targetId) {
        b.classList.add('border-orange', 'text-orange', 'bg-forest-900/80')
        b.classList.remove('border-transparent', 'text-paper/60')
      } else {
        b.classList.remove('border-orange', 'text-orange', 'bg-forest-900/80')
        b.classList.add('border-transparent', 'text-paper/60')
      }
    })

    tabPanels.forEach((panel) => {
      if (panel.id === targetId) {
        panel.classList.remove('hidden')
      } else {
        panel.classList.add('hidden')
      }
    })
  }

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      switchTab(btn.dataset.target)
    })
  })

  document.querySelectorAll('.quick-switch-tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.dataset.target
      if (targetId) switchTab(targetId)
    })
  })
</script>
