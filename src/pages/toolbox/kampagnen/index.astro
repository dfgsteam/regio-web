---
import { eventProvider } from '../../../lib/events'
import { getAllCamps } from '../../../lib/camps'

const [events, camps] = await Promise.all([eventProvider.getEvents(), getAllCamps()])
const upcomingEvents = events
  .filter((e) => new Date(e.end).getTime() >= Date.now() - 86400000 * 7)
  .sort((a, b) => new Date(a.start).getTime() - new Date(b.start).getTime())
const nextCamp = camps[0] ? `zeltlager-${camps[0].data.year}` : null
const defaultSlug = upcomingEvents[0]?.slug || nextCamp || events[0]?.slug || 'actionwochenende-3-2026'
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <title>Weiterleitung zur Kampagnen-Zentrale...</title>
    <script is:inline define:vars={{ defaultSlug }}>
      const params = new URLSearchParams(window.location.search)
      const event = params.get('event') || defaultSlug
      window.location.replace(`/toolbox/${event}/kampagne/`)
    </script>
    <meta http-equiv="refresh" content={`0;url=/toolbox/${defaultSlug}/kampagne/`} />
  </head>
  <body style="background: #111713; color: #F1EBDD; font-family: monospace; padding: 2rem;">
    <p>Kampagnen-Zentrale wird geladen...</p>
  </body>
</html>
