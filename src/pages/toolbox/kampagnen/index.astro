---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import ToolboxHeader from '../../../components/navigation/ToolboxHeader.astro'
import {
  Mail,
  Send,
  Copy,
  Users,
  Printer,
  FileText,
  Smartphone,
  Calendar,
  Check,
  QrCode,
  Sparkles,
  Info,
  LayoutGrid,
  ExternalLink,
  Share2,
  CreditCard,
  Image as ImageIcon,
  CircleAlert,
  CircleCheck,
  Loader,
  X,
} from '@lucide/astro'
import { eventProvider, formatDateRange, formatAgeRange } from '../../../lib/events'
import { getAllCamps } from '../../../lib/camps'
import { getCampaignGroups, getGroupRecipients } from '../../../lib/civicrm/client'
import { generateCampaignEmailHtml } from '../../../lib/civicrm/email-template'
import { generateCampaignSmsText } from '../../../lib/civicrm/sms-template'
import type { CampaignEventData, CiviRecipient } from '../../../lib/civicrm/types'
import { QR_BASE_URL } from '../../../lib/qr-url'

const [events, camps, groups] = await Promise.all([
  eventProvider.getEvents(),
  getAllCamps(),
  getCampaignGroups(),
])

// Prepare unified events list with dynamic pricing
const campaignEvents: CampaignEventData[] = [
  ...camps.map((c) => ({
    id: `zeltlager-${c.data.year}`,
    title: c.data.title.toUpperCase(),
    subtitle: (c.data.motto || `Sommerzeltlager ${c.data.year}`).toUpperCase(),
    category: 'ZELTLAGER',
    dateStr: formatDateRange(c.data.date.start, c.data.date.end),
    locationStr: c.data.location?.name || 'Wiesenthal bei Thalwenden',
    ageStr: formatAgeRange(c.data.age?.min, c.data.age?.max) || '9 – 14 Jahre',
    priceStr: (c.data as any).price || '190 €',
    registrationUrl: `${QR_BASE_URL}/abenteuer/zeltlager-${c.data.year}/`,
  })),
  ...events.map((e) => ({
    id: e.slug,
    title: e.title.toUpperCase(),
    subtitle: (e.teaser || 'Aktion & Abenteuer der SMJ Regio Wegweiser').toUpperCase(),
    category: e.category === 'weekend' ? 'WOCHENENDE' : 'AKTION',
    dateStr: formatDateRange(e.start, e.end),
    locationStr: e.location || 'Klause 2.0, Heiligenstadt',
    ageStr: formatAgeRange(e.ageMin, e.ageMax) || '9 – 14 Jahre',
    priceStr: e.price ? e.price : (e.category === 'weekend' ? 'Inkl. Verpflegung' : 'Auf Anfrage'),
    registrationUrl: `${QR_BASE_URL}/abenteuer/${e.slug}/`,
  })),
]

// Default initial selection
const initialEvent = campaignEvents[0]!
const initialGroup = groups.find((g) => g.id === 12) || groups[0]!

// Pre-fetch recipients for all available campaign groups for instant switching
const groupRecipientsMap: Record<number, CiviRecipient[]> = {}
await Promise.all(
  groups.map(async (g) => {
    groupRecipientsMap[g.id] = await getGroupRecipients(g.id)
  })
)

const initialRecipients = groupRecipientsMap[initialGroup.id] || []

// Pre-generate initial Email & SMS drafts
const initialEmailHtml = generateCampaignEmailHtml(initialEvent)
const initialSms = generateCampaignSmsText(initialEvent)

// Serializable data bundle for client interactivity
const clientData = {
  events: campaignEvents,
  groups,
  groupRecipientsMap,
  defaultRecipients: initialRecipients,
  defaultEmailHtml: initialEmailHtml,
  defaultSmsText: initialSms.text,
}
---

<BaseLayout
  title="CiviCRM Kampagnen & Anschreiben – Leiter-Toolbox"
  description="Crossmedia-Vorschau, persönliche Anschreiben (DIN A4 PDF), E-Mail-Mailing-Drafts und SMS-Sammelnachrichten aus deinen CiviCRM Smartgruppen."
  noIndex={true}
>
  <ToolboxHeader currentTitle="CiviCRM Kampagnen" backHref="/toolbox/" backLabel="Zurück zur Toolbox" activeNav="kampagnen" />

  <main class="bg-forest-950 py-8 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto space-y-8">
      
      <!-- Page Header Banner -->
      <div class="border-b border-paper/15 pb-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-widest text-orange mb-1">
              <Sparkles class="h-4 w-4" />
              <span>CIVICRM AUTOMATION &bull; CROSSMEDIA-STUDIO</span>
            </div>
            <h1 class="display text-3xl sm:text-4xl text-paper uppercase">
              Kampagnen-Studio &amp; Medien-Zentrale
            </h1>
            <p class="font-mono text-xs sm:text-sm text-paper/70 mt-1 max-w-3xl">
              Zielgruppen aus CiviCRM Smartgruppen steuern, alle Werbemedien auf einen Blick vergleichen, persönliche Briefe nach DIN 5008 drucken und CiviCRM-Entwürfe (E-Mail &amp; SMS) anlegen.
            </p>
          </div>

          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xs border border-orange/40 bg-orange/10 font-mono text-xs text-orange font-bold">
              <span class="w-2 h-2 rounded-full bg-orange animate-pulse"></span>
              <span>CiviCRM APIv4 aktiv</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Step 1 & 2 Controls: Event & Group Selection -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        
        <!-- Select Event -->
        <div class="border border-paper/20 bg-forest-900/80 p-5 rounded-xs shadow-md">
          <label for="event-select" class="block font-mono text-xs font-bold uppercase text-orange mb-2 flex items-center justify-between">
            <span class="flex items-center gap-1.5">
              <Calendar class="w-4 h-4" />
              <span>1. Aktion / Event auswählen</span>
            </span>
            <span class="text-paper/40 font-normal">{campaignEvents.length} Aktionen</span>
          </label>
          <select
            id="event-select"
            class="w-full bg-forest-950 border border-paper/30 text-paper font-mono text-sm px-3.5 py-2.5 rounded-xs focus:outline-none focus:border-orange cursor-pointer"
          >
            {campaignEvents.map((ev) => (
              <option value={ev.id} selected={ev.id === initialEvent.id}>
                {ev.title} ({ev.dateStr})
              </option>
            ))}
          </select>
          <div class="mt-3 flex flex-wrap items-center gap-3 text-xs font-mono text-paper/60">
            <span class="flex items-center gap-1">
              <span class="text-paper/40">Ort:</span>
              <strong id="badge-location" class="text-paper">{initialEvent.locationStr}</strong>
            </span>
            <span>&bull;</span>
            <span class="flex items-center gap-1">
              <span class="text-paper/40">Alter:</span>
              <strong id="badge-age" class="text-paper">{initialEvent.ageStr}</strong>
            </span>
            <span>&bull;</span>
            <span class="flex items-center gap-1">
              <span class="text-paper/40">Kosten:</span>
              <strong id="badge-price" class="text-orange">{initialEvent.priceStr}</strong>
            </span>
          </div>
        </div>

        <!-- Select Smartgroup -->
        <div class="border border-paper/20 bg-forest-900/80 p-5 rounded-xs shadow-md">
          <label for="group-select" class="block font-mono text-xs font-bold uppercase text-orange mb-2 flex items-center justify-between">
            <span class="flex items-center gap-1.5">
              <Users class="w-4 h-4" />
              <span>2. CiviCRM Zielgruppe (Smartgruppe)</span>
            </span>
            <span class="text-paper/40 font-normal">CiviCRM Sync</span>
          </label>
          <select
            id="group-select"
            class="w-full bg-forest-950 border border-paper/30 text-paper font-mono text-sm px-3.5 py-2.5 rounded-xs focus:outline-none focus:border-orange cursor-pointer"
          >
            {groups.map((g) => (
              <option value={g.id} selected={g.id === initialGroup.id}>
                {g.title} {g.isSmart ? '⚡ [Smartgruppe]' : ''}
              </option>
            ))}
          </select>
          <div class="mt-3 flex flex-wrap items-center gap-3 text-xs font-mono">
            <span class="text-paper/90">
              Gefunden: <strong id="counter-total" class="text-orange">{initialRecipients.length}</strong> Kontakte
            </span>
            <span class="text-paper/50">&bull;</span>
            <span class="text-paper/70">
              <strong id="counter-post" class="text-green-400">{initialRecipients.filter(r => r.hasValidAddress).length}</strong> mit Postanschrift
            </span>
            <span class="text-paper/50">&bull;</span>
            <span class="text-paper/70">
              <strong id="counter-email" class="text-blue-400">{initialRecipients.filter(r => r.hasValidEmail).length}</strong> mit E-Mail
            </span>
          </div>
        </div>

      </div>

      <!-- Step 3: Tab Navigation for Output Channels -->
      <div class="border border-paper/20 bg-forest-900/60 rounded-xs overflow-hidden shadow-lg">
        
        <!-- Tab Bar -->
        <div class="border-b border-paper/20 bg-forest-950/80 flex flex-wrap items-center px-2 pt-2 gap-2">
          
          <button
            type="button"
            id="tab-btn-showcase"
            class="tab-btn flex items-center gap-2 px-5 py-3 font-mono text-xs font-bold uppercase tracking-wider transition-all border-b-2 border-orange text-orange bg-forest-900/80 rounded-t-xs"
            data-target="tab-panel-showcase"
          >
            <LayoutGrid class="w-4 h-4" />
            <span>Alle Medien (Crossmedia-Vorschau)</span>
          </button>

          <button
            type="button"
            id="tab-btn-letter"
            class="tab-btn flex items-center gap-2 px-5 py-3 font-mono text-xs font-bold uppercase tracking-wider transition-all border-b-2 border-transparent text-paper/60 hover:text-paper hover:bg-forest-900/40 rounded-t-xs"
            data-target="tab-panel-letter"
          >
            <Printer class="w-4 h-4" />
            <span>Persönliche Anschreiben (A4 Post)</span>
          </button>
          
          <button
            type="button"
            id="tab-btn-email"
            class="tab-btn flex items-center gap-2 px-5 py-3 font-mono text-xs font-bold uppercase tracking-wider transition-all border-b-2 border-transparent text-paper/60 hover:text-paper hover:bg-forest-900/40 rounded-t-xs"
            data-target="tab-panel-email"
          >
            <Mail class="w-4 h-4" />
            <span>E-Mail Sammelnachricht (HTML)</span>
          </button>
          
          <button
            type="button"
            id="tab-btn-sms"
            class="tab-btn flex items-center gap-2 px-5 py-3 font-mono text-xs font-bold uppercase tracking-wider transition-all border-b-2 border-transparent text-paper/60 hover:text-paper hover:bg-forest-900/40 rounded-t-xs"
            data-target="tab-panel-sms"
          >
            <Smartphone class="w-4 h-4" />
            <span>SMS Sammelnachricht</span>
          </button>
        </div>

        <!-- ========================================== -->
        <!-- TAB PANEL 0: ALLE MEDIENTYPEN VORSCHAU     -->
        <!-- ========================================== -->
        <div id="tab-panel-showcase" class="tab-panel p-6 space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-paper/10 pb-4">
            <div>
              <h3 class="display text-xl sm:text-2xl text-paper uppercase">
                Crossmedia-Übersicht für diese Aktion
              </h3>
              <p class="font-mono text-xs text-paper/70 mt-1 max-w-2xl">
                Alle Werbe- und Informationsmedien werden einheitlich im SMJ-Abenteuer-Design generiert – vom gedruckten Postbrief bis zum Social-Media-Feed.
              </p>
            </div>
            <div class="shrink-0 flex items-center gap-2">
              <span class="font-mono text-xs text-paper/60 bg-forest-950 px-3 py-1.5 rounded-xs border border-paper/20">
                Aktion: <strong id="showcase-current-title" class="text-orange">{initialEvent.title}</strong>
              </span>
            </div>
          </div>

          <!-- Cards Grid for all media types -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

            <!-- 1. DIN A4 Anschreiben (Post) -->
            <div class="border border-paper/20 bg-forest-950/80 rounded-xs overflow-hidden flex flex-col justify-between hover:border-paper/40 transition-all shadow-md">
              <div class="p-4 border-b border-paper/15 bg-forest-900/50 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <Printer class="w-4 h-4 text-orange" />
                  <span class="font-mono text-xs font-bold uppercase text-paper">1. DIN A4 Postbrief</span>
                </div>
                <span class="text-[0.65rem] font-mono text-paper/50 bg-forest-950 px-2 py-0.5 rounded-xs border border-paper/20">DIN 5008</span>
              </div>
              <div class="p-5 flex-1 flex flex-col items-center justify-center bg-[#151b16]">
                <div class="w-full max-w-[220px] aspect-[1/1.41] bg-white text-[#111713] p-3 shadow-lg rounded-xs flex flex-col justify-between text-[6px] border border-gray-300">
                  <div class="flex items-start justify-between border-b border-gray-200 pb-1">
                    <img src="/logo_wegweiser_dark.svg" alt="SMJ Logo" class="h-3.5 w-auto" />
                    <span class="font-['Impact'] text-[7px] text-[#FF5A1F]">SMJ WEGWEISER</span>
                  </div>
                  <div class="space-y-0.5 my-1">
                    <div class="text-[4.5px] text-gray-400 font-mono">Pater-Kentenich-Weg 3 • 37308 Heilbad Heiligenstadt</div>
                    <div class="font-bold text-[6px] text-[#111713]">Lukas Mustermann</div>
                    <div class="text-[5px] text-gray-600">Am Berg 12, Heiligenstadt</div>
                  </div>
                  <div class="border-t border-b border-gray-100 py-1 space-y-0.5">
                    <div class="font-bold text-[6.5px] text-[#FF5A1F] uppercase truncate showcase-sync-title">{initialEvent.title}</div>
                    <div class="text-[5px] text-gray-700 truncate">Termin: <span class="showcase-sync-date">{initialEvent.dateStr}</span></div>
                    <div class="text-[5px] text-gray-700 truncate">Ort: <span class="showcase-sync-loc">{initialEvent.locationStr}</span></div>
                  </div>
                  <div class="flex items-center justify-between pt-1 border-t border-gray-200">
                    <span class="text-[4.5px] text-gray-500">smj-wegweiser.de</span>
                    <QrCode class="w-3.5 h-3.5 text-black" />
                  </div>
                </div>
              </div>
              <div class="p-4 bg-forest-900/60 border-t border-paper/15 space-y-2">
                <div class="text-xs font-mono text-paper/80 flex items-center justify-between">
                  <span>Persönliche Ansprache</span>
                  <span class="text-green-400 font-bold">Fensterkuvert</span>
                </div>
                <div class="grid grid-cols-2 gap-2 pt-1">
                  <a
                    id="showcase-btn-muster-pdf"
                    href={`/toolbox/briefe/${initialEvent.id}-muster.pdf`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 bg-forest-950 border border-paper/30 text-paper font-mono text-xs font-bold uppercase hover:bg-forest-900 rounded-xs"
                  >
                    <span>Muster PDF ↗</span>
                  </a>
                  <button
                    type="button"
                    class="quick-switch-tab inline-flex items-center justify-center gap-1.5 px-3 py-1.5 bg-orange text-forest-950 font-mono text-xs font-bold uppercase hover:bg-paper rounded-xs"
                    data-target="tab-panel-letter"
                  >
                    <span>Briefe-Tab →</span>
                  </button>
                </div>
              </div>
            </div>

            <!-- 2. Flyer / Plakat (Ausleger) -->
            <div class="border border-paper/20 bg-forest-950/80 rounded-xs overflow-hidden flex flex-col justify-between hover:border-paper/40 transition-all shadow-md">
              <div class="p-4 border-b border-paper/15 bg-forest-900/50 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <FileText class="w-4 h-4 text-orange" />
                  <span class="font-mono text-xs font-bold uppercase text-paper">2. Plakat / Flyer</span>
                </div>
                <span class="text-[0.65rem] font-mono text-paper/50 bg-forest-950 px-2 py-0.5 rounded-xs border border-paper/20">A4 / A5 Print</span>
              </div>
              <div class="p-5 flex-1 flex flex-col items-center justify-center bg-[#151b16]">
                <div class="w-full max-w-[220px] aspect-[1/1.41] bg-forest-900 text-paper p-3 shadow-lg rounded-xs flex flex-col justify-between text-[6px] border border-orange/40 relative overflow-hidden">
                  <div class="flex items-center justify-between border-b border-paper/20 pb-1">
                    <img src="/logo_wegweiser_white.svg" alt="SMJ Logo" class="h-3 w-auto" />
                    <span class="font-mono text-[5px] text-orange tracking-widest font-bold">SMJ WEGWEISER</span>
                  </div>
                  <div class="my-auto text-center space-y-1">
                    <span class="inline-block bg-orange text-forest-950 text-[5px] font-bold px-1 py-0.2 rounded-xs uppercase showcase-sync-cat">
                      {initialEvent.category}
                    </span>
                    <div class="display text-[11px] leading-tight text-paper uppercase showcase-sync-title">
                      {initialEvent.title}
                    </div>
                    <div class="font-mono text-[5.5px] text-orange showcase-sync-date">
                      {initialEvent.dateStr}
                    </div>
                    <div class="font-mono text-[5px] text-paper/70 showcase-sync-loc">
                      {initialEvent.locationStr}
                    </div>
                  </div>
                  <div class="flex items-center justify-between bg-forest-950/80 p-1 rounded-xs border border-paper/10">
                    <div class="text-[4.5px] font-mono text-paper/60">
                      <div>Alter: <strong class="text-paper showcase-sync-age">{initialEvent.ageStr}</strong></div>
                      <div>Beitrag: <strong class="text-orange showcase-sync-price">{initialEvent.priceStr}</strong></div>
                    </div>
                    <QrCode class="w-4 h-4 text-orange" />
                  </div>
                </div>
              </div>
              <div class="p-4 bg-forest-900/60 border-t border-paper/15 space-y-2">
                <div class="text-xs font-mono text-paper/80 flex items-center justify-between">
                  <span>Aushang &amp; Flyer</span>
                  <span class="text-orange font-bold">Wann, Wo, Wer</span>
                </div>
                <a
                  id="showcase-btn-plakat"
                  href={`/toolbox/flyer/${initialEvent.id}/`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full inline-flex items-center justify-center gap-1.5 px-3 py-1.5 bg-forest-950 border border-paper/30 text-paper font-mono text-xs font-bold uppercase hover:border-paper hover:bg-forest-900 rounded-xs"
                >
                  <FileText class="w-3.5 h-3.5 text-orange" />
                  <span>Im Plakat-Designer öffnen ↗</span>
                </a>
              </div>
            </div>

            <!-- 3. Social Media Story (9:16) -->
            <div class="border border-paper/20 bg-forest-950/80 rounded-xs overflow-hidden flex flex-col justify-between hover:border-paper/40 transition-all shadow-md">
              <div class="p-4 border-b border-paper/15 bg-forest-900/50 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <Smartphone class="w-4 h-4 text-orange" />
                  <span class="font-mono text-xs font-bold uppercase text-paper">3. Social Story (9:16)</span>
                </div>
                <span class="text-[0.65rem] font-mono text-orange bg-orange/10 px-2 py-0.5 rounded-xs border border-orange/30">Handy-Optik</span>
              </div>
              <div class="p-5 flex-1 flex flex-col items-center justify-center bg-[#151b16]">
                <div class="w-[140px] aspect-[9/16] bg-forest-900 rounded-xl p-2.5 shadow-2xl flex flex-col justify-between border-2 border-paper/30 relative overflow-hidden">
                  <!-- Story Header -->
                  <div class="flex items-center justify-between z-10">
                    <img src="/logo_wegweiser_white.svg" alt="SMJ Logo" class="h-3 w-auto" />
                    <span class="text-[4.5px] font-mono text-paper/60 uppercase">SMJ WEGWEISER</span>
                  </div>
                  <!-- Story Hero Typography -->
                  <div class="my-auto z-10 text-center space-y-1">
                    <div class="display text-[12px] text-paper leading-none uppercase tracking-wide showcase-sync-title">
                      {initialEvent.title}
                    </div>
                    <div class="bg-orange text-forest-950 font-mono text-[5.5px] font-bold py-0.5 px-1 rounded-xs inline-block showcase-sync-date">
                      {initialEvent.dateStr}
                    </div>
                    <div class="text-[5px] font-mono text-paper/70 showcase-sync-loc">
                      {initialEvent.locationStr}
                    </div>
                  </div>
                  <!-- Swipe Up Sticker -->
                  <div class="text-center z-10 bg-forest-950/80 py-1 rounded-xs border border-orange/40">
                    <span class="font-['Impact'] text-[6px] text-orange uppercase tracking-wider block">JETZT ANMELDEN</span>
                    <span class="text-[4px] font-mono text-paper/50">Link in Bio / Sticker</span>
                  </div>
                </div>
              </div>
              <div class="p-4 bg-forest-900/60 border-t border-paper/15 space-y-2">
                <div class="text-xs font-mono text-paper/80 flex items-center justify-between">
                  <span>Instagram &bull; WhatsApp Status</span>
                  <span class="text-orange font-bold">Große Schrift</span>
                </div>
                <a
                  id="showcase-btn-story"
                  href={`/toolbox/social/${initialEvent.id}/?format=story`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full inline-flex items-center justify-center gap-1.5 px-3 py-1.5 bg-forest-950 border border-paper/30 text-paper font-mono text-xs font-bold uppercase hover:border-paper hover:bg-forest-900 rounded-xs"
                >
                  <Share2 class="w-3.5 h-3.5 text-orange" />
                  <span>Im Social-Designer öffnen ↗</span>
                </a>
              </div>
            </div>

            <!-- 4. Social Media Feed Post (1:1) -->
            <div class="border border-paper/20 bg-forest-950/80 rounded-xs overflow-hidden flex flex-col justify-between hover:border-paper/40 transition-all shadow-md">
              <div class="p-4 border-b border-paper/15 bg-forest-900/50 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <ImageIcon class="w-4 h-4 text-orange" />
                  <span class="font-mono text-xs font-bold uppercase text-paper">4. Social Feed (1:1)</span>
                </div>
                <span class="text-[0.65rem] font-mono text-paper/50 bg-forest-950 px-2 py-0.5 rounded-xs border border-paper/20">Instagram Feed</span>
              </div>
              <div class="p-5 flex-1 flex flex-col items-center justify-center bg-[#151b16]">
                <div class="w-[170px] aspect-square bg-forest-900 rounded-xs p-3 shadow-xl flex flex-col justify-between border border-paper/25 relative overflow-hidden">
                  <div class="flex items-center justify-between">
                    <img src="/logo_wegweiser_white.svg" alt="SMJ Logo" class="h-3.5 w-auto" />
                    <span class="font-mono text-[5px] text-orange tracking-widest font-bold uppercase showcase-sync-cat">{initialEvent.category}</span>
                  </div>
                  <div class="my-auto text-center space-y-1">
                    <div class="display text-[12px] text-paper leading-tight uppercase showcase-sync-title">
                      {initialEvent.title}
                    </div>
                    <div class="font-mono text-[6px] text-paper/90 showcase-sync-date">
                      {initialEvent.dateStr}
                    </div>
                    <div class="font-mono text-[5px] text-paper/60 showcase-sync-loc">
                      {initialEvent.locationStr}
                    </div>
                  </div>
                  <div class="border-t border-paper/15 pt-1 flex items-center justify-between text-[5px] font-mono text-paper/60">
                    <span class="text-orange font-bold showcase-sync-price">{initialEvent.priceStr}</span>
                    <span>smj-wegweiser.de</span>
                  </div>
                </div>
              </div>
