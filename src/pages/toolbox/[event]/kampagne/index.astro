---
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import ToolboxHeader from '../../../../components/navigation/ToolboxHeader.astro'
import Logo from '../../../../components/common/Logo.astro'
import {
  Mail,
  Send,
  Copy,
  Users,
  Printer,
  FileText,
  Smartphone,
  Calendar,
  MapPin,
  QrCode,
  Sparkles,
  LayoutGrid,
  ExternalLink,
  CreditCard,
  CircleAlert,
  CircleCheck,
  Loader,
  X,
  Download,
  SlidersHorizontal,
  Square,
  ArrowLeft,
} from '@lucide/astro'
import { eventProvider, formatDateRange, formatAgeRange, getSlugVariants } from '../../../../lib/events'
import { getAllCamps } from '../../../../lib/camps'
import { getCampaignGroups, getGroupRecipients } from '../../../../lib/civicrm/client'
import { generateCampaignEmailHtml } from '../../../../lib/civicrm/email-template'
import { generateCampaignSmsText } from '../../../../lib/civicrm/sms-template'
import type { CampaignEventData, CiviRecipient } from '../../../../lib/civicrm/types'
import { QR_BASE_URL } from '../../../../lib/qr-url'
import { splitFact } from '../../../../lib/campaigns/split-fact'

export async function getStaticPaths() {
  const [events, camps, groups] = await Promise.all([
    eventProvider.getEvents(),
    getAllCamps(),
    getCampaignGroups(),
  ])

  // Prepare unified events list
  const campaignEvents: CampaignEventData[] = [
    ...camps.map((c) => ({
      id: `zeltlager-${c.data.year}`,
      title: c.data.title.toUpperCase(),
      subtitle: (c.data.motto || `Sommerzeltlager ${c.data.year}`).toUpperCase(),
      category: 'ZELTLAGER',
      dateStr: formatDateRange(c.data.date.start, c.data.date.end),
      locationStr: c.data.location?.name || 'Wiesenthal bei Thalwenden',
      ageStr: formatAgeRange(c.data.age?.min, c.data.age?.max) || '9 – 14 Jahre',
      priceStr: (c.data as any).price || '190 €',
      registrationUrl: `${QR_BASE_URL}/abenteuer/zeltlager-${c.data.year}/`,
    })),
    ...events.map((e) => ({
      id: e.slug,
      title: e.title.toUpperCase(),
      subtitle: (e.teaser || 'Aktion & Abenteuer der SMJ Regio Wegweiser').toUpperCase(),
      category: e.category === 'weekend' ? 'WOCHENENDE' : 'AKTION',
      dateStr: formatDateRange(e.start, e.end),
      locationStr: e.location || 'Klause 2.0, Heiligenstadt',
      ageStr: formatAgeRange(e.ageMin, e.ageMax) || '9 – 14 Jahre',
      priceStr: e.price || (e.category === 'weekend' ? '45 €' : 'Kostenlos'),
      registrationUrl: `${QR_BASE_URL}/abenteuer/${e.slug}/`,
    })),
  ]

  // Pre-fetch recipients for all available campaign groups
  const groupRecipientsMap: Record<number, CiviRecipient[]> = {}
  await Promise.all(
    groups.map(async (g) => {
      groupRecipientsMap[g.id] = await getGroupRecipients(g.id)
    })
  )

  const paths: {
    params: { event: string }
    props: {
      currentEvent: CampaignEventData
      allEvents: CampaignEventData[]
      groups: typeof groups
      groupRecipientsMap: typeof groupRecipientsMap
    }
  }[] = []

  const seen = new Set<string>()

  // 1. Direct campaign events
  for (const ev of campaignEvents) {
    if (!seen.has(ev.id)) {
      seen.add(ev.id)
      paths.push({
        params: { event: ev.id },
        props: {
          currentEvent: ev,
          allEvents: campaignEvents,
          groups,
          groupRecipientsMap,
        },
      })
    }
  }

  // 2. Slug variants (e.g. actionwochenende-3-2026 vs actionwochenende-3)
  for (const event of events) {
    const variants = getSlugVariants(event.slug, event.title, event.start.getFullYear())
    for (const slug of variants) {
      if (!seen.has(slug)) {
        seen.add(slug)
        const baseEv = campaignEvents.find((c) => c.id === event.slug) || campaignEvents[0]!
        paths.push({
          params: { event: slug },
          props: {
            currentEvent: { ...baseEv, id: slug },
            allEvents: campaignEvents,
            groups,
            groupRecipientsMap,
          },
        })
      }
    }
  }

  return paths
}

const { currentEvent, allEvents, groups, groupRecipientsMap } = Astro.props

const initialGroup = groups[0] || { id: 12, title: 'Smartgruppe 12 (Alter 9-15)', isSmart: true }
const initialRecipients = groupRecipientsMap[initialGroup.id] || []

// Pre-generate initial Email & SMS drafts
const initialEmailHtml = generateCampaignEmailHtml(currentEvent)
const initialSmsObj = generateCampaignSmsText(currentEvent)
const initialSms = initialSmsObj.text

// Fact split for letter preview
const [initDate1, initDate2] = splitFact('WANN', currentEvent.dateStr)
const [initLoc1, initLoc2] = splitFact('WO', currentEvent.locationStr)
const [initAge1, initAge2] = splitFact('WER', currentEvent.ageStr)

// Ready-to-copy Instagram caption
const initialCaption = `🏕️ ${currentEvent.title} // RAUS. INS ABENTEUER.

${currentEvent.subtitle ? `🔥 ${currentEvent.subtitle}\n\n` : ''}Bist du bereit für echte Gemeinschaft, Natur und unvergessliche Tage draußen?

📅 Wann: ${currentEvent.dateStr}
📍 Wo: ${currentEvent.locationStr}
👥 Wer: ${currentEvent.ageStr}
💰 Beitrag: ${currentEvent.priceStr}

👉 Alle Infos & Online-Anmeldung über den Link in der Bio oder direkt unter:
🔗 ${currentEvent.registrationUrl}

#smj #regiowegweiser #jugendleitetjugend #eichsfeld #abenteuer #zeltlager #outdoor #lagerfeuer`

// Serializable data bundle for client interactivity
const clientData = {
  events: allEvents,
  currentEvent,
  groups,
  groupRecipientsMap,
  defaultRecipients: initialRecipients,
  defaultEmailHtml: initialEmailHtml,
  defaultSms: initialSms,
  initialCaption,
}
---

<BaseLayout
  title={`Kampagne: ${currentEvent.title} – Leiter-Toolbox`}
  description={`All-in-One Kampagnen-Zentrale für ${currentEvent.title}: A4-Plakate, Instagram Stories, DIN 5008 Postbriefe und CiviCRM E-Mail & SMS.`}
  noIndex={true}
>
  <ToolboxHeader activeNav="kampagnen" currentTitle={`Kampagne · ${currentEvent.title}`} backHref="/toolbox/" backLabel="Zurück zur Toolbox" />

  <main class="min-h-screen bg-forest-950 text-paper pb-24">

    <!-- Top Sticky Bar: Event Switcher & Quick Action Links -->
    <div class="sticky top-14 z-40 bg-forest-950/95 border-b border-paper/15 backdrop-blur-md px-4 py-3 shadow-md">
      <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4">
        
        <!-- Left: Breadcrumb & Switcher -->
        <div class="flex items-center gap-3">
          <a
            href="/toolbox/"
            class="text-paper/60 hover:text-orange text-xs font-mono uppercase tracking-wider flex items-center gap-1.5 transition-colors"
          >
            <ArrowLeft class="w-3.5 h-3.5 text-orange" />
            <span class="hidden sm:inline">Alle Aktionen</span>
          </a>
          <span class="text-paper/20">/</span>

          <!-- Fast Event Dropdown Switcher -->
          <div class="flex items-center gap-2">
            <span class="font-mono text-xs uppercase font-bold text-orange hidden md:inline">Aktion:</span>
            <select
              id="header-event-select"
              class="bg-forest-900 border border-paper/25 text-paper font-mono text-xs px-3 py-1.5 rounded-xs focus:outline-none focus:border-orange cursor-pointer max-w-[260px] sm:max-w-xs truncate"
            >
              {allEvents.map((ev) => (
                <option value={ev.id} selected={ev.id === currentEvent.id}>
                  {ev.title} ({ev.dateStr})
                </option>
              ))}
            </select>
          </div>
        </div>

        <!-- Right: 1-Click Fast Downloads -->
        <div class="flex items-center gap-2">
          <a
            href={`/toolbox/flyers/${currentEvent.id}.pdf`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-2.5 py-1.5 bg-forest-900 border border-paper/25 text-paper hover:border-orange hover:text-orange text-[11px] font-mono font-bold uppercase rounded-xs transition-colors"
            title="Druckfertiges A4-Plakat als PDF öffnen"
          >
            <FileText class="w-3.5 h-3.5 text-orange" />
            <span>A4 Plakat</span>
          </a>

          <a
            href={`/toolbox/social-images/${currentEvent.id}-story-dark.png`}
            download={`smj-${currentEvent.id}-story.png`}
            class="inline-flex items-center gap-1.5 px-2.5 py-1.5 bg-forest-900 border border-paper/25 text-paper hover:border-orange hover:text-orange text-[11px] font-mono font-bold uppercase rounded-xs transition-colors"
            title="Instagram Story (9:16) in 1080px herunterladen"
          >
            <Smartphone class="w-3.5 h-3.5 text-orange" />
            <span>Story</span>
          </a>

          <a
            id="header-btn-letter-pdf"
            href={`/toolbox/briefe/${currentEvent.id}-muster.pdf`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-2.5 py-1.5 bg-forest-900 border border-paper/25 text-paper hover:border-orange hover:text-orange text-[11px] font-mono font-bold uppercase rounded-xs transition-colors"
