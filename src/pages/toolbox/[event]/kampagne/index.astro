          >
            <Printer class="w-3.5 h-3.5 text-orange" />
            <span>Brief (PDF)</span>
          </a>
        </div>

      </div>
    </div>

    <!-- Main Container -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">

      <!-- Event Header Hero Banner -->
      <div class="border border-paper/20 bg-forest-900/80 p-6 sm:p-8 rounded-xs mb-8 shadow-xl relative overflow-hidden">
        
        <!-- Subtle Background Watermark -->
