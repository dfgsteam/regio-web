          </button>

          <!-- Tab 3: A4 Plakat & Flyer -->
          <button
            type="button"
            class="tab-btn flex items-center gap-2 px-4 py-3 font-mono text-xs font-bold uppercase tracking-wider transition-all border-b-2 border-transparent text-paper/60 hover:text-paper hover:bg-forest-900/40 rounded-t-xs cursor-pointer"
            data-target="tab-panel-flyer"
          >
            <FileText class="w-4 h-4" />
            <span>3. A4 Plakat / Flyer</span>
          </button>

          <!-- Tab 4: Persönlicher Brief -->
          <button
            type="button"
            class="tab-btn flex items-center gap-2 px-4 py-3 font-mono text-xs font-bold uppercase tracking-wider transition-all border-b-2 border-transparent text-paper/60 hover:text-paper hover:bg-forest-900/40 rounded-t-xs cursor-pointer"
            data-target="tab-panel-letter"
          >
            <Printer class="w-4 h-4" />
            <span>4. Persönliche Postbriefe</span>
          </button>

          <!-- Tab 5: E-Mail Kampagne -->
          <button
            type="button"
            class="tab-btn flex items-center gap-2 px-4 py-3 font-mono text-xs font-bold uppercase tracking-wider transition-all border-b-2 border-transparent text-paper/60 hover:text-paper hover:bg-forest-900/40 rounded-t-xs cursor-pointer"
            data-target="tab-panel-email"
          >
            <Mail class="w-4 h-4" />
            <span>5. E-Mail Sammelnachricht</span>
          </button>

          <!-- Tab 6: SMS Vorbereitung -->
          <button
            type="button"
            class="tab-btn flex items-center gap-2 px-4 py-3 font-mono text-xs font-bold uppercase tracking-wider transition-all border-b-2 border-transparent text-paper/60 hover:text-paper hover:bg-forest-900/40 rounded-t-xs cursor-pointer"
            data-target="tab-panel-sms"
          >
            <Send class="w-4 h-4" />
            <span>6. SMS Einladung</span>
          </button>

          <!-- Tab 7: Empfängerliste -->
          <button
            type="button"
            class="tab-btn flex items-center gap-2 px-4 py-3 font-mono text-xs font-bold uppercase tracking-wider transition-all border-b-2 border-transparent text-paper/60 hover:text-paper hover:bg-forest-900/40 rounded-t-xs cursor-pointer"
            data-target="tab-panel-recipients"
          >
            <Users class="w-4 h-4" />
            <span>7. Empfänger (<span id="tab-recipient-count">{initialRecipients.length}</span>)</span>
          </button>

        </div>

        <!-- ========================================== -->
        <!-- TAB PANEL 1: CROSSMEDIA SHOWCASE OVERVIEW -->
