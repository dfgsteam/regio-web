            ))}
          </select>
        </div>

        <div class="flex items-center gap-4 bg-forest-950/80 border border-paper/15 p-3.5 rounded-xs font-mono text-xs">
          <div>
            <div class="text-paper/50 text-[10px] uppercase">Empfänger</div>
            <strong id="counter-total" class="text-orange text-base font-bold">{initialRecipients.length}</strong>
          </div>
          <div class="w-px h-8 bg-paper/15"></div>
          <div>
            <div class="text-paper/50 text-[10px] uppercase">Postadresse</div>
            <strong id="counter-post" class="text-green-400 text-base font-bold">
              {initialRecipients.filter((r) => r.hasValidAddress).length}
            </strong>
          </div>
          <div class="w-px h-8 bg-paper/15"></div>
          <div>
            <div class="text-paper/50 text-[10px] uppercase">E-Mail</div>
            <strong id="counter-email" class="text-blue-400 text-base font-bold">
              {initialRecipients.filter((r) => r.hasValidEmail).length}
            </strong>
          </div>
        </div>

      </div>

      <!-- MAIN TABS CONTAINER: All Channels Integrated on One Page -->
      <div class="border border-paper/20 bg-forest-900/60 rounded-xs overflow-hidden shadow-2xl">
        
        <!-- Tab Bar -->
        <div class="border-b border-paper/20 bg-forest-950/90 flex flex-wrap items-center px-3 pt-3 gap-2 overflow-x-auto">
          
          <!-- Tab 1: Crossmedia Showcase -->
          <button
            type="button"
            class="tab-btn active flex items-center gap-2 px-4 py-3 font-mono text-xs font-bold uppercase tracking-wider transition-all border-b-2 border-orange text-orange bg-forest-900/80 rounded-t-xs cursor-pointer"
