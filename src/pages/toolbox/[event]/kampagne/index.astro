                <!-- Thumbnail -->
                <div class="bg-forest-900 border border-paper/15 p-2 rounded-xs mb-4 flex items-center justify-center">
                  <img
                    src={`/toolbox/social-images/${currentEvent.id}-story-dark.png`}
                    alt="Story Vorschau"
