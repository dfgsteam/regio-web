          </div>
        </div>

      </div>

      <!-- CiviCRM Smartgroup Target Selector Banner -->
      <div class="bg-forest-900/60 border border-paper/20 p-5 rounded-xs mb-8 flex flex-col md:flex-row md:items-center justify-between gap-5 shadow-md">
        
        <div class="flex-1">
          <label for="group-select" class="block font-mono text-xs font-bold uppercase text-orange mb-1.5 flex items-center gap-2">
            <Users class="w-4 h-4 text-orange" />
            <span>CiviCRM Zielgruppe &amp; Smartgruppe auswählen</span>
          </label>
          <select
            id="group-select"
            class="w-full bg-forest-950 border border-paper/30 text-paper font-mono text-sm px-3.5 py-2.5 rounded-xs focus:outline-none focus:border-orange cursor-pointer"
