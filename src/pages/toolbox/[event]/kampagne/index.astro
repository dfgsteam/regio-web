                  </div>
                  <div id="preview-addr-street" class="text-[8px] text-gray-700">
                    {initialRecipients[0]?.address?.street || 'Am Berg 12'}
                  </div>
                  <div id="preview-addr-city" class="text-[8px] text-gray-700">
                    {initialRecipients[0]?.address?.postalCode || '37308'} {initialRecipients[0]?.address?.city || 'Heilbad Heiligenstadt'}
                  </div>
                </div>

                <!-- Subject & Date -->
                <div class="mb-4">
                  <div class="flex justify-between items-baseline mb-1">
                    <span class="text-orange text-[7.5px] font-bold uppercase tracking-wider">// PERSÖNLICHE EINLADUNG</span>
                    <span class="text-gray-500 text-[7px]">Datum: {new Date().toLocaleDateString('de-DE')}</span>
                  </div>
                  <h3 id="preview-subject" class="font-['Impact'] text-base uppercase text-[#111713] tracking-wide leading-tight">
                    DEIN NÄCHSTES ABENTEUER: {currentEvent.title}
                  </h3>
                </div>

                <!-- Body Text -->
                <div class="space-y-2 mb-4 text-[8px] text-gray-800 leading-normal">
                  <p id="preview-salutation" class="font-bold">
                    Lieber {initialRecipients[0]?.firstName || 'Abenteurer'}!
                  </p>
                  <p>
                    hast du Lust auf ein echtes Abenteuer? Raus in die Natur, Dreck an den Wanderschuhen, knisterndes Lagerfeuer und spannende Geländespiele mit anderen Jungs!
                  </p>
                  <p>
                    Wir von der SMJ Regio Wegweiser laden dich ganz herzlich zu unserer nächsten großen Aktion ein:
                  </p>
                </div>

                <!-- Fact Cards: 3 Boxen, 2-zeilig wie beim Plakat mit Icons -->
                <div class="grid grid-cols-3 gap-2.5 mb-3.5 font-mono">
                  <!-- WANN -->
                  <div class="bg-[#f7f5ed] border border-[#ded8c8] border-l-4 border-l-[#FF5A1F] p-2 rounded-xs">
                    <div class="flex items-center gap-1 text-[#FF5A1F] font-bold text-[7px] tracking-wider uppercase mb-0.5">
                      <Calendar class="w-2.5 h-2.5 text-[#FF5A1F] shrink-0" />
                      <span>WANN</span>
                    </div>
                    <div id="preview-fact-date-1" class="font-['Impact'] text-[11px] text-[#111713] leading-tight uppercase">{initDate1}</div>
                    <div id="preview-fact-date-2" class="text-[7.5px] text-gray-600 leading-tight uppercase mt-0.5 font-bold">{initDate2}</div>
                  </div>
                  <!-- WO -->
                  <div class="bg-[#f7f5ed] border border-[#ded8c8] border-l-4 border-l-[#FF5A1F] p-2 rounded-xs">
                    <div class="flex items-center gap-1 text-[#FF5A1F] font-bold text-[7px] tracking-wider uppercase mb-0.5">
                      <MapPin class="w-2.5 h-2.5 text-[#FF5A1F] shrink-0" />
                      <span>WO</span>
                    </div>
                    <div id="preview-fact-loc-1" class="font-['Impact'] text-[11px] text-[#111713] leading-tight uppercase truncate">{initLoc1}</div>
                    <div id="preview-fact-loc-2" class="text-[7.5px] text-gray-600 leading-tight uppercase mt-0.5 font-bold truncate">{initLoc2}</div>
                  </div>
                  <!-- WER -->
                  <div class="bg-[#f7f5ed] border border-[#ded8c8] border-l-4 border-l-[#FF5A1F] p-2 rounded-xs">
                    <div class="flex items-center gap-1 text-[#FF5A1F] font-bold text-[7px] tracking-wider uppercase mb-0.5">
                      <Users class="w-2.5 h-2.5 text-[#FF5A1F] shrink-0" />
                      <span>WER</span>
                    </div>
                    <div id="preview-fact-age-1" class="font-['Impact'] text-[11px] text-[#111713] leading-tight uppercase">{initAge1}</div>
                    <div id="preview-fact-age-2" class="text-[7.5px] text-gray-600 leading-tight uppercase mt-0.5 font-bold">{initAge2}</div>
                  </div>
                </div>

                <!-- QR Code Box -->
                <div class="bg-[#111713] text-[#F1EBDD] p-2 rounded-xs flex items-center justify-between border border-[#FF5A1F] mb-3">
                  <div class="pr-2">
                    <div class="font-['Impact'] text-[9px] text-[#FF5A1F] uppercase">JETZT ONLINE ANMELDEN:</div>
                    <div class="font-mono text-[6.5px] text-[#C9BA99] truncate">{currentEvent.registrationUrl.replace(/^https?:\/\//, '')}</div>
                    <div class="text-[6px] text-gray-400 mt-0.5">Scanne den QR-Code mit deinem Smartphone.</div>
                  </div>
                  <div class="bg-white p-0.5 rounded-xs shrink-0">
                    <QrCode class="w-8 h-8 text-black" />
                  </div>
                </div>

                <!-- Parent Info Note -->
                <div class="border-l-2 border-orange pl-2 py-0.5 mb-3 text-[6.5px] text-gray-600">
                  <strong class="text-black uppercase">// Wichtiger Hinweis für deine Eltern:</strong>
                  <div>Vollverpflegung, Betreuung und Packliste online abrufbar.</div>
                </div>

                <!-- Signature -->
                <div class="pt-1 text-[7.5px]">
                  <div>Wir freuen uns riesig auf dich!</div>
                  <div class="font-bold text-[#FF5A1F] uppercase mt-0.5">Dein Leitungsteam der SMJ Regio Wegweiser</div>
                </div>

              </div>

            </div>

            <!-- RIGHT: Controls -->
            <div class="space-y-6">
              
              <div class="border border-paper/20 bg-forest-950 p-6 rounded-xs space-y-4">
                <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-orange flex items-center gap-2">
                  <Users class="w-4 h-4" />
                  <span>Empfänger-Auswahl</span>
                </h3>

                <p class="font-mono text-xs text-paper/70">
                  Wähle einen Empfänger aus der Smartgruppe, um die personalisierte Anschrift im Brief zu testen:
                </p>

                <select
                  id="preview-recipient-select"
                  class="w-full bg-forest-900 border border-paper/20 text-paper font-mono text-xs p-2.5 rounded-xs focus:outline-none focus:border-orange cursor-pointer"
                >
                  {initialRecipients.map((r, i) => (
                    <option value={i}>
                      {r.displayName} ({r.address?.city || 'Heiligenstadt'})
                    </option>
                  ))}
                </select>

                <div class="pt-2 text-paper/60 font-mono text-[11px]">
                  &check; Druckfertiges DIN A4 mit genauer Falz- und Kuvertmarkierung.
                </div>
              </div>

            </div>

          </div>

        </div>

        <!-- ========================================== -->
        <!-- TAB PANEL 5: E-MAIL SAMMELNACHRICHT (HTML) -->
        <!-- ========================================== -->
        <div id="tab-panel-email" class="tab-panel hidden p-6 sm:p-8 space-y-8">
          
          <div class="border-b border-paper/15 pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h2 class="font-display text-2xl uppercase tracking-wide text-paper flex items-center gap-2">
                <Mail class="w-6 h-6 text-orange" />
                <span>E-Mail Sammelnachricht (HTML)</span>
              </h2>
              <p class="font-mono text-xs text-paper/60 mt-1">
                Optimierte E-Mail-Vorlage im SMJ-Abenteuer-Look. Wird als CiviMail-Entwurf angelegt.
              </p>
            </div>

            <div class="flex items-center gap-3">
              <button
                type="button"
                class="btn-trigger-email-draft px-5 py-2.5 bg-orange hover:bg-paper hover:text-forest-950 text-forest-950 font-mono text-xs font-bold uppercase tracking-wider rounded-xs transition-colors flex items-center gap-2 cursor-pointer shadow-lg"
              >
                <Send class="w-4 h-4" />
                <span>Als Entwurf in CiviCRM anlegen</span>
              </button>
            </div>
          </div>

          <!-- HTML Email Preview Window -->
          <div class="border-2 border-paper/20 rounded-xs overflow-hidden bg-forest-950 shadow-2xl">
            <div class="bg-forest-900 border-b border-paper/15 px-4 py-2 flex items-center justify-between font-mono text-xs">
              <span class="text-paper/60">Betreff: <strong class="text-paper font-normal">Einladung: {currentEvent.title} – SMJ Regio Wegweiser</strong></span>
              <span class="text-orange font-bold uppercase text-[10px]">HTML Mailing</span>
            </div>
            
            <div class="p-4 sm:p-8 bg-[#111713] flex justify-center">
              <div class="w-full max-w-[600px] bg-[#182019] border border-paper/15 rounded-xs overflow-hidden shadow-xl" set:html={initialEmailHtml}></div>
            </div>
          </div>

        </div>

        <!-- ========================================== -->
        <!-- TAB PANEL 6: SMS VORBEREITUNG -->
        <!-- ========================================== -->
        <div id="tab-panel-sms" class="tab-panel hidden p-6 sm:p-8 space-y-8">
          
          <div class="border-b border-paper/15 pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h2 class="font-display text-2xl uppercase tracking-wide text-paper flex items-center gap-2">
                <Send class="w-6 h-6 text-orange" />
                <span>SMS Kurznachricht</span>
              </h2>
              <p class="font-mono text-xs text-paper/60 mt-1">
                Kompakte Textnachricht mit Personalisierungs-Token für CiviCRM SMS.
              </p>
            </div>

            <div class="flex items-center gap-3">
              <button
                type="button"
                class="btn-trigger-sms-draft px-5 py-2.5 bg-orange hover:bg-paper hover:text-forest-950 text-forest-950 font-mono text-xs font-bold uppercase tracking-wider rounded-xs transition-colors flex items-center gap-2 cursor-pointer shadow-lg"
              >
                <Send class="w-4 h-4" />
                <span>Als SMS-Entwurf in CiviCRM anlegen</span>
              </button>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-8 items-start">
            
            <!-- SMS Editor -->
            <div class="space-y-4">
              <label for="sms-textarea" class="block font-mono text-xs uppercase font-bold text-orange">
                SMS Text mit Tokens
              </label>
              <textarea
                id="sms-textarea"
                rows="6"
                class="w-full bg-forest-950 border border-paper/20 p-4 font-mono text-sm text-paper rounded-xs focus:outline-none focus:border-orange leading-relaxed"
              >{initialSms}</textarea>

              <div class="flex items-center justify-between font-mono text-xs text-paper/60">
                <span>Zeichen: <strong id="sms-char-count" class="text-orange">{initialSmsObj.characterCount}</strong> / 160 ({initialSmsObj.segmentCount} SMS-Segment)</span>
                <span class="text-green-400">&check; GSM-7 kompatibel</span>
              </div>
            </div>

            <!-- Smartphone Mockup Preview -->
            <div class="bg-forest-950 border-2 border-paper/20 p-6 rounded-2xl max-w-[320px] mx-auto shadow-2xl">
              <div class="w-12 h-1 bg-paper/20 rounded-full mx-auto mb-4"></div>
              <div class="bg-forest-900 border border-paper/10 p-3 rounded-lg text-xs font-mono text-paper leading-relaxed">
                <div class="text-[9px] text-orange font-bold uppercase mb-1">SMJ Regio Wegweiser</div>
                <div id="phone-sms-preview">{initialSms}</div>
              </div>
            </div>

          </div>

        </div>

        <!-- ========================================== -->
        <!-- TAB PANEL 7: EMPFÄNGERLISTE -->
        <!-- ========================================== -->
        <div id="tab-panel-recipients" class="tab-panel hidden p-6 sm:p-8 space-y-6">
          
          <div class="border-b border-paper/15 pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h2 class="font-display text-2xl uppercase tracking-wide text-paper flex items-center gap-2">
                <Users class="w-6 h-6 text-orange" />
                <span>Empfänger der gewählten Gruppe</span>
              </h2>
              <p class="font-mono text-xs text-paper/60 mt-1">
                Alle Kontakte aus CiviCRM mit Post- und E-Mail-Bereitschaft.
              </p>
            </div>
          </div>

          <!-- Table -->
          <div class="border border-paper/20 rounded-xs overflow-x-auto bg-forest-950">
            <table class="w-full font-mono text-xs text-left">
              <thead class="bg-forest-900 text-orange uppercase tracking-wider text-[11px] border-b border-paper/15">
                <tr>
                  <th class="p-3">#</th>
                  <th class="p-3">Name</th>
                  <th class="p-3">Postanschrift</th>
                  <th class="p-3">E-Mail</th>
                  <th class="p-3">Alter</th>
                  <th class="p-3 text-right">Status</th>
                </tr>
              </thead>
              <tbody id="recipient-table-body" class="divide-y divide-paper/10 text-paper/80">
                {initialRecipients.map((r, i) => (
                  <tr class="hover:bg-forest-900/50 transition-colors">
                    <td class="p-3 text-paper/40">{i + 1}</td>
                    <td class="p-3 font-bold text-paper">{r.displayName}</td>
                    <td class="p-3">
                      {r.hasValidAddress && r.address ? (
                        <span>{r.address.street}, {r.address.postalCode} {r.address.city}</span>
                      ) : (
                        <span class="text-red-400">Keine Adresse</span>
                      )}
                    </td>
                    <td class="p-3">
                      {r.hasValidEmail && r.email ? (
                        <span class="text-blue-300">{r.email}</span>
                      ) : (
                        <span class="text-paper/40">&mdash;</span>
                      )}
                    </td>
                    <td class="p-3">{r.age ? `${r.age} Jahre` : (r.birthDate ? `${new Date().getFullYear() - new Date(r.birthDate).getFullYear()} Jahre` : '—')}</td>
                    <td class="p-3 text-right">
                      {r.hasValidAddress && (
                        <span class="inline-block px-1.5 py-0.5 bg-green-950 text-green-400 border border-green-800 text-[10px] rounded-xs font-bold mr-1">Post</span>
                      )}
                      {r.hasValidEmail && (
                        <span class="inline-block px-1.5 py-0.5 bg-blue-950 text-blue-400 border border-blue-800 text-[10px] rounded-xs font-bold">Mail</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

        </div>

      </div>

    </div>

  </main>

  <!-- ============================================================ -->
  <!-- ACCESSIBLE CIVICRM DRAFT RESULT MODAL DIALOG                 -->
  <!-- ============================================================ -->
  <dialog
    id="civi-dialog"
    class="backdrop:bg-forest-950/80 backdrop:backdrop-blur-xs bg-forest-900 border-2 border-orange text-paper p-0 rounded-xs shadow-2xl max-w-lg w-[92vw] m-auto"
  >
    <div class="p-6 space-y-5">
      
      <!-- Dialog Header -->
      <div class="flex items-start justify-between gap-4 border-b border-paper/15 pb-4">
        <div class="flex items-center gap-3">
          <div id="dialog-icon-container" class="p-2.5 rounded-xs bg-orange/20 border border-orange text-orange">
            <Loader id="dialog-spinner" class="w-6 h-6 animate-spin" />
            <CircleCheck id="dialog-check" class="w-6 h-6 text-green-400 hidden" />
            <CircleAlert id="dialog-error" class="w-6 h-6 text-red-400 hidden" />
          </div>
          <div>
            <h4 id="dialog-title" class="font-display text-xl uppercase tracking-wide text-paper">
              CiviCRM Entwurf
            </h4>
            <div id="dialog-subtitle" class="font-mono text-xs text-orange">
              Aktion wird vorbereitet...
            </div>
          </div>
        </div>

        <button
          type="button"
          id="dialog-btn-close-x"
          class="text-paper/50 hover:text-paper p-1 rounded-xs hover:bg-forest-950 transition-colors cursor-pointer"
          aria-label="Dialog schließen"
        >
          <X class="w-5 h-5" />
        </button>
      </div>

      <!-- Dialog Message Body -->
      <div id="dialog-body" class="font-mono text-xs sm:text-sm text-paper/80 leading-relaxed space-y-2">
        Entwurf wird über die CiviCRM APIv4 angelegt...
      </div>

      <!-- Details Summary Box -->
      <div id="dialog-details-box" class="bg-forest-950 border border-paper/15 p-3.5 rounded-xs font-mono text-xs space-y-1.5">
        <div class="flex items-center justify-between text-paper/60">
          <span>Zielgruppe:</span>
          <strong id="dialog-detail-group" class="text-paper">Smartgruppe 12</strong>
        </div>
        <div class="flex items-center justify-between text-paper/60">
          <span>Aktion:</span>
          <strong id="dialog-detail-event" class="text-orange truncate max-w-[240px]">{currentEvent.title}</strong>
        </div>
        <div id="dialog-detail-id-row" class="hidden flex items-center justify-between text-paper/60 border-t border-paper/10 pt-1.5">
          <span>CiviCRM Datensatz-ID:</span>
          <strong id="dialog-detail-id" class="text-green-400">#---</strong>
        </div>
      </div>

      <!-- Dialog Footer Buttons -->
      <div class="flex flex-wrap items-center justify-end gap-3 pt-2">
        <button
          type="button"
          id="dialog-btn-close"
          class="px-4 py-2 bg-forest-950 border border-paper/20 hover:border-paper/40 text-paper font-mono text-xs font-bold uppercase rounded-xs transition-colors cursor-pointer"
        >
          Schließen
        </button>

        <a
          id="dialog-btn-open-civi"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden items-center gap-1.5 px-4 py-2 bg-orange hover:bg-paper hover:text-forest-950 text-forest-950 font-mono text-xs font-bold uppercase tracking-wider rounded-xs transition-colors"
        >
          <ExternalLink class="w-4 h-4" />
          <span>In CiviCRM öffnen &nearr;</span>
        </a>
      </div>

    </div>
  </dialog>
</BaseLayout>

<script is:inline define:vars={{ clientData }}>
  let currentEvent = clientData.currentEvent
  let currentGroupId = Number(clientData.groups[0]?.id || 12)
  let currentRecipients = clientData.groupRecipientsMap[currentGroupId] || clientData.defaultRecipients
  let activeSocialFormat = 'story'
  let activeSocialTheme = 'dark'

  // Header Dropdown: Navigate to other event's campaign URL
  const headerEventSelect = document.getElementById('header-event-select')
  if (headerEventSelect) {
    headerEventSelect.addEventListener('change', (e) => {
      const selectedId = e.target.value
      window.location.href = `/toolbox/${selectedId}/kampagne/`
    })
  }

  // Social Studio Elements
  const socialPreviewImage = document.getElementById('social-preview-image')
  const socialPreviewWrapper = document.getElementById('social-preview-wrapper')
  const socialDimensionsLabel = document.getElementById('social-dimensions-label')
  const btnDownloadSocialPng = document.getElementById('btn-download-social-png')
  const socialFormatButtons = document.querySelectorAll('.social-format-btn')
  const socialThemeButtons = document.querySelectorAll('.social-theme-btn')
  const btnCopyCaption = document.getElementById('btn-copy-caption')
  const copyCaptionLabel = document.getElementById('copy-caption-label')
  const socialCaptionTextarea = document.getElementById('social-caption-textarea')

  function updateSocialPreview() {
    const imgUrl = `/toolbox/social-images/${currentEvent.id}-${activeSocialFormat}-${activeSocialTheme}.png`
    if (socialPreviewImage) socialPreviewImage.src = imgUrl
    if (btnDownloadSocialPng) {
      btnDownloadSocialPng.href = imgUrl
      btnDownloadSocialPng.download = `smj-${currentEvent.id}-${activeSocialFormat}-${activeSocialTheme}.png`
    }

    if (socialPreviewWrapper && socialDimensionsLabel) {
      if (activeSocialFormat === 'story') {
        socialPreviewWrapper.style.aspectRatio = '9 / 16'
        socialDimensionsLabel.textContent = '1080 × 1920 PX (INSTAGRAM STORY)'
      } else {
        socialPreviewWrapper.style.aspectRatio = '1 / 1'
        socialDimensionsLabel.textContent = '1080 × 1080 PX (INSTAGRAM FEED)'
      }
    }
  }

  socialFormatButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      socialFormatButtons.forEach((b) => {
        b.classList.remove('bg-orange', 'text-forest-950', 'active')
        b.classList.add('text-paper/70')
      })
      btn.classList.add('bg-orange', 'text-forest-950', 'active')
      btn.classList.remove('text-paper/70')
      activeSocialFormat = btn.dataset.format || 'story'
      updateSocialPreview()
    })
  })

  socialThemeButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      socialThemeButtons.forEach((b) => {
        b.classList.remove('border-orange', 'border-2', 'active')
        b.classList.add('border-paper/20')
      })
      btn.classList.add('border-orange', 'border-2', 'active')
      btn.classList.remove('border-paper/20')
      activeSocialTheme = btn.dataset.theme || 'dark'
      updateSocialPreview()
    })
  })

  if (btnCopyCaption && socialCaptionTextarea) {
    btnCopyCaption.addEventListener('click', () => {
      navigator.clipboard.writeText(socialCaptionTextarea.value)
      if (copyCaptionLabel) copyCaptionLabel.textContent = 'Kopiert! ✓'
      setTimeout(() => {
        if (copyCaptionLabel) copyCaptionLabel.textContent = 'Kopieren'
      }, 2500)
    })
  }

  // Letter Elements
  const previewAddrName = document.getElementById('preview-addr-name')
  const previewAddrStreet = document.getElementById('preview-addr-street')
  const previewAddrCity = document.getElementById('preview-addr-city')
  const previewSalutation = document.getElementById('preview-salutation')
  const previewRecipientIndex = document.getElementById('preview-recipient-index')
  const previewRecipientSelect = document.getElementById('preview-recipient-select')
  const btnPrevRecipient = document.getElementById('btn-prev-recipient')
  const btnNextRecipient = document.getElementById('btn-next-recipient')
  let currentRecipientIdx = 0

  function showRecipient(idx) {
    if (!currentRecipients || currentRecipients.length === 0) return
    currentRecipientIdx = (idx + currentRecipients.length) % currentRecipients.length
    const r = currentRecipients[currentRecipientIdx]

    const dispName = r.displayName || r.name || 'Abenteurer'
    const street = r.address?.street || r.street || 'Am Berg 12'
    const city = `${r.address?.postalCode || r.postalCode || '37308'} ${r.address?.city || r.city || 'Heilbad Heiligenstadt'}`

    if (previewAddrName) previewAddrName.textContent = dispName
    if (previewAddrStreet) previewAddrStreet.textContent = street
    if (previewAddrCity) previewAddrCity.textContent = city
    if (previewSalutation) previewSalutation.textContent = `Lieber ${r.firstName || 'Abenteurer'}!`
    if (previewRecipientIndex) previewRecipientIndex.textContent = `${currentRecipientIdx + 1} / ${currentRecipients.length}`
    if (previewRecipientSelect) previewRecipientSelect.value = String(currentRecipientIdx)
  }

  if (btnPrevRecipient) btnPrevRecipient.addEventListener('click', () => showRecipient(currentRecipientIdx - 1))
  if (btnNextRecipient) btnNextRecipient.addEventListener('click', () => showRecipient(currentRecipientIdx + 1))
  if (previewRecipientSelect) {
    previewRecipientSelect.addEventListener('change', (e) => showRecipient(Number(e.target.value)))
  }

  // CiviCRM Group Switcher
  const groupSelect = document.getElementById('group-select')
  const counterTotal = document.getElementById('counter-total')
  const counterPost = document.getElementById('counter-post')
  const counterEmail = document.getElementById('counter-email')
  const tabRecipientCount = document.getElementById('tab-recipient-count')
  const batchBtnLabel = document.getElementById('batch-btn-label')
  const recipientTableBody = document.getElementById('recipient-table-body')

  function updateRecipientsDisplay() {
    if (counterTotal) counterTotal.textContent = String(currentRecipients.length)
    if (counterPost) counterPost.textContent = String(currentRecipients.filter((r) => r.hasValidAddress).length)
    if (counterEmail) counterEmail.textContent = String(currentRecipients.filter((r) => r.hasValidEmail).length)
    if (tabRecipientCount) tabRecipientCount.textContent = String(currentRecipients.length)
    if (batchBtnLabel) batchBtnLabel.textContent = `Sammeldruck (${currentRecipients.length} Briefe)`

    if (previewRecipientSelect) {
      previewRecipientSelect.innerHTML = currentRecipients
        .map((r, i) => `<option value="${i}">${r.displayName || r.name} (${r.address?.city || r.city || 'Heiligenstadt'})</option>`)
        .join('')
    }
    showRecipient(0)

    if (recipientTableBody) {
      recipientTableBody.innerHTML = currentRecipients
        .map(
          (r, i) => `
        <tr class="hover:bg-forest-900/50 transition-colors">
          <td class="p-3 text-paper/40">${i + 1}</td>
          <td class="p-3 font-bold text-paper">${r.displayName || r.name}</td>
          <td class="p-3">${r.hasValidAddress ? `${r.address?.street || r.street}, ${r.address?.postalCode || r.postalCode} ${r.address?.city || r.city}` : '<span class="text-red-400">Keine Adresse</span>'}</td>
          <td class="p-3">${r.hasValidEmail ? `<span class="text-blue-300">${r.email}</span>` : '<span class="text-paper/40">&mdash;</span>'}</td>
          <td class="p-3">${r.age ? `${r.age} Jahre` : (r.birthDate ? `${new Date().getFullYear() - new Date(r.birthDate).getFullYear()} Jahre` : '—')}</td>
          <td class="p-3 text-right">
            ${r.hasValidAddress ? '<span class="inline-block px-1.5 py-0.5 bg-green-950 text-green-400 border border-green-800 text-[10px] rounded-xs font-bold mr-1">Post</span>' : ''}
            ${r.hasValidEmail ? '<span class="inline-block px-1.5 py-0.5 bg-blue-950 text-blue-400 border border-blue-800 text-[10px] rounded-xs font-bold">Mail</span>' : ''}
          </td>
        </tr>
      `,
        )
        .join('')
    }
  }

  async function fetchLiveGroupContacts(groupId) {
    try {
      const res = await fetch(`/toolbox-auth/civicrm-api.php?action=contacts&group_id=${groupId}`)
      if (!res.ok) return
      const data = await res.json()
      if (data && data.recipients) {
        currentRecipients = data.recipients
        updateRecipientsDisplay()
      }
    } catch (e) {
      console.warn('Could not fetch live contacts:', e)
    }
  }

  if (groupSelect) {
    groupSelect.addEventListener('change', (e) => {
      currentGroupId = Number(e.target.value)
      currentRecipients = clientData.groupRecipientsMap[currentGroupId] || clientData.defaultRecipients
      updateRecipientsDisplay()
      fetchLiveGroupContacts(currentGroupId)
    })
  }

  // Initial live sync for group contacts
  fetchLiveGroupContacts(currentGroupId)

  // Tab Switching
  const tabButtons = document.querySelectorAll('.tab-btn')
  const tabPanels = document.querySelectorAll('.tab-panel')

  function switchTab(targetId) {
    tabButtons.forEach((b) => {
      if (b.dataset.target === targetId) {
        b.classList.add('border-orange', 'text-orange', 'bg-forest-900/80', 'active')
        b.classList.remove('border-transparent', 'text-paper/60')
      } else {
        b.classList.remove('border-orange', 'text-orange', 'bg-forest-900/80', 'active')
        b.classList.add('border-transparent', 'text-paper/60')
      }
    })

    tabPanels.forEach((panel) => {
      if (panel.id === targetId) {
        panel.classList.remove('hidden')
      } else {
        panel.classList.add('hidden')
      }
    })
  }

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => switchTab(btn.dataset.target))
  })

  document.querySelectorAll('.quick-switch-tab').forEach((btn) => {
    btn.addEventListener('click', () => switchTab(btn.dataset.target))
  })

  // URL Hash or Param detection (e.g. ?tab=social)
  const urlParams = new URLSearchParams(window.location.search)
  const requestedTab = urlParams.get('tab')
  if (requestedTab) {
    const targetId = `tab-panel-${requestedTab}`
    if (document.getElementById(targetId)) switchTab(targetId)
  }

  // CiviCRM Draft Dialog & Actions
  const civiDialog = document.getElementById('civi-dialog')
  const dialogSpinner = document.getElementById('dialog-spinner')
  const dialogCheck = document.getElementById('dialog-check')
  const dialogError = document.getElementById('dialog-error')
  const dialogTitle = document.getElementById('dialog-title')
  const dialogSubtitle = document.getElementById('dialog-subtitle')
  const dialogBody = document.getElementById('dialog-body')
  const dialogDetailGroup = document.getElementById('dialog-detail-group')
  const dialogDetailEvent = document.getElementById('dialog-detail-event')
  const dialogDetailId = document.getElementById('dialog-detail-id')
  const dialogDetailIdRow = document.getElementById('dialog-detail-id-row')
  const dialogBtnClose = document.getElementById('dialog-btn-close')
  const dialogBtnCloseX = document.getElementById('dialog-btn-close-x')
  const dialogBtnOpenCivi = document.getElementById('dialog-btn-open-civi')
  const smsTextarea = document.getElementById('sms-textarea')

  if (civiDialog) {
    const closeDialog = () => civiDialog.close()
    if (dialogBtnClose) dialogBtnClose.addEventListener('click', closeDialog)
    if (dialogBtnCloseX) dialogBtnCloseX.addEventListener('click', closeDialog)
    civiDialog.addEventListener('click', (e) => {
      const rect = civiDialog.getBoundingClientRect()
      const isIn = rect.top <= e.clientY && e.clientY <= rect.top + rect.height && rect.left <= e.clientX && e.clientX <= rect.left + rect.width
      if (!isIn) civiDialog.close()
    })
  }

  function openDialogLoading(actionTitle) {
    if (!civiDialog) return
    if (dialogSpinner) dialogSpinner.classList.remove('hidden')
    if (dialogCheck) dialogCheck.classList.add('hidden')
    if (dialogError) dialogError.classList.add('hidden')
    if (dialogTitle) dialogTitle.textContent = `${actionTitle} wird vorbereitet...`
    if (dialogSubtitle) dialogSubtitle.textContent = 'Verbindung mit CiviCRM APIv4 wird hergestellt'
    if (dialogBody) dialogBody.innerHTML = 'Bitte einen Moment Geduld &mdash; Entwurf wird in CiviCRM angelegt.'
    if (dialogDetailIdRow) dialogDetailIdRow.classList.add('hidden')
    if (dialogBtnOpenCivi) dialogBtnOpenCivi.classList.add('hidden')
    civiDialog.showModal()
  }

  function updateDialogSuccess(title, html, civiId, civiUrl) {
    if (dialogSpinner) dialogSpinner.classList.add('hidden')
    if (dialogCheck) dialogCheck.classList.remove('hidden')
    if (dialogError) dialogError.classList.add('hidden')
    if (dialogTitle) dialogTitle.textContent = title
    if (dialogSubtitle) dialogSubtitle.textContent = 'Erfolgreich in CiviCRM gespeichert'
    if (dialogBody) dialogBody.innerHTML = html
    if (civiId && dialogDetailIdRow && dialogDetailId) {
      dialogDetailId.textContent = `#${civiId}`
      dialogDetailIdRow.classList.remove('hidden')
    }
    if (civiUrl && dialogBtnOpenCivi) {
      dialogBtnOpenCivi.href = civiUrl
      dialogBtnOpenCivi.classList.remove('hidden')
      dialogBtnOpenCivi.classList.add('inline-flex')
    }
  }

  function updateDialogError(title, errorMsg, fallbackUrl) {
    if (dialogSpinner) dialogSpinner.classList.add('hidden')
    if (dialogCheck) dialogCheck.classList.add('hidden')
    if (dialogError) dialogError.classList.remove('hidden')
    if (dialogTitle) dialogTitle.textContent = title
    if (dialogSubtitle) dialogSubtitle.textContent = 'CiviCRM Rückmeldung'
    if (dialogBody) dialogBody.innerHTML = `<span class="text-red-400 font-bold">Fehler aufgetreten:</span><br>${errorMsg}`
    if (fallbackUrl && dialogBtnOpenCivi) {
      dialogBtnOpenCivi.href = fallbackUrl
      dialogBtnOpenCivi.classList.remove('hidden')
      dialogBtnOpenCivi.classList.add('inline-flex')
    }
  }

  async function triggerCiviDraft(type) {
    const isEmail = type === 'email'
    const actionTitle = isEmail ? 'E-Mail-Mailing' : 'SMS-Aktivität'
    const groupName = clientData.groups.find((g) => g.id === currentGroupId)?.title || 'Smartgruppe'

    if (dialogDetailGroup) dialogDetailGroup.textContent = groupName
    if (dialogDetailEvent) dialogDetailEvent.textContent = currentEvent.title

    openDialogLoading(actionTitle)

    const payload = isEmail
      ? {
          type: 'email',
          campaignName: `${currentEvent.title} (Einladung)`,
          subject: `Einladung: ${currentEvent.title} – SMJ Regio Wegweiser`,
          bodyHtml: clientData.defaultEmailHtml,
          groupId: currentGroupId,
        }
      : {
          type: 'sms',
          campaignName: currentEvent.title,
          text: smsTextarea ? smsTextarea.value : '',
          groupId: currentGroupId,
        }

    try {
      const res = await fetch('/toolbox-auth/civicrm-api.php?action=draft', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
      const result = await res.json()
      if (result.success) {
        const msg = isEmail
          ? `Der Mailing-Entwurf für <strong>${currentEvent.title}</strong> wurde in CiviCRM angelegt!<br><br>Zielgruppe: <strong>${groupName}</strong> (${currentRecipients.length} Kontakte).`
          : `Die SMS-Aktivität für <strong>${currentEvent.title}</strong> wurde vorbereitet!`
        updateDialogSuccess(`${actionTitle} erstellt!`, msg, result.civicrmId, result.civiUrl || 'https://civicrm.regiowegweiser.de')
      } else {
        updateDialogError('Fehler beim Anlegen', result.message || 'CiviCRM Fehler.', 'https://civicrm.regiowegweiser.de')
      }
    } catch (e) {
      updateDialogError('Netzwerk- oder Serverfehler', e.message || 'CiviCRM Verbindung fehlgeschlagen.', 'https://civicrm.regiowegweiser.de')
    }
  }

  document.querySelectorAll('.btn-trigger-email-draft').forEach((btn) => {
    btn.addEventListener('click', () => triggerCiviDraft('email'))
  })
  document.querySelectorAll('.btn-trigger-sms-draft').forEach((btn) => {
    btn.addEventListener('click', () => triggerCiviDraft('sms'))
  })
</script>
