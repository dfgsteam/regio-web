        <div id="tab-panel-showcase" class="tab-panel p-6 sm:p-8 space-y-8">
          
          <div class="border-b border-paper/15 pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h2 class="font-display text-2xl uppercase tracking-wide text-paper flex items-center gap-2">
