                </div>
              </div>

              <div class="space-y-2 pt-2 border-t border-paper/10 font-mono text-xs">
                <button
                  type="button"
                  class="w-full quick-switch-tab px-3 py-2 bg-forest-900 hover:bg-forest-800 text-paper font-bold uppercase rounded-xs border border-paper/20 flex items-center justify-center gap-1.5 cursor-pointer"
                  data-target="tab-panel-social"
                >
                  <SlidersHorizontal class="w-3.5 h-3.5 text-orange" />
                  <span>Im Studio anpassen &rarr;</span>
                </button>
                <a
                  href={`/toolbox/social-images/${currentEvent.id}-story-dark.png`}
                  download={`smj-${currentEvent.id}-story.png`}
                  class="w-full inline-flex items-center justify-center gap-1.5 px-3 py-2 bg-orange text-forest-950 font-bold uppercase rounded-xs hover:bg-paper transition-colors"
                >
                  <Download class="w-3.5 h-3.5" />
                  <span>Story herunterladen</span>
                </a>
              </div>
            </div>

            <!-- Card 2: A4 Plakat / Flyer -->
            <div class="border-2 border-paper/20 bg-forest-950 p-5 rounded-xs flex flex-col justify-between hover:border-orange transition-all shadow-md group">
              <div>
                <div class="flex items-center justify-between mb-3 font-mono text-[10px] text-paper/60 uppercase">
                  <span class="text-orange font-bold flex items-center gap-1">
                    <FileText class="w-3.5 h-3.5" />
                    <span>Druck / Aushang</span>
                  </span>
                  <span>DIN A4 PDF</span>
                </div>

                <h3 class="font-display text-xl uppercase tracking-wide text-paper mb-1">
                  A4 Plakat &amp; Flyer
                </h3>
                <p class="font-mono text-xs text-paper/60 mb-4">
                  Druckfertig mit Schnittmarken, QR-Code und Abreiß-Informationen.
                </p>

                <!-- Thumbnail -->
                <div class="bg-paper text-forest-950 p-3 rounded-xs border-2 border-paper/40 mb-4 font-mono text-[7px] leading-tight select-none">
                  <div class="flex items-center justify-between border-b border-forest-950/20 pb-1 mb-1.5">
                    <span class="font-bold text-[8px] uppercase">SMJ Wegweiser</span>
                    <span class="text-orange font-bold">A4</span>
                  </div>
                  <div class="font-display text-[10px] uppercase truncate">{currentEvent.title}</div>
                  <div class="text-gray-700 truncate">{currentEvent.dateStr} &bull; {currentEvent.locationStr}</div>
                  <div class="mt-2 pt-1 border-t border-forest-950/15 flex items-center justify-between">
                    <span class="text-orange font-bold">QR-Code Anmeldung</span>
                    <QrCode class="w-3.5 h-3.5 text-forest-950" />
                  </div>
                </div>
              </div>

              <div class="space-y-2 pt-2 border-t border-paper/10 font-mono text-xs">
                <button
