---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import ToolboxHeader from '../../../components/navigation/ToolboxHeader.astro'
import {
  Download,
  Copy,
  Smartphone,
  ExternalLink,
  MessageSquare,
  FileText,
  Compass,
} from '@lucide/astro'
import { eventProvider, formatDateRange, formatAgeRange } from '../../../lib/events'
import { getAllCamps } from '../../../lib/camps'
import { buildSchedulePresets } from '../../../lib/pdf/schedule-pdf'
import { QR_BASE_URL } from '../../../lib/qr-url'

const [events, camps] = await Promise.all([eventProvider.getEvents(), getAllCamps()])
const presets = buildSchedulePresets(events, camps)

const scheduleData = {
  allEvents: [
    ...camps.map((c) => ({
      id: `camp-${c.data.year}`,
      title: `${c.data.title}${c.data.motto ? ` – ${c.data.motto}` : ''}`,
      start: c.data.date.start.toISOString(),
      end: c.data.date.end.toISOString(),
      dateStr: formatDateRange(c.data.date.start, c.data.date.end),
      location: c.data.location?.name || 'Wiesental bei Thalwenden',
      ageGroup: formatAgeRange(c.data.age?.min, c.data.age?.max) || '9–14 Jahre',
      category: 'camp',
    })),
    ...events.map((e) => ({
      id: `event-${e.slug}`,
      title: e.title,
      start: e.start.toISOString(),
      end: e.end.toISOString(),
      dateStr: formatDateRange(e.start, e.end),
      location: e.location || 'Klause 2.0, Heiligenstadt',
      ageGroup: formatAgeRange(e.ageMin, e.ageMax) || undefined,
      category: e.category || 'event',
    })),
  ].sort((a, b) => new Date(a.start).getTime() - new Date(b.start).getTime()),
  presets,
}
---

<BaseLayout
  title="Terminkarte & Sammel-Übersicht – Leiter-Toolbox"
  description="Erstelle A6-Taschenkalender (PDF), Multi-Slide Instagram-Karussells und WhatsApp-Terminlisten für beliebige Zeiträume."
  noIndex={true}
>
  <ToolboxHeader currentTitle="Terminkarte" backHref="/toolbox/" backLabel="Zurück zur Toolbox" activeNav="terminkarte" />

  <main class="bg-forest-950 py-8 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto space-y-8">
      
      <!-- Top Title & Overview Header -->
      <div class="border-b border-paper/15 pb-6">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-widest text-orange mb-1">
              <Compass class="h-4 w-4" />
              <span>TERMIN-SAMMLUNG &amp; JAHRESVORSCHAU</span>
            </div>
            <h1 class="display text-3xl sm:text-4xl text-paper uppercase">
              Terminkarte &amp; Sammel-Flyer
            </h1>
            <p class="mt-1 font-sans text-sm text-paper/70 max-w-2xl">
              Generiere für einen beliebigen Zeitraum fertige Terminkarten im kompakten <strong>DIN A6 Postkartenformat (mehrseitiges PDF)</strong>, 
              als <strong>Multi-Slide Instagram-Karussell</strong> oder als strukturierte <strong>WhatsApp-Sammelnachricht</strong> mit direktem Kalender-Link.
            </p>
          </div>

          <div class="border border-paper/20 bg-forest-900/60 p-3 rounded-xs text-right hidden sm:block">
            <span class="block font-mono text-[0.65rem] uppercase text-paper/50">Direktes Kalender-Abo</span>
            <span class="block font-mono text-xs text-orange font-bold">{QR_BASE_URL.replace(/^https?:\/\//, '')}/api/calendar.ics</span>
          </div>
        </div>

        <!-- Period Selector Toolbar -->
        <div class="mt-6 pt-5 border-t border-paper/10 flex flex-wrap items-center justify-between gap-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-mono text-xs text-paper/60 uppercase font-bold mr-1">Zeitraum wählen:</span>
            <button
              type="button"
              class="period-preset-btn active px-3 py-1.5 font-mono text-xs font-bold uppercase tracking-wider transition-all border-2 border-orange bg-orange text-forest-950 cursor-pointer rounded-xs"
              data-preset="terminkarte"
            >
              Nächste 6 Monate
            </button>
            <button
              type="button"
              class="period-preset-btn px-3 py-1.5 font-mono text-xs font-bold uppercase tracking-wider transition-all border border-paper/20 text-paper/80 hover:border-paper hover:text-paper cursor-pointer rounded-xs bg-forest-900/60"
              data-preset="terminkarte-2026"
            >
              Ganzes Jahr 2026
            </button>
            <button
              type="button"
              class="period-preset-btn px-3 py-1.5 font-mono text-xs font-bold uppercase tracking-wider transition-all border border-paper/20 text-paper/80 hover:border-paper hover:text-paper cursor-pointer rounded-xs bg-forest-900/60"
              data-preset="terminkarte-h1-2026"
            >
              1. Halbjahr 2026
            </button>
            <button
              type="button"
              class="period-preset-btn px-3 py-1.5 font-mono text-xs font-bold uppercase tracking-wider transition-all border border-paper/20 text-paper/80 hover:border-paper hover:text-paper cursor-pointer rounded-xs bg-forest-900/60"
              data-preset="terminkarte-h2-2026"
            >
              2. Halbjahr 2026
            </button>
            <button
              type="button"
              class="period-preset-btn px-3 py-1.5 font-mono text-xs font-bold uppercase tracking-wider transition-all border border-paper/20 text-paper/80 hover:border-paper hover:text-paper cursor-pointer rounded-xs bg-forest-900/60"
              data-preset="terminkarte-2027"
            >
              Jahr 2027
            </button>
          </div>

          <div class="font-mono text-xs text-paper/60">
            <span id="period-events-count" class="font-bold text-orange">6</span> Termine im Zeitraum
          </div>
        </div>
      </div>

      <!-- Main Studio Tabs: 1. A6 PDF, 2. Instagram, 3. WhatsApp -->
      <div>
        <div class="flex border-b-2 border-paper/20 mb-6">
          <button
            type="button"
            class="tab-btn active px-5 py-3 font-mono text-xs font-bold uppercase tracking-wider text-orange border-b-2 border-orange -mb-[2px] cursor-pointer flex items-center gap-2"
            data-tab="pdf"
          >
            <FileText class="h-4 w-4" />
            <span>DIN A6 Taschenkarte (PDF)</span>
          </button>
          <button
            type="button"
            class="tab-btn px-5 py-3 font-mono text-xs font-bold uppercase tracking-wider text-paper/60 hover:text-paper border-b-2 border-transparent -mb-[2px] cursor-pointer flex items-center gap-2"
            data-tab="social"
          >
            <Smartphone class="h-4 w-4" />
            <span>Instagram Karussell &amp; Story</span>
          </button>
          <button
            type="button"
            class="tab-btn px-5 py-3 font-mono text-xs font-bold uppercase tracking-wider text-paper/60 hover:text-paper border-b-2 border-transparent -mb-[2px] cursor-pointer flex items-center gap-2"
            data-tab="whatsapp"
          >
            <MessageSquare class="h-4 w-4" />
            <span>WhatsApp Text-Vorlage</span>
          </button>
        </div>

        <!-- TAB 1: DIN A6 PDF POCKET CARD -->
        <div id="tab-content-pdf" class="tab-pane space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-4 bg-forest-900/60 p-4 border border-paper/20 rounded-xs">
            <div>
              <h3 class="font-display text-lg text-paper uppercase">Kompakte DIN A6 Taschenkarte (105 × 148 mm)</h3>
              <p class="font-sans text-xs text-paper/70">
                Optimiert als Handzettel zum Verteilen, für Schaukästen oder als Beilage im Brief. 
                Erzeugt bei vielen Terminen automatisch gleichmäßig verteilte Folgeseiten.
              </p>
            </div>
            
            <div class="flex flex-wrap items-center gap-3">
              <!-- A6 Theme Toggle -->
              <div class="flex items-center gap-1.5 bg-forest-950 p-1 border border-paper/20 rounded-xs">
                <span class="font-mono text-[0.65rem] text-paper/60 uppercase px-1">Design:</span>
                <button
                  type="button"
                  class="a6-theme-btn active px-2.5 py-1 font-mono text-[0.65rem] font-bold uppercase border-2 border-orange bg-orange text-forest-950 cursor-pointer rounded-xs transition-all"
                  data-theme="light"
                >
                  Hell (Druck)
                </button>
                <button
                  type="button"
                  class="a6-theme-btn px-2.5 py-1 font-mono text-[0.65rem] font-bold uppercase border border-paper/20 text-paper/80 hover:border-paper cursor-pointer rounded-xs bg-forest-900/60 transition-all"
                  data-theme="dark"
                >
                  Dunkel
                </button>
              </div>

              <a
                id="client-pdf-open-btn"
                href="/toolbox/flyers/terminkarte.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 border-2 border-orange bg-orange px-4 py-2 font-mono text-xs font-bold uppercase tracking-wider text-forest-950 hover:bg-paper hover:border-paper transition-all cursor-pointer shadow-md"
              >
                <FileText class="h-4 w-4" />
                <span>PDF öffnen (.pdf) ↗</span>
              </a>
              <a
                id="client-pdf-btn"
                href="/toolbox/flyers/terminkarte.pdf"
                download="terminkarte.pdf"
                class="inline-flex items-center gap-1.5 border border-paper/30 bg-forest-900 px-3 py-2 font-mono text-xs uppercase tracking-wider text-paper/80 hover:border-orange hover:text-orange transition-all cursor-pointer"
              >
                <Download class="h-3.5 w-3.5" />
                <span>Download</span>
              </a>
            </div>
          </div>

          <!-- A6 Visual Preview Container: Embedded Pre-rendered PDF -->
          <div class="flex flex-col items-center justify-center p-4 sm:p-8 bg-forest-900/40 border border-paper/10 rounded-sm">
            <div class="w-full max-w-[700px] flex items-center justify-between font-mono text-xs text-paper/50 mb-3 px-1">
              <span class="flex items-center gap-1.5 text-orange font-bold">
                <span class="inline-block w-2 h-2 rounded-full bg-orange animate-pulse"></span>
                VORGERENDERTE PDF (ORIGINAL DRUCKDATEI)
              </span>
              <span>DIN A6 (105 × 148 MM)</span>
            </div>
            <iframe
              id="a6-pdf-preview-frame"
              src="/toolbox/flyers/terminkarte.pdf#toolbar=0"
              class="w-full max-w-[700px] h-[550px] sm:h-[750px] rounded-xs border-2 border-paper/20 shadow-2xl bg-paper"
              title="DIN A6 Taschenkarte PDF Vorschau"
            ></iframe>
          </div>
        </div>

        <!-- TAB 2: INSTAGRAM KARUSSELL & STORY -->
        <div id="tab-content-social" class="tab-pane hidden space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-4 bg-forest-900/60 p-4 border border-paper/20 rounded-xs">
            <div>
              <h3 class="font-display text-lg text-paper uppercase">Multi-Slide Instagram Karussell &amp; Story</h3>
              <p class="font-sans text-xs text-paper/70">
                Teile den Terminplan als mehrteiliges Karussell auf Instagram oder als Story mit Link-Sticker.
              </p>
            </div>

            <div class="flex flex-wrap items-center gap-3">
              <!-- Design Theme Switcher -->
              <div class="flex items-center gap-1.5 bg-forest-950 p-1 border border-paper/20 rounded-xs">
                <span class="font-mono text-[0.65rem] text-paper/60 uppercase px-1">Design:</span>
                <button
                  type="button"
                  class="social-theme-btn active px-2.5 py-1 font-mono text-[0.65rem] font-bold uppercase border-2 border-orange bg-orange text-forest-950 cursor-pointer rounded-xs transition-all"
                  data-theme="light"
                >
                  Hell (Papier)
                </button>
                <button
                  type="button"
                  class="social-theme-btn px-2.5 py-1 font-mono text-[0.65rem] font-bold uppercase border border-paper/20 text-paper/80 hover:border-paper cursor-pointer rounded-xs bg-forest-900/60 transition-all"
                  data-theme="dark"
                >
                  Dunkel
                </button>
              </div>

              <!-- Format Toggle -->
              <div class="flex items-center gap-1.5 bg-forest-950 p-1 border border-paper/20 rounded-xs">
                <span class="font-mono text-[0.65rem] text-paper/60 uppercase px-1">Format:</span>
                <button
                  type="button"
                  class="social-format-btn active px-2.5 py-1 font-mono text-[0.65rem] font-bold uppercase border-2 border-orange bg-orange text-forest-950 cursor-pointer rounded-xs transition-all"
                  data-format="post"
                >
                  Post 1:1
                </button>
                <button
                  type="button"
                  class="social-format-btn px-2.5 py-1 font-mono text-[0.65rem] font-bold uppercase border border-paper/20 text-paper/80 hover:border-paper cursor-pointer rounded-xs bg-forest-900/60 transition-all"
                  data-format="story"
                >
                  Story 9:16
                </button>
              </div>
            </div>
          </div>

          <!-- Carousel Slides Grid: Displaying pre-rendered PNGs -->
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            
            <!-- Slide 1 Card -->
            <div id="slide-card-0" class="border border-paper/20 bg-forest-900/80 p-4 rounded-xs space-y-3">
              <div class="flex items-center justify-between border-b border-paper/10 pb-2">
                <span id="slide-title-0" class="font-mono text-xs font-bold uppercase text-orange">Slide 1 &bull; Termine</span>
                <a
                  id="slide-download-0"
                  href="/toolbox/social-images/terminkarte-slide-0-post-dark.png"
                  download="smj-terminkarte-slide-1-post-dark.png"
                  class="inline-flex items-center gap-1 font-mono text-[0.65rem] text-paper/80 hover:text-orange cursor-pointer border border-paper/20 px-2 py-1 bg-forest-950 transition-colors"
                >
                  <Download class="h-3 w-3" />
                  <span>Download .PNG</span>
                </a>
              </div>
              <div class="aspect-square bg-forest-950 border border-paper/20 p-2 flex items-center justify-center overflow-hidden">
                <img
                  id="slide-img-0"
                  src="/toolbox/social-images/terminkarte-slide-0-post-dark.png"
                  alt="Slide 1"
                  class="w-full h-full object-contain select-none"
                  loading="lazy"
                />
              </div>
            </div>

            <!-- Slide 2 Card -->
            <div id="slide-card-1" class="border border-paper/20 bg-forest-900/80 p-4 rounded-xs space-y-3">
              <div class="flex items-center justify-between border-b border-paper/10 pb-2">
                <span id="slide-title-1" class="font-mono text-xs font-bold uppercase text-orange">Slide 2 &bull; Termine Teil 2</span>
                <a
                  id="slide-download-1"
                  href="/toolbox/social-images/terminkarte-slide-1-post-dark.png"
                  download="smj-terminkarte-slide-2-post-dark.png"
                  class="inline-flex items-center gap-1 font-mono text-[0.65rem] text-paper/80 hover:text-orange cursor-pointer border border-paper/20 px-2 py-1 bg-forest-950 transition-colors"
                >
                  <Download class="h-3 w-3" />
                  <span>Download .PNG</span>
                </a>
              </div>
              <div class="aspect-square bg-forest-950 border border-paper/20 p-2 flex items-center justify-center overflow-hidden">
                <img
                  id="slide-img-1"
                  src="/toolbox/social-images/terminkarte-slide-1-post-dark.png"
                  alt="Slide 2"
                  class="w-full h-full object-contain select-none"
                  loading="lazy"
                />
              </div>
            </div>

            <!-- Slide 3 / Final Card -->
            <div id="slide-card-2" class="border border-paper/20 bg-forest-900/80 p-4 rounded-xs space-y-3">
              <div class="flex items-center justify-between border-b border-paper/10 pb-2">
                <span id="slide-title-2" class="font-mono text-xs font-bold uppercase text-orange">Slide 3 &bull; Abschluss &amp; QR</span>
                <a
                  id="slide-download-2"
                  href="/toolbox/social-images/terminkarte-slide-2-post-dark.png"
                  download="smj-terminkarte-slide-3-post-dark.png"
                  class="inline-flex items-center gap-1 font-mono text-[0.65rem] text-paper/80 hover:text-orange cursor-pointer border border-paper/20 px-2 py-1 bg-forest-950 transition-colors"
                >
                  <Download class="h-3 w-3" />
                  <span>Download .PNG</span>
                </a>
              </div>
              <div class="aspect-square bg-forest-950 border border-paper/20 p-2 flex items-center justify-center overflow-hidden">
                <img
                  id="slide-img-2"
                  src="/toolbox/social-images/terminkarte-slide-2-post-dark.png"
                  alt="Slide 3"
                  class="w-full h-full object-contain select-none"
                  loading="lazy"
                />
              </div>
            </div>

          </div>

          <!-- Instagram Caption Copy Box -->
          <div class="border border-paper/20 bg-forest-900/60 p-4 rounded-xs space-y-2">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-bold uppercase text-orange">Passende Instagram Caption (Beitragstext):</span>
              <button
                type="button"
                id="copy-caption-btn"
                class="inline-flex items-center gap-1 font-mono text-xs border border-orange px-3 py-1 bg-orange/10 text-orange hover:bg-orange hover:text-forest-950 cursor-pointer transition-colors"
              >
                <Copy class="h-3.5 w-3.5" />
                <span id="copy-caption-text">Caption kopieren</span>
              </button>
            </div>
            <textarea
              id="instagram-caption-area"
              rows="5"
              readonly
              class="w-full bg-forest-950 border border-paper/20 p-3 font-mono text-xs text-paper/90 rounded-xs focus:outline-none select-all"
            ></textarea>
          </div>
        </div>

        <!-- TAB 3: WHATSAPP TEXT TEMPLATE -->
        <div id="tab-content-whatsapp" class="tab-pane hidden space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-4 bg-forest-900/60 p-4 border border-paper/20 rounded-xs">
            <div>
              <h3 class="font-display text-lg text-paper uppercase">WhatsApp-Sammelnachricht</h3>
              <p class="font-sans text-xs text-paper/70">
                Fertig formatierte Nachricht mit Emojis für WhatsApp-Gruppen, Elternverteiler und Status-Updates.
              </p>
            </div>
            <div class="flex items-center gap-3">
              <button
                type="button"
                id="copy-whatsapp-btn"
                class="inline-flex items-center gap-1.5 border-2 border-orange bg-orange px-4 py-2 font-mono text-xs font-bold uppercase tracking-wider text-forest-950 hover:bg-paper hover:border-paper transition-all cursor-pointer shadow-md"
              >
                <Copy class="h-4 w-4" />
                <span id="copy-whatsapp-text">Nachricht kopieren</span>
              </button>
              <a
                id="share-whatsapp-btn"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 border border-paper/30 bg-forest-900 px-3 py-2 font-mono text-xs uppercase tracking-wider text-paper/80 hover:border-orange hover:text-orange transition-all cursor-pointer"
              >
                <ExternalLink class="h-3.5 w-3.5 text-orange" />
                <span>In WhatsApp öffnen</span>
              </a>
            </div>
          </div>

          <!-- Message Text Area -->
          <div class="border border-paper/20 bg-forest-900/40 p-4 sm:p-6 rounded-xs">
            <textarea
              id="whatsapp-text-area"
              rows="16"
              readonly
              class="w-full bg-forest-950 border border-paper/20 p-4 font-mono text-xs text-paper/90 rounded-xs focus:outline-none select-all leading-relaxed"
            ></textarea>
          </div>
        </div>

      </div>

    </div>
  </main>
</BaseLayout>

<script is:inline define:vars={{ scheduleData, qrBaseUrl: QR_BASE_URL }}>
  const allEvents = scheduleData.allEvents || []
  const presets = scheduleData.presets || {}

  let activePresetKey = 'terminkarte'
  let activeSocialFormat = 'post'
  let activeSocialTheme = 'light'
  let activeA6Theme = 'light'

  // Tab switching
  const tabBtns = document.querySelectorAll('.tab-btn')
  const tabPanes = document.querySelectorAll('.tab-pane')

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetTab = btn.getAttribute('data-tab')
      tabBtns.forEach((b) => {
        b.classList.remove('active', 'text-orange', 'border-orange')
        b.classList.add('text-paper/60', 'border-transparent')
      })
      btn.classList.add('active', 'text-orange', 'border-orange')
      btn.classList.remove('text-paper/60', 'border-transparent')

      tabPanes.forEach((pane) => pane.classList.add('hidden'))
      const activePane = document.getElementById('tab-content-' + targetTab)
      if (activePane) activePane.classList.remove('hidden')
    })
  })

  // Preset switching
  const presetBtns = document.querySelectorAll('.period-preset-btn')
  presetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      presetBtns.forEach((b) => {
        b.classList.remove('active', 'border-2', 'border-orange', 'bg-orange', 'text-forest-950')
        b.classList.add('border', 'border-paper/20', 'text-paper/80')
      })
      btn.classList.add('active', 'border-2', 'border-orange', 'bg-orange', 'text-forest-950')
      btn.classList.remove('border', 'border-paper/20', 'text-paper/80')

      activePresetKey = btn.getAttribute('data-preset') || 'terminkarte'
      updateStudioUI()
    })
  })

  // Theme switching for A6
  const a6ThemeBtns = document.querySelectorAll('.a6-theme-btn')
  a6ThemeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      a6ThemeBtns.forEach((b) => {
        b.classList.remove('active', 'border-2', 'border-orange', 'bg-orange', 'text-forest-950')
        b.classList.add('border', 'border-paper/20', 'text-paper/80')
      })
      btn.classList.add('active', 'border-2', 'border-orange', 'bg-orange', 'text-forest-950')
      btn.classList.remove('border', 'border-paper/20', 'text-paper/80')

      activeA6Theme = btn.getAttribute('data-theme') || 'light'
      updateA6Pdf()
    })
  })

  // Theme switching for Social
  const socialThemeBtns = document.querySelectorAll('.social-theme-btn')
  socialThemeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      socialThemeBtns.forEach((b) => {
        b.classList.remove('active', 'border-2', 'border-orange', 'bg-orange', 'text-forest-950')
        b.classList.add('border', 'border-paper/20', 'text-paper/80')
      })
      btn.classList.add('active', 'border-2', 'border-orange', 'bg-orange', 'text-forest-950')
      btn.classList.remove('border', 'border-paper/20', 'text-paper/80')

      activeSocialTheme = btn.getAttribute('data-theme') || 'dark'
      updateSocialSlides()
    })
  })

  // Format switching for Social
  const formatBtns = document.querySelectorAll('.social-format-btn')
  formatBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      formatBtns.forEach((b) => {
        b.classList.remove('active', 'border-2', 'border-orange', 'bg-orange', 'text-forest-950')
        b.classList.add('border', 'border-paper/20', 'text-paper/80')
      })
      btn.classList.add('active', 'border-2', 'border-orange', 'bg-orange', 'text-forest-950')
      btn.classList.remove('border', 'border-paper/20', 'text-paper/80')

      activeSocialFormat = btn.getAttribute('data-format') || 'post'
      updateSocialSlides()
    })
  })

  function getActivePresetData() {
    return (
      presets[activePresetKey] || {
        id: activePresetKey,
        periodTitle: 'Kommende Termine',
        periodSubtitle: 'Die nächsten Monate im Überblick',
        events: allEvents.slice(0, 6),
        targetUrl: qrBaseUrl + '/abenteuer/',
      }
    )
  }

  function updateA6Pdf() {
    const isDark = activeA6Theme === 'dark'
    const pdfKey = isDark ? activePresetKey + '-dark' : activePresetKey
    const pdfUrl = '/toolbox/flyers/' + pdfKey + '.pdf'

    const frame = document.getElementById('a6-pdf-preview-frame')
    if (frame) frame.src = pdfUrl + '#toolbar=0'

    const openBtn = document.getElementById('client-pdf-open-btn')
    if (openBtn) openBtn.href = pdfUrl

    const dlBtn = document.getElementById('client-pdf-btn')
    if (dlBtn) {
      dlBtn.href = pdfUrl
      dlBtn.download = pdfKey + '.pdf'
    }
  }

  function updateSocialSlides() {
    const data = getActivePresetData()
    const eventsList = data.events || []
    const totalSlides = eventsList.length <= 4 ? 2 : 3

    const card2 = document.getElementById('slide-card-2')
    const title0 = document.getElementById('slide-title-0')
    const title1 = document.getElementById('slide-title-1')
    const title2 = document.getElementById('slide-title-2')

    const img0 = document.getElementById('slide-img-0')
    const dl0 = document.getElementById('slide-download-0')
    const img1 = document.getElementById('slide-img-1')
    const dl1 = document.getElementById('slide-download-1')
    const img2 = document.getElementById('slide-img-2')
    const dl2 = document.getElementById('slide-download-2')

    const src0 = '/toolbox/social-images/' + activePresetKey + '-slide-0-' + activeSocialFormat + '-' + activeSocialTheme + '.png'
    const src1 = '/toolbox/social-images/' + activePresetKey + '-slide-1-' + activeSocialFormat + '-' + activeSocialTheme + '.png'
    const src2 = '/toolbox/social-images/' + activePresetKey + '-slide-2-' + activeSocialFormat + '-' + activeSocialTheme + '.png'

    if (img0) img0.src = src0
    if (dl0) {
      dl0.href = src0
      dl0.download = 'smj-' + activePresetKey + '-slide-1-' + activeSocialFormat + '-' + activeSocialTheme + '.png'
    }

    if (img1) img1.src = src1
    if (dl1) {
      dl1.href = src1
      dl1.download = 'smj-' + activePresetKey + '-slide-2-' + activeSocialFormat + '-' + activeSocialTheme + '.png'
    }

    if (totalSlides === 2) {
      if (title0) title0.textContent = 'Slide 1 · Termine'
      if (title1) title1.textContent = 'Slide 2 · Anmeldung & QR'
      if (card2) card2.classList.add('hidden')
    } else {
      if (title0) title0.textContent = 'Slide 1 · Termine (Teil 1)'
      if (title1) title1.textContent = 'Slide 2 · Termine (Teil 2)'
      if (title2) title2.textContent = 'Slide 3 · Abschluss & QR'
      if (card2) card2.classList.remove('hidden')

      if (img2) img2.src = src2
      if (dl2) {
        dl2.href = src2
        dl2.download = 'smj-' + activePresetKey + '-slide-3-' + activeSocialFormat + '-' + activeSocialTheme + '.png'
      }
    }
  }

  function updateStudioUI() {
    const data = getActivePresetData()
    const eventsList = data.events || []

    const countEl = document.getElementById('period-events-count')
    if (countEl) countEl.textContent = String(eventsList.length)

    updateA6Pdf()
    updateSocialSlides()
    updateWhatsAppTemplate(data)
    updateInstagramCaption(data)
  }

  function updateWhatsAppTemplate(data) {
    const eventsList = data.events || []
    const lines = [
      '🏕️ *TERMINE DER SMJ REGIO WEGWEISER*',
      '_Raus. Ins Abenteuer._',
      '',
      'Hier ist die aktuelle Terminübersicht für *' + data.periodTitle + '*:',
      '',
    ]

    for (const ev of eventsList) {
      const isCamp = ev.category === 'camp' || ev.title.toLowerCase().includes('zeltlager')
      const icon = isCamp ? '⛺' : '🔥'
      lines.push(icon + ' *' + ev.title + '*')
      lines.push('📅 ' + ev.dateStr)
      if (ev.location) lines.push('📍 ' + ev.location)
      if (ev.ageGroup) lines.push('👥 ' + ev.ageGroup)
      lines.push('')
    }

    lines.push('📲 *Alle Infos, Packlisten & Online-Anmeldung:*')
    lines.push('👉 ' + qrBaseUrl + '/abenteuer/')
    lines.push('')
    lines.push('📅 *Kalender abonnieren (Google / Apple / Outlook):*')
    lines.push('👉 ' + qrBaseUrl + '/api/calendar.ics')

    const fullText = lines.join('\n')
    const textarea = document.getElementById('whatsapp-text-area')
    if (textarea) textarea.value = fullText

    const shareBtn = document.getElementById('share-whatsapp-btn')
    if (shareBtn) {
      shareBtn.href = 'https://api.whatsapp.com/send?text=' + encodeURIComponent(fullText)
    }
  }

  function updateInstagramCaption(data) {
    const eventsList = data.events || []
    const lines = [
      'RAUS. INS ABENTEUER. 🏕️🔥',
      '',
      'Hier sind alle Termine & Aktionen für ' + data.periodTitle + ':',
      '',
    ]

    for (const ev of eventsList) {
      lines.push('• ' + ev.dateStr + ': ' + ev.title)
    }

    lines.push('')
    lines.push('👉 Alle Infos, Packlisten und die Online-Anmeldung findest du über den Link in unserer Bio oder unter ' + qrBaseUrl.replace(/^https?:\/\//, '') + '/abenteuer/!')
    lines.push('')
    lines.push('#smjwegweiser #zeltlager #abenteuer #jugend #draussen #schoenstatt #jugendleiter #outdoor #thueringen #eichsfeld')

    const captionArea = document.getElementById('instagram-caption-area')
    if (captionArea) captionArea.value = lines.join('\n')
  }

  // Copy buttons
  const copyWaBtn = document.getElementById('copy-whatsapp-btn')
  if (copyWaBtn) {
    copyWaBtn.addEventListener('click', () => {
      const textarea = document.getElementById('whatsapp-text-area')
      if (textarea) {
        navigator.clipboard.writeText(textarea.value)
        const textSpan = document.getElementById('copy-whatsapp-text')
        if (textSpan) textSpan.textContent = 'Kopiert! ✓'
        setTimeout(() => {
          if (textSpan) textSpan.textContent = 'Nachricht kopieren'
        }, 2500)
      }
    })
  }

  const copyCapBtn = document.getElementById('copy-caption-btn')
  if (copyCapBtn) {
    copyCapBtn.addEventListener('click', () => {
      const captionArea = document.getElementById('instagram-caption-area')
      if (captionArea) {
        navigator.clipboard.writeText(captionArea.value)
        const textSpan = document.getElementById('copy-caption-text')
        if (textSpan) textSpan.textContent = 'Kopiert! ✓'
        setTimeout(() => {
          if (textSpan) textSpan.textContent = 'Caption kopieren'
        }, 2500)
      }
    })
  }

  // Initial load
  updateStudioUI()
</script>
