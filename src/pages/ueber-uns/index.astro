---
import ContentLayout from '../../layouts/ContentLayout.astro'
import Container from '../../components/common/Container.astro'
import Eyebrow from '../../components/common/Eyebrow.astro'
import ImageFrame from '../../components/common/ImageFrame.astro'
import FieldNote from '../../components/common/FieldNote.astro'
import Coordinates from '../../components/common/Coordinates.astro'
import { getCurrentCamp } from '../../lib/camps'

const currentCamp = await getCurrentCamp()

const chapters = [
  {
    title: 'Was ist die SMJ?',
    body: 'Die Schönstatt-Mannesjugend ist ein katholischer Jugendverband. Wir treffen uns regelmäßig, fahren ins Zeltlager, machen Wochenenden und wachsen dabei als Menschen. Ohne Perfektion, aber mit Herz.',
  },
  {
    title: 'Regio Wegweiser',
    body: 'Die Regio Wegweiser ist unsere Region: eine Gruppe von Jungs, Familien und Leitern rund um Heiligenstadt und Thalwenden. Wir sind Teil eines größeren Ganzen – und treten trotzdem als eigenes Team auf.',
  },
  {
    title: 'Schönstatt',
    body: 'Unser Hintergrund ist die Schönstatt-Bewegung: eine geistliche Erneuerungsbewegung, die vor über hundert Jahren entstanden ist. Bei uns heißt das konkret: Glaube ist nichts für die Sonntage allein, sondern gehört zum Lagerleben, zur Freundschaft, zum Alltag dazu.',
  },
  {
    title: 'Jugend leitet Jugend',
    body: 'Unsere Leiter sind oft nicht viel älter als die Teilnehmer. Sie übernehmen Verantwortung, lernen an echten Aufgaben und werden dabei von erfahrenen Erwachsenen begleitet. Wer bei uns mitmacht, darf früher selbst Verantwortung tragen – nicht später.',
  },
  {
    title: 'Wo wir herkommen',
    body: 'Die SMJ gibt es seit Jahrzehnten. Aus kleinen Gruppen sind Zeltlager, Wochenenden und ein Netzwerk aus Freundschaften gewachsen. Unsere Geschichte ist kein Museum – sie ist das Fundament, auf dem jedes neue Lager steht.',
  },
]
---

<ContentLayout
  title="Über uns – SMJ Regio Wegweiser"
  description="Was ist die SMJ? Regio Wegweiser, Schönstatt, Jugend leitet Jugend: wer wir sind, woraus wir kommen und wie unsere Jugendarbeit funktioniert."
>
  <section class="texture-paper relative bg-paper pb-24 pt-40 text-forest-950">
    <Container>
      <Eyebrow label="Über uns" muted />
      <h1 class="display display-xl mt-6 text-forest-950">
        Wer wir sind.<br />
        <span class="text-orange">Warum wir das machen.</span>
      </h1>
    </Container>
  </section>

  <section class="bg-forest-950 py-20">
    <Container class="grid items-start gap-16 lg:grid-cols-[1fr_1.1fr]">
      <div class="relative">
        <ImageFrame src="/placeholders/group.svg" alt="Platzhalterbild – Gruppe der Regio Wegweiser" ratio="16:10" />
        <FieldNote meta="FIELD NOTE 01 · UNTERWEGS" rotate="-2deg" class="absolute -bottom-10 -right-2 hidden sm:block">
          Manche nennen es Gruppe. Wir nennen es zu Hause.
        </FieldNote>
      </div>
      <div class="pt-6">
        <Eyebrow label="Der erste Satz" />
        <p class="mt-6 font-display text-3xl uppercase leading-tight text-paper sm:text-4xl">
          Wir sind ein Jugendverband.<br />
          Aber zuerst sind wir eine Gruppe, in der man dazugehört – ganz einfach, weil man da ist.
        </p>
        <p class="mt-8 max-w-xl leading-relaxed text-paper/75">
          Jungs von 9 bis 14 finden bei uns ein Programm aus Abenteuer, Gemeinschaft und echten Aufgaben. Eltern finden eine verlässliche Gruppe mit klaren Werten. Und alle zusammen finden: Geschichten, die man nicht vergisst.
        </p>
        <p class="mono-label mt-8">Gegründet aus der Schönstatt-Bewegung · Getragen von der Region</p>
      </div>
    </Container>
  </section>

  <section id="history-chapters-section" class="relative bg-forest-900 py-20 overflow-hidden">
    <!-- Topographic trail line on desktop -->
    <div class="pointer-events-none absolute left-8 top-32 bottom-24 hidden w-0.5 bg-paper/10 sm:left-12 lg:block">
      <div class="history-trail-progress h-full w-full origin-top bg-gradient-to-b from-orange via-ember to-orange"></div>
    </div>

    <Container>
      <Eyebrow label="Kapitel für Kapitel" />
      <div class="mt-12 space-y-14">
        {chapters.map((chapter, index) => (
          <article class="history-chapter-article grid gap-6 border-t border-paper/15 pt-8 lg:grid-cols-[80px_1fr_1.2fr]">
            <span class="history-marker inline-flex h-10 w-10 items-center justify-center border border-orange/40 bg-forest-950 font-mono text-sm font-bold text-orange">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h2 class="history-title display display-md text-paper">{chapter.title}</h2>
            <p class="history-text max-w-xl leading-relaxed text-paper/75">{chapter.body}</p>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <section class="bg-forest-950 py-20 border-t border-paper/10">
    <Container>
      <Eyebrow label="Verband & Bewegung" />
      <h2 class="display display-md mt-3 text-paper">
        Teil eines weltweiten <span class="text-orange">Netzwerks.</span>
      </h2>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-paper/75">
        Die Regio Wegweiser ist regional im Eichsfeld und der Diözese Erfurt verwurzelt – und gleichzeitig Teil der bundesweiten Schönstatt-Mannesjugend und der internationalen Schönstatt-Bewegung.
      </p>

      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        <a
          href="https://www.smj-deutschland.de/"
          target="_blank"
          rel="noopener noreferrer"
          class="group border-2 border-paper/15 bg-forest-900 p-8 transition-colors hover:border-orange"
        >
          <p class="eyebrow mb-2 text-xs">Bundesebene</p>
          <div class="flex items-center justify-between">
            <h3 class="display text-2xl text-paper transition-colors group-hover:text-orange">
              SMJ Deutschland
            </h3>
            <span class="font-mono text-xs text-paper/50 transition-colors group-hover:text-orange">↗</span>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-paper/75">
            Die bundesweite Schönstatt-Mannesjugend mit allen Diözesen, Aktionen, Leiterschulungen und Projekten.
          </p>
        </a>

        <a
          href="https://www.schoenstatt.de/de/"
          target="_blank"
          rel="noopener noreferrer"
          class="group border-2 border-paper/15 bg-forest-900 p-8 transition-colors hover:border-orange"
        >
          <p class="eyebrow mb-2 text-xs">Geistliche Bewegung</p>
          <div class="flex items-center justify-between">
            <h3 class="display text-2xl text-paper transition-colors group-hover:text-orange">
              Schönstatt Deutschland
            </h3>
            <span class="font-mono text-xs text-paper/50 transition-colors group-hover:text-orange">↗</span>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-paper/75">
            Die weltweite katholische Erneuerungsbewegung, ihre Zentren, Heiligtümer, Gemeinschaften und Angebote.
          </p>
        </a>
      </div>
    </Container>
  </section>

  <!-- Social Media Community CTA -->
  <section class="bg-forest-900 py-20 border-t border-paper/10">
    <Container>
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <Eyebrow label="Social Media · Community" />
          <h2 class="display display-md mt-3 text-paper">
            Folge den Wegweisern <span class="text-orange">online.</span>
          </h2>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-paper/75">
          Echte Eindrücke, Storys von unterwegs und Rückblicke unserer Aktionen – folge uns auf unseren Kanälen:
        </p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        <a
          href="https://www.instagram.com/regio.wegweiser/"
          target="_blank"
          rel="noopener noreferrer"
          class="group border-2 border-paper/15 bg-forest-950 p-6 transition-all hover:border-orange hover:bg-forest-950/80"
        >
          <div class="flex items-center justify-between text-orange">
            <svg viewBox="0 0 24 24" class="h-6 w-6 fill-none stroke-current stroke-2 stroke-linecap-round stroke-linejoin-round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            <span class="font-mono text-xs text-paper/50 transition-colors group-hover:text-orange">↗</span>
          </div>
          <h3 class="display text-xl text-paper mt-4 transition-colors group-hover:text-orange">Instagram</h3>
          <p class="font-mono text-xs text-orange mt-0.5">@regio.wegweiser</p>
          <p class="mt-3 text-xs leading-relaxed text-paper/70">
            Fotos, Storys & Live-Eindrücke direkt aus dem Zeltlager und von Gruppenleiter-Aktionen.
          </p>
          <span class="mono-label mt-6 block text-[0.68rem] text-paper/50 transition-colors group-hover:text-paper">
            Profil ansehen →
          </span>
        </a>

        <a
          href="https://www.facebook.com/regiowegweiser"
          target="_blank"
          rel="noopener noreferrer"
          class="group border-2 border-paper/15 bg-forest-950 p-6 transition-all hover:border-orange hover:bg-forest-950/80"
        >
          <div class="flex items-center justify-between text-orange">
            <svg viewBox="0 0 24 24" class="h-6 w-6 fill-none stroke-current stroke-2 stroke-linecap-round stroke-linejoin-round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            <span class="font-mono text-xs text-paper/50 transition-colors group-hover:text-orange">↗</span>
          </div>
          <h3 class="display text-xl text-paper mt-4 transition-colors group-hover:text-orange">Facebook</h3>
          <p class="font-mono text-xs text-orange mt-0.5">SMJ Regio Wegweiser</p>
          <p class="mt-3 text-xs leading-relaxed text-paper/70">
            Termine, Ankündigungen und Infos für Eltern, Freunde & die ganze Wegweiser-Familie.
          </p>
          <span class="mono-label mt-6 block text-[0.68rem] text-paper/50 transition-colors group-hover:text-paper">
            Seite ansehen →
          </span>
        </a>

        <a
          href="https://www.youtube.com/channel/UC1BbR9tT5hsZzEzPXbJ7pFw"
          target="_blank"
          rel="noopener noreferrer"
          class="group border-2 border-paper/15 bg-forest-950 p-6 transition-all hover:border-orange hover:bg-forest-950/80"
        >
          <div class="flex items-center justify-between text-orange">
            <svg viewBox="0 0 24 24" class="h-6 w-6 fill-none stroke-current stroke-2 stroke-linecap-round stroke-linejoin-round"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><polygon points="10 15 15 12 10 9 10 15" fill="currentColor"/></svg>
            <span class="font-mono text-xs text-paper/50 transition-colors group-hover:text-orange">↗</span>
          </div>
          <h3 class="display text-xl text-paper mt-4 transition-colors group-hover:text-orange">YouTube</h3>
          <p class="font-mono text-xs text-orange mt-0.5">SMJ Wegweiser</p>
          <p class="mt-3 text-xs leading-relaxed text-paper/70">
            Lagerfilme, Rückblicke und Dokumentationen unserer vergangenen Sommerzeltlager.
          </p>
          <span class="mono-label mt-6 block text-[0.68rem] text-paper/50 transition-colors group-hover:text-paper">
            Kanal ansehen →
          </span>
        </a>
      </div>
    </Container>
  </section>

  {currentCamp && (
    <section class="bg-forest-950 py-20 border-t border-paper/10">
      <Container class="flex flex-wrap items-center justify-between gap-8">
        <div>
          <Eyebrow label="Der beste Beweis" />
          <h2 class="display display-md mt-5 text-paper">
            Komm ins <span class="text-orange">Zeltlager {currentCamp.data.year}</span>.
          </h2>
        </div>
        <a
          href="/abenteuer/zeltlager/"
          class="border-b-2 border-orange pb-1 font-mono text-xs font-bold uppercase tracking-[0.2em] text-paper transition-colors hover:text-orange"
        >
          Zeltlager {currentCamp.data.year} →
        </a>
      </Container>
    </section>
  )}

  <section class="bg-forest-950 pb-24 pt-4">
    <Container class="flex justify-center">
      <Coordinates value="REGIO WEGWEISER · N 51° 22' 04.8 · E 10° 06' 55.6" />
    </Container>
  </section>
</ContentLayout>

<script>
  import '../../scripts/animations/history-trail'
</script>
