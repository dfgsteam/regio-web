---
import ContentLayout from '../../layouts/ContentLayout.astro'
import Container from '../../components/common/Container.astro'
import Eyebrow from '../../components/common/Eyebrow.astro'
import Coordinates from '../../components/common/Coordinates.astro'
import LeafletMap from '../../components/common/LeafletMap.astro'
import BrandIcon from '../../components/common/BrandIcon.astro'
---

<ContentLayout
  title="Kontakt – SMJ Regio Wegweiser"
  description="Du hast Fragen? Melde dich. Die zentrale Anlaufstelle der SMJ Regio Wegweiser für Teilnehmer, Eltern und Interessierte."
>
  <section class="texture-paper relative bg-paper pb-24 pt-40 text-forest-950">
    <Container>
      <Eyebrow label="Kontakt" muted />
      <h1 class="display display-xl mt-6 text-forest-950">
        Du hast Fragen?<br />
        <span class="text-orange">Melde dich.</span>
      </h1>
    </Container>
  </section>

  <section class="bg-forest-950 py-20">
    <Container class="grid gap-16 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <h2 class="display display-md text-paper">Nachricht schreiben</h2>
        <p class="mono-label mt-4">Antwort in der Regel innerhalb weniger Tage.</p>

        <form id="contact-form" action="/api/contact.php" method="POST" class="mt-10 grid gap-6" novalidate>
          <div class="grid gap-6 sm:grid-cols-2">
            <label class="block">
              <span class="mono-label">Name</span>
              <input
                type="text"
                name="name"
                required
                minlength="2"
                maxlength="120"
                autocomplete="name"
                class="mt-2 w-full border-2 border-paper/20 bg-forest-900 px-4 py-3 font-mono text-sm text-paper placeholder:text-muted focus:border-orange focus:outline-none"
                placeholder="Dein Name"
              />
              <span class="form-error mono-label mt-1 hidden text-orange"></span>
            </label>
            <label class="block">
              <span class="mono-label">E-Mail</span>
              <input
                type="email"
                name="email"
                required
                autocomplete="email"
                class="mt-2 w-full border-2 border-paper/20 bg-forest-900 px-4 py-3 font-mono text-sm text-paper placeholder:text-muted focus:border-orange focus:outline-none"
                placeholder="name@beispiel.de"
              />
              <span class="form-error mono-label mt-1 hidden text-orange"></span>
            </label>
          </div>

          <label class="block">
            <span class="mono-label">Nachricht</span>
            <textarea
              name="message"
              required
              minlength="10"
              maxlength="4000"
              rows="7"
              class="mt-2 w-full resize-y border-2 border-paper/20 bg-forest-900 px-4 py-3 font-mono text-sm text-paper placeholder:text-muted focus:border-orange focus:outline-none"
              placeholder="Worum geht's?"
            ></textarea>
            <span class="form-error mono-label mt-1 hidden text-orange"></span>
          </label>

          <div class="hidden" aria-hidden="true">
            <label>
              Website (bitte leer lassen)
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <div class="flex flex-wrap items-center gap-6">
            <button
              type="submit"
              class="inline-flex items-center gap-2.5 bg-orange px-8 py-4 font-mono text-sm font-bold uppercase tracking-[0.18em] text-forest-950 transition-colors hover:bg-paper disabled:opacity-50"
            >
              Senden
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </button>
            <p id="form-status" class="mono-label" role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>

      <aside class="h-fit border border-paper/15 bg-forest-900 p-8 lg:sticky lg:top-28">
        <h2 class="display display-sm text-paper">Direkter Draht</h2>
        <p class="mt-2 text-xs leading-relaxed text-paper/70">
          Schreib uns über das Formular oder erreich uns direkt per E-Mail.
        </p>

        <div class="space-y-4 border-t border-paper/15 pt-6">
            <div>
              <p class="mono-label text-[0.65rem] text-muted">E-Mail</p>
              <a
                href="mailto:kontakt@smj-wegweiser.de"
                class="mono-label mt-1 block text-sm font-bold text-orange hover:underline"
              >
                kontakt@smj-wegweiser.de
              </a>
            </div>

            <div>
              <p class="mono-label text-[0.65rem] text-muted">Zeltlager-Team</p>
              <a
                href="mailto:zeltlager@smj-wegweiser.de"
                class="mono-label mt-1 block text-sm font-bold text-orange hover:underline"
              >
                zeltlager@smj-wegweiser.de
              </a>
            </div>
          </div>

          <div class="border-t border-paper/15 pt-6">
            <h4 class="mono-label text-xs uppercase tracking-wider text-paper">Standorte</h4>
            <ul class="mt-4 space-y-4 text-xs leading-relaxed text-paper/70">
              <li>
                <strong class="text-paper">Klause Heiligenstadt</strong><br />
                <p class="mt-0.5 text-paper/60">
                  Pater-Kentenich-Weg 3<br />
                  37308 Heilbad Heiligenstadt
                </p>
              </li>
              <li>
                <strong class="text-paper">Zeltplatz Wiesenthal</strong><br />
                <p class="mt-0.5 text-paper/60">
                  Birkenfelder Str.<br />
                  37318 Uder (Ortsteil Thalwenden)
                </p>
              </li>
            </ul>
            <div class="mt-8 border-t border-paper/15 pt-6">
              <p class="mono-label mb-3">Social Media & Kanäle</p>
              <div class="mt-4 space-y-3">
                <a
                  href="https://www.whatsapp.com/channel/0029VaQxDPOF6smxyB2t4519"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center justify-between border-2 border-green-500/40 bg-forest-950 p-3.5 text-sm text-paper transition-all hover:border-green-500 hover:bg-forest-900 shadow-md"
                >
                  <div class="flex items-center gap-3">
                    <BrandIcon name="whatsapp" class="h-5 w-5 fill-current text-green-500 transition-transform group-hover:scale-110" />
                    <div>
                      <span class="font-mono text-xs font-bold text-paper block">WhatsApp-Kanal</span>
                      <span class="font-mono text-[0.62rem] text-green-400 block">Offizielle Updates & Termine</span>
                    </div>
                  </div>
                  <span class="font-mono text-[0.65rem] font-bold uppercase text-green-400">Beitreten ↗</span>
                </a>

                <a
                  href="https://www.instagram.com/regio.wegweiser/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center justify-between border border-paper/20 bg-forest-950/60 p-3 text-sm text-paper transition-all hover:border-orange hover:bg-forest-950"
                >
                  <div class="flex items-center gap-3">
                    <BrandIcon name="instagram" class="h-4 w-4 fill-current text-orange transition-transform group-hover:scale-110" />
                    <span class="font-mono text-xs text-paper/90">@regio.wegweiser</span>
                  </div>
                  <span class="font-mono text-[0.65rem] uppercase text-orange">Instagram →</span>
                </a>

                <a
                  href="https://www.youtube.com/channel/UC1BbR9tT5hsZzEzPXbJ7pFw"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center justify-between border border-paper/20 bg-forest-950/60 p-3 text-sm text-paper transition-all hover:border-orange hover:bg-forest-950"
                >
                  <div class="flex items-center gap-3">
                    <BrandIcon name="youtube" class="h-4 w-4 fill-current text-orange transition-transform group-hover:scale-110" />
                    <span class="font-mono text-xs text-paper/90">SMJ Regio Wegweiser</span>
                  </div>
                  <span class="font-mono text-[0.65rem] uppercase text-orange">YouTube →</span>
                </a>

                <a
                  href="https://www.facebook.com/regiowegweiser"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center justify-between border border-paper/20 bg-forest-950/60 p-3 text-sm text-paper transition-all hover:border-orange hover:bg-forest-950"
                >
                  <div class="flex items-center gap-3">
                    <BrandIcon name="facebook" class="h-4 w-4 fill-current text-orange transition-transform group-hover:scale-110" />
                    <span class="font-mono text-xs text-paper/90">/regiowegweiser</span>
                  </div>
                  <span class="font-mono text-[0.65rem] uppercase text-orange">Facebook →</span>
                </a>
              </div>
            </div>      </div>

        <div class="mt-6 border-t border-paper/15 pt-6">
          <Coordinates value="WIESENTAL · N 51° 22' 04.8 · E 10° 06' 55.6" />
        </div>
      </aside>
    </Container>
  </section>

  <!-- Standorte & Karte Section -->
  <section class="border-t border-paper/10 bg-forest-900 py-20">
    <Container>
      <div class="grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:items-center">
        <div>
          <Eyebrow label="Standorte & Anfahrt" />
          <h2 class="display display-md mt-4 text-paper">
            Wo du uns<br />
            <span class="text-orange">findest.</span>
          </h2>

          <div class="mt-8 space-y-6">
            <div class="border-l-2 border-paper/30 pl-5">
              <p class="mono-label text-xs text-orange">01 · Allgemeine Postadresse & Zentrum</p>
              <h3 class="display text-xl text-paper mt-1">Pater-Kentenich-Weg 3</h3>
              <p class="text-sm text-paper/75 mt-0.5">37308 Heilbad Heiligenstadt</p>
              <p class="text-xs text-paper/60 mt-2">
                Zentraler Treffpunkt für Leiterrunden, Wochenenden und Organisation im Kleinen Paradies.
              </p>
            </div>

            <div class="border-l-2 border-orange pl-5">
              <p class="mono-label text-xs text-orange">02 · Zeltlagerplatz Wiesental</p>
              <h3 class="display text-xl text-paper mt-1">Birkenfelder Str.</h3>
              <p class="text-sm text-paper/75 mt-0.5">37318 Uder-Thalwenden</p>
              <p class="text-xs text-paper/60 mt-2">
                Der traditionelle Lagerplatz für das Sommerzeltlager im Wiesental unter den Sandsteinfelsen.
              </p>
            </div>
          </div>
        </div>

        <LeafletMap
          title="Zeltlagerplatz Wiesental"
          address="Birkenfelder Str., 37318 Uder (Ortsteil Thalwenden)"
          coordinates="N 51° 22' 04.8'' · E 10° 06' 55.6''"
          lat={51.35949}
          lng={10.03952}
          zoom={14}
          ratio="4/3"
        />
      </div>
    </Container>
  </section>

  <!-- Social Media & Kanäle Section -->
  <section class="border-t border-paper/10 bg-forest-950 py-20">
    <Container>
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <div>
          <Eyebrow label="Social Media & Community" />
          <h2 class="display display-md mt-4 text-paper">
            Folge uns<br />
            <span class="text-orange">im Netz.</span>
          </h2>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-paper/70 font-mono">
          Aktuelle Storys vom Zeltplatz, Rückblick-Videos, kurzfristige Ankündigungen und Einblicke hinter die Kulissen.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <!-- Instagram Card -->
        <a
          href="https://www.instagram.com/regio.wegweiser/"
          target="_blank"
          rel="noopener noreferrer"
          class="group relative flex flex-col justify-between border-2 border-paper/15 bg-forest-900 p-6 sm:p-8 transition-all duration-300 hover:border-orange hover:-translate-y-1 hover:shadow-xl hover:shadow-orange/5"
        >
          <div>
            <div class="flex items-center justify-between">
              <div class="grid h-12 w-12 place-items-center border border-paper/20 bg-forest-950 text-orange transition-colors group-hover:border-orange group-hover:bg-orange group-hover:text-forest-950">
                <svg viewBox="0 0 24 24" class="h-6 w-6 fill-none stroke-current stroke-2">
                  <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                  <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
                </svg>
              </div>
              <span class="font-mono text-[0.65rem] uppercase tracking-wider text-paper/50 group-hover:text-orange">
                Instagram ↗
              </span>
            </div>
            <h3 class="display text-2xl text-paper mt-6 group-hover:text-orange transition-colors">
              @regio.wegweiser
            </h3>
            <p class="mt-3 text-xs leading-relaxed text-paper/70">
              Storys aus dem Lager, Foto-Galerien von Wochenenden, Reels und spontane Updates.
            </p>
          </div>
          <div class="mt-6 border-t border-paper/10 pt-4 flex items-center justify-between">
            <span class="font-mono text-[0.65rem] uppercase text-muted">Kanal beitreten</span>
            <span class="font-mono text-xs text-orange font-bold">Abonnieren →</span>
          </div>
        </a>

        <!-- YouTube Card -->
        <a
          href="https://www.youtube.com/channel/UC1BbR9tT5hsZzEzPXbJ7pFw"
          target="_blank"
          rel="noopener noreferrer"
          class="group relative flex flex-col justify-between border-2 border-paper/15 bg-forest-900 p-6 sm:p-8 transition-all duration-300 hover:border-orange hover:-translate-y-1 hover:shadow-xl hover:shadow-orange/5"
        >
          <div>
            <div class="flex items-center justify-between">
              <div class="grid h-12 w-12 place-items-center border border-paper/20 bg-forest-950 text-orange transition-colors group-hover:border-orange group-hover:bg-orange group-hover:text-forest-950">
                <svg viewBox="0 0 24 24" class="h-6 w-6 fill-none stroke-current stroke-2">
                  <path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/>
                  <polygon points="10 15 15 12 10 9 10 15" fill="currentColor"/>
                </svg>
              </div>
              <span class="font-mono text-[0.65rem] uppercase tracking-wider text-paper/50 group-hover:text-orange">
                YouTube ↗
              </span>
            </div>
            <h3 class="display text-2xl text-paper mt-6 group-hover:text-orange transition-colors">
              SMJ Regio Wegweiser
            </h3>
            <p class="mt-3 text-xs leading-relaxed text-paper/70">
              Lagerfilme, epische Zeltlager-Trailer, Lagersong-Mitschnitte und Dokumentationen.
            </p>
          </div>
          <div class="mt-6 border-t border-paper/10 pt-4 flex items-center justify-between">
            <span class="font-mono text-[0.65rem] uppercase text-muted">Videos ansehen</span>
            <span class="font-mono text-xs text-orange font-bold">Kanal öffnen →</span>
          </div>
        </a>

        <!-- Facebook Card -->
        <a
          href="https://www.facebook.com/regiowegweiser"
          target="_blank"
          rel="noopener noreferrer"
          class="group relative flex flex-col justify-between border-2 border-paper/15 bg-forest-900 p-6 sm:p-8 transition-all duration-300 hover:border-orange hover:-translate-y-1 hover:shadow-xl hover:shadow-orange/5 sm:col-span-2 lg:col-span-1"
        >
          <div>
            <div class="flex items-center justify-between">
              <div class="grid h-12 w-12 place-items-center border border-paper/20 bg-forest-950 text-orange transition-colors group-hover:border-orange group-hover:bg-orange group-hover:text-forest-950">
                <svg viewBox="0 0 24 24" class="h-6 w-6 fill-none stroke-current stroke-2">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                </svg>
              </div>
              <span class="font-mono text-[0.65rem] uppercase tracking-wider text-paper/50 group-hover:text-orange">
                Facebook ↗
              </span>
            </div>
            <h3 class="display text-2xl text-paper mt-6 group-hover:text-orange transition-colors">
              /regiowegweiser
            </h3>
            <p class="mt-3 text-xs leading-relaxed text-paper/70">
              Veranstaltungsankündigungen, Terminerinnerungen und Berichte für Familien & Förderer.
            </p>
          </div>
          <div class="mt-6 border-t border-paper/10 pt-4 flex items-center justify-between">
            <span class="font-mono text-[0.65rem] uppercase text-muted">Community</span>
            <span class="font-mono text-xs text-orange font-bold">Besuchen →</span>
          </div>
        </a>
      </div>
    </Container>
  </section>
</ContentLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form')
  const status = document.querySelector<HTMLElement>('#form-status')
  if (form && status) {
    const setFieldError = (input: HTMLInputElement | HTMLTextAreaElement, message: string) => {
      const error = input.closest('label')?.querySelector<HTMLElement>('.form-error')
      if (!error) return
      error.textContent = message
      error.classList.remove('hidden')
      input.setAttribute('aria-invalid', 'true')
      input.classList.add('border-orange')
    }

    const clearFieldErrors = () => {
      form.querySelectorAll<HTMLElement>('.form-error').forEach((el) => {
        el.classList.add('hidden')
        el.textContent = ''
      })
      form.querySelectorAll('[aria-invalid]').forEach((el) => {
        el.removeAttribute('aria-invalid')
        el.classList.remove('border-orange')
      })
    }

    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]')

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      clearFieldErrors()
      status.textContent = ''

      const formData = new FormData(form)
      const name = String(formData.get('name') ?? '')
      const email = String(formData.get('email') ?? '')
      const message = String(formData.get('message') ?? '')

      if (name.length < 2) {
        setFieldError(form.querySelector('input[name="name"]')!, 'Bitte gib deinen Namen an.')
        return
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        setFieldError(form.querySelector('input[name="email"]')!, 'Bitte gib eine gültige E-Mail-Adresse an.')
        return
      }
      if (message.length < 10) {
        setFieldError(form.querySelector('textarea[name="message"]')!, 'Deine Nachricht ist noch etwas kurz.')
        return
      }

      if (submitButton) submitButton.disabled = true
      status.textContent = 'Wird gesendet …'

      try {
        const response = await fetch('/api/contact.php', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            name,
            email,
            message,
            website: String(formData.get('website') ?? ''),
          }),
        })

        const result = (await response.json()) as { ok: boolean; detail?: string; field?: string }
        if (response.ok && result.ok) {
          status.textContent = 'Nachricht gesendet. Wir melden uns!'
          form.reset()
        } else if (result.field) {
          const input = form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${result.field}"]`)
          if (input) setFieldError(input, result.detail ?? 'Bitte prüfen.')
        } else {
          status.textContent = result.detail ?? 'Etwas ist schiefgelaufen. Bitte später erneut versuchen.'
        }
      } catch {
        status.textContent = 'Keine Verbindung. Bitte schreibe uns direkt per Mail.'
      } finally {
        if (submitButton) submitButton.disabled = false
      }
    })
  }
</script>
