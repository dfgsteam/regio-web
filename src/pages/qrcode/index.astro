---
import ContentLayout from '../../layouts/ContentLayout.astro'
import Container from '../../components/common/Container.astro'
import Eyebrow from '../../components/common/Eyebrow.astro'
import {
  Download,
  Copy,
  Search,
  X,
  ExternalLink,
  Sparkles,
  Calendar,
  MapPin,
  Printer,
  SlidersHorizontal,
  ShieldCheck,
} from '@lucide/astro'
import { eventProvider } from '../../lib/events'
import { getAllCamps } from '../../lib/camps'
import { formatDateRange, formatAgeRange } from '../../lib/events'

const BASE_DOMAIN = 'https://smj-wegweiser.de'

// 1. Fetch Events
const allEvents = await eventProvider.getEvents()
const sortedEvents = allEvents.sort((a, b) => b.start.getTime() - a.start.getTime())

// 2. Fetch Camps
const allCamps = await getAllCamps()

export interface QrCardItem {
  id: string
  title: string
  subtitle?: string
  category: 'event' | 'camp' | 'channel' | 'page'
  categoryLabel: string
  targetUrl: string
  dateStr?: string
  location?: string
  ageGroup?: string
  filename: string
  badgeColor: string
  isFeatured?: boolean
}

const items: QrCardItem[] = []

// Add Core Channels & Quicklinks
items.push(
  {
    id: 'channel-whatsapp',
    title: 'Offizieller WhatsApp-Kanal',
    subtitle: 'Direkte Updates, Termine & Live-Infos aufs Handy',
    category: 'channel',
    categoryLabel: 'Messenger',
    targetUrl: 'https://www.whatsapp.com/channel/0029VaQxDPOF6smxyB2t4519',
    filename: 'qr-smj-whatsapp-kanal',
    badgeColor: 'border-green-500/40 text-green-400 bg-green-950/40',
    isFeatured: true,
  },
  {
    id: 'channel-instagram',
    title: 'Instagram @regio.wegweiser',
    subtitle: 'Fotos, Storys und Impressionen von Aktionen',
    category: 'channel',
    categoryLabel: 'Social Media',
    targetUrl: 'https://www.instagram.com/regio.wegweiser/',
    filename: 'qr-smj-instagram',
    badgeColor: 'border-pink-500/40 text-pink-400 bg-pink-950/40',
    isFeatured: true,
  },
  {
    id: 'page-home',
    title: 'Startseite smj-wegweiser.de',
    subtitle: 'Raus. Ins Abenteuer. – Das Portal der Region',
    category: 'page',
    categoryLabel: 'Website',
    targetUrl: `${BASE_DOMAIN}/`,
    filename: 'qr-smj-startseite',
    badgeColor: 'border-orange/40 text-orange bg-orange/10',
    isFeatured: true,
  },
  {
    id: 'page-calendar-ics',
    title: 'Terminkalender (iCal Abo)',
    subtitle: 'Alle SMJ-Termine direkt im Smartphone-Kalender',
    category: 'channel',
    categoryLabel: 'Kalender',
    targetUrl: `${BASE_DOMAIN}/api/calendar.ics`,
    filename: 'qr-smj-kalender-ical',
    badgeColor: 'border-blue-500/40 text-blue-400 bg-blue-950/40',
  },
  {
    id: 'page-team',
    title: 'Leiterrunde & Team',
    subtitle: 'Wer wir sind – Das Prinzip Jugend leitet Jugend',
    category: 'page',
    categoryLabel: 'Team',
    targetUrl: `${BASE_DOMAIN}/team/`,
    filename: 'qr-smj-team-leiterrunde',
    badgeColor: 'border-paper/20 text-paper/80 bg-forest-900',
  },
  {
    id: 'page-kontakt',
    title: 'Kontakt & Anlaufstelle',
    subtitle: 'Zentrale Ansprechpartner & Kontaktformular',
    category: 'page',
    categoryLabel: 'Kontakt',
    targetUrl: `${BASE_DOMAIN}/kontakt/`,
    filename: 'qr-smj-kontakt',
    badgeColor: 'border-paper/20 text-paper/80 bg-forest-900',
  },
  {
    id: 'page-aktuelles',
    title: 'Aktuelles & Berichte',
    subtitle: 'Geschichten vom Lagerfeuer & Vereinsnachrichten',
    category: 'page',
    categoryLabel: 'Journal',
    targetUrl: `${BASE_DOMAIN}/aktuelles/`,
    filename: 'qr-smj-aktuelles',
    badgeColor: 'border-paper/20 text-paper/80 bg-forest-900',
  },
  {
    id: 'page-galerie',
    title: 'Foto-Galerie & Storys',
    subtitle: 'Eindrücke aus vergangenen Lagern & Aktionen',
    category: 'page',
    categoryLabel: 'Galerie',
    targetUrl: `${BASE_DOMAIN}/galerie/`,
    filename: 'qr-smj-galerie',
    badgeColor: 'border-paper/20 text-paper/80 bg-forest-900',
  },
)

// Add Camps
for (const camp of allCamps) {
  items.push({
    id: `camp-${camp.data.year}`,
    title: `${camp.data.title}${camp.data.motto ? ` – ${camp.data.motto}` : ''}`,
    subtitle: `Sommerzeltlager ${camp.data.year} im Wiesental`,
    category: 'camp',
    categoryLabel: `Zeltlager ${camp.data.year}`,
    targetUrl: `${BASE_DOMAIN}/abenteuer/zeltlager-${camp.data.year}/`,
    dateStr: formatDateRange(camp.data.date.start, camp.data.date.end),
    location: camp.data.location.name,
    ageGroup: formatAgeRange(camp.data.age.min, camp.data.age.max) || undefined,
    filename: `qr-smj-zeltlager-${camp.data.year}`,
    badgeColor: 'border-orange bg-orange text-forest-950 font-bold',
    isFeatured: camp.data.active,
  })
}

// Add Events
for (const ev of sortedEvents) {
  // Avoid duplicate if slug already added
  if (items.some((it) => it.id === `event-${ev.slug}`)) continue

  const ageFormatted = formatAgeRange(ev.ageMin, ev.ageMax)
  const isWeekend = ev.category === 'weekend'
  const isSpecial = ev.category === 'special'

  items.push({
    id: `event-${ev.slug}`,
    title: ev.title,
    subtitle: ev.teaser || 'Aktion & Veranstaltung der SMJ Regio Wegweiser',
    category: 'event',
    categoryLabel: isWeekend ? 'Wochenende' : isSpecial ? 'Sonderaktion' : 'Veranstaltung',
    targetUrl: `${BASE_DOMAIN}/abenteuer/${ev.slug}/`,
    dateStr: formatDateRange(ev.start, ev.end),
    location: ev.location,
    ageGroup: ageFormatted || undefined,
    filename: `qr-smj-event-${ev.slug}`,
    badgeColor: isWeekend
      ? 'border-orange/60 text-orange bg-orange/10'
      : isSpecial
        ? 'border-yellow-500/60 text-yellow-400 bg-yellow-950/40'
        : 'border-paper/30 text-paper/90 bg-forest-900',
    isFeatured: ev.end >= new Date(),
  })
}
---

<ContentLayout
  title="QR-Code Generator & Flyer-Tools – SMJ Regio Wegweiser"
  description="Offizielle, hochauflösende QR-Codes mit SMJ-Logo für alle Veranstaltungen, Zeltlager und Kanäle der SMJ Regio Wegweiser. Kostenlos als PNG für Flyer und Plakate herunterladen."
>
  <!-- Hero Section -->
  <section class="texture-paper relative bg-paper pb-20 pt-40 text-forest-950">
    <Container>
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <Eyebrow label="Flyer- & Material-Hub" muted />
          <h1 class="display display-xl mt-6 text-forest-950">
            QR-Codes für<br />
            <span class="text-orange">Flyer &amp; Events.</span>
          </h1>
          <p class="mt-6 max-w-2xl text-base leading-relaxed text-forest-950/80">
            Generiere und lade offizielle, gestochen scharfe QR-Codes mit dem SMJ-Wegweiser-Logo herunter.
            Perfekt vorbereitet für Flyer, Plakate, Social Media, Gruppenstunden und Anmeldezettel.
          </p>
        </div>

        <div class="flex flex-col gap-2 rounded border-2 border-forest-950/15 bg-paper/80 p-4 font-mono text-xs text-forest-950/80">
          <div class="flex items-center gap-2 text-forest-950 font-bold uppercase tracking-wider">
            <ShieldCheck class="h-4 w-4 text-orange" />
            <span>Druckfertige Qualität</span>
          </div>
          <p class="text-[0.72rem] leading-relaxed text-forest-950/70 max-w-xs">
            Fehlerkorrektur Level H (30 % Redundanz) mit integriertem Emblem – scannt zuverlässig auf allen Smartphones.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Interactive Custom Generator Tool Section -->
  <section class="bg-forest-900 border-b border-paper/15 py-12">
    <Container>
      <div class="border-2 border-orange/40 bg-forest-950 p-6 sm:p-8 lg:p-10 shadow-2xl">
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-paper/10 pb-6">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center border border-orange bg-orange/10 text-orange">
              <Sparkles class="h-5 w-5" />
            </div>
            <div>
              <h2 class="display text-xl sm:text-2xl text-paper uppercase">Individueller QR-Code Generator</h2>
              <p class="font-mono text-xs text-paper/60">Gib einen beliebigen Link ein und erstelle sofort deinen Download-Code</p>
            </div>
          </div>
          <span class="font-mono text-[0.65rem] uppercase tracking-widest text-orange border border-orange/30 px-3 py-1 bg-orange/5">
            Live Tool
          </span>
        </div>

        <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_280px] xl:grid-cols-[1fr_320px] items-center">
          <!-- Inputs Column -->
          <div class="space-y-6">
            <div>
              <label for="custom-url-input" class="block font-mono text-xs font-bold uppercase tracking-wider text-paper mb-2">
                Ziel-URL oder Text
              </label>
              <div class="relative">
                <input
                  type="text"
                  id="custom-url-input"
                  value="https://smj-wegweiser.de/abenteuer/zeltlager-2026/"
                  placeholder="https://smj-wegweiser.de/..."
                  class="w-full bg-forest-900 border-2 border-paper/20 px-4 py-3 font-mono text-sm text-paper placeholder:text-paper/40 focus:border-orange focus:outline-none transition-colors"
                />
              </div>
              <p class="mt-2 font-mono text-[0.7rem] text-paper/50">
                Tipp: Funktioniert mit jeder Unterseite von smj-wegweiser.de, WhatsApp-Gruppen-Links oder Anmeldeformularen.
              </p>
            </div>

            <!-- Custom Options Row -->
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="block font-mono text-[0.7rem] font-bold uppercase tracking-wider text-paper/70 mb-2">
                  Design-Optionen
                </label>
                <div class="space-y-2">
                  <label class="flex items-center gap-3 cursor-pointer select-none">
                    <input
                      type="checkbox"
                      id="custom-logo-toggle"
                      checked
                      class="h-4 w-4 rounded accent-orange border-paper/30 bg-forest-900"
                    />
                    <span class="font-mono text-xs text-paper">Mit SMJ-Wegweiser Logo</span>
                  </label>
                </div>
              </div>

              <div>
                <label for="custom-color-select" class="block font-mono text-[0.7rem] font-bold uppercase tracking-wider text-paper/70 mb-2">
                  Farbvariante
                </label>
                <select
                  id="custom-color-select"
                  class="w-full bg-forest-900 border border-paper/20 px-3 py-2 font-mono text-xs text-paper focus:border-orange focus:outline-none"
                >
                  <option value="classic">Klassisch Schwarz / Weiß (Druckoptimiert)</option>
                  <option value="forest">SMJ Dunkelwald (#111713) / Weiß</option>
                </select>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="pt-2 flex flex-wrap items-center gap-3">
              <button
                type="button"
                id="custom-download-1024"
                class="inline-flex items-center gap-2 border-2 border-orange bg-orange px-6 py-3 font-mono text-xs font-bold uppercase tracking-[0.14em] text-forest-950 transition-all hover:bg-paper hover:border-paper cursor-pointer shadow-lg"
              >
                <Download class="h-4 w-4" />
                <span>PNG Herunterladen (1024 px)</span>
              </button>
              <button
                type="button"
                id="custom-download-2048"
                class="inline-flex items-center gap-2 border border-paper/30 bg-forest-900 px-5 py-3 font-mono text-xs font-bold uppercase tracking-[0.14em] text-paper transition-all hover:border-orange hover:text-orange cursor-pointer"
              >
                <Download class="h-4 w-4 text-orange" />
                <span>Print HD (2048 px)</span>
              </button>
              <button
                type="button"
                id="custom-copy-btn"
                class="inline-flex items-center gap-2 border border-paper/20 bg-forest-900/60 px-4 py-3 font-mono text-xs uppercase tracking-wider text-paper/80 transition-all hover:border-paper hover:text-paper cursor-pointer"
              >
                <Copy class="h-3.5 w-3.5" />
                <span id="custom-copy-text">Link kopieren</span>
              </button>
            </div>
          </div>

          <!-- Preview Column -->
          <div class="flex flex-col items-center justify-center p-6 bg-forest-900 border border-paper/15 text-center">
            <p class="mono-label text-[0.65rem] text-paper/50 mb-3">// LIVE VORSCHAU</p>
            <div class="relative p-3 bg-white border-2 border-paper/30 shadow-xl inline-block">
              <canvas id="custom-qr-canvas" class="w-48 h-48 sm:w-56 sm:h-56 block"></canvas>
            </div>
            <p id="custom-preview-caption" class="mt-3 font-mono text-[0.65rem] text-orange truncate max-w-[220px]">
              https://smj-wegweiser.de/abenteuer/zeltlager-2026/
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Search & Filter Bar for Events & Pages -->
  <section class="bg-forest-950 border-b border-paper/15 py-8 sticky top-0 z-30 backdrop-blur-md bg-forest-950/95">
    <Container>
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <!-- Search Input -->
        <div class="relative flex-1 max-w-lg">
          <label for="qr-search-input" class="sr-only">Veranstaltungen durchsuchen</label>
          <div class="relative">
            <input
              type="text"
              id="qr-search-input"
              placeholder="Veranstaltung, Zeltlager oder Kanal suchen..."
              class="w-full bg-forest-900 border-2 border-paper/20 px-4 py-2.5 pl-10 pr-10 font-mono text-xs text-paper placeholder:text-paper/40 focus:border-orange focus:outline-none transition-colors"
            />
            <Search class="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-orange" />
            <button
              id="qr-search-clear"
              type="button"
              class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-paper/40 hover:text-orange transition-colors p-1 cursor-pointer"
              title="Suche zurücksetzen"
            >
              <X class="h-3.5 w-3.5" />
            </button>
          </div>
        </div>

        <!-- Counter -->
        <div class="flex items-center gap-3">
          <span id="qr-items-count" class="font-mono text-xs text-paper/60 whitespace-nowrap">
            {items.length} Ziele verfügbar
          </span>
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="mt-4 pt-4 border-t border-paper/10 flex items-center gap-2 overflow-x-auto pb-1 text-xs">
        <span class="font-mono text-[0.65rem] uppercase text-paper/50 tracking-wider mr-1 shrink-0 flex items-center gap-1">
          <SlidersHorizontal class="h-3 w-3 text-orange" />
          Filter:
        </span>
        <button
          type="button"
          data-category-filter="all"
          class="qr-filter-btn px-3 py-1 font-mono text-xs font-bold uppercase tracking-wider transition-colors shrink-0 bg-orange text-forest-950 border border-orange cursor-pointer"
        >
          Alle ({items.length})
        </button>
        <button
          type="button"
          data-category-filter="event"
          class="qr-filter-btn px-3 py-1 font-mono text-xs font-bold uppercase tracking-wider transition-colors shrink-0 bg-forest-900 text-paper/70 border border-paper/20 hover:border-orange hover:text-paper cursor-pointer"
        >
          Veranstaltungen ({items.filter((i) => i.category === 'event').length})
        </button>
        <button
          type="button"
          data-category-filter="camp"
          class="qr-filter-btn px-3 py-1 font-mono text-xs font-bold uppercase tracking-wider transition-colors shrink-0 bg-forest-900 text-paper/70 border border-paper/20 hover:border-orange hover:text-paper cursor-pointer"
        >
          Zeltlager ({items.filter((i) => i.category === 'camp').length})
        </button>
        <button
          type="button"
          data-category-filter="channel"
          class="qr-filter-btn px-3 py-1 font-mono text-xs font-bold uppercase tracking-wider transition-colors shrink-0 bg-forest-900 text-paper/70 border border-paper/20 hover:border-orange hover:text-paper cursor-pointer"
        >
          Kanäle &amp; Quicklinks ({items.filter((i) => i.category === 'channel' || i.category === 'page').length})
        </button>
      </div>
    </Container>
  </section>

  <!-- Items Grid Section -->
  <section class="bg-forest-950 py-16 sm:py-20 min-h-[600px]">
    <Container>
      <!-- Empty State -->
      <div id="qr-no-results" class="hidden text-center py-20 border-2 border-dashed border-paper/15 p-8 bg-forest-900/30">
        <p class="font-display text-2xl text-paper">Keine passenden Veranstaltungen gefunden</p>
        <p class="font-mono text-xs text-paper/60 mt-2 max-w-md mx-auto">
          Probiere einen anderen Suchbegriff oder setze die Filter zurück.
        </p>
        <button
          id="qr-reset-filter-btn"
          type="button"
          class="mt-6 inline-flex items-center gap-2 border border-orange bg-orange px-5 py-2.5 font-mono text-xs font-bold uppercase tracking-wider text-forest-950 hover:bg-paper hover:border-paper transition-colors cursor-pointer"
        >
          Filter zurücksetzen
        </button>
      </div>

      <!-- Grid -->
      <div id="qr-items-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          items.map((item) => {
            const searchTokens = `${item.title} ${item.subtitle || ''} ${item.categoryLabel} ${item.location || ''} ${item.dateStr || ''} ${item.targetUrl}`.toLowerCase()
            return (
              <article
                class="qr-card group relative flex flex-col justify-between border-2 border-paper/15 bg-forest-900/60 p-6 transition-all duration-300 hover:border-orange hover:bg-forest-900"
                data-category={item.category}
                data-search={searchTokens}
                data-url={item.targetUrl}
                data-title={item.title}
                data-filename={item.filename}
              >
                <div>
                  <!-- Header Badge & Quick URL -->
                  <div class="flex items-center justify-between gap-2 mb-4">
                    <span class={`inline-block border px-2.5 py-0.5 font-mono text-[0.65rem] uppercase tracking-wider ${item.badgeColor}`}>
                      {item.categoryLabel}
                    </span>
                    {item.isFeatured && (
                      <span class="font-mono text-[0.65rem] font-bold text-orange flex items-center gap-1">
                        ★ Aktiv
                      </span>
                    )}
                  </div>

                  <!-- Title & Subtitle -->
                  <h3 class="display text-xl sm:text-2xl text-paper group-hover:text-orange transition-colors leading-tight">
                    {item.title}
                  </h3>

                  {item.subtitle && (
                    <p class="mt-1 text-xs text-paper/70 line-clamp-2">
                      {item.subtitle}
                    </p>
                  )}

                  <!-- Meta Info: Date & Location -->
                  {(item.dateStr || item.location || item.ageGroup) && (
                    <div class="mt-4 space-y-1.5 border-t border-paper/10 pt-3 font-mono text-xs text-paper/60">
                      {item.dateStr && (
                        <div class="flex items-center gap-2 text-paper/90">
                          <Calendar class="h-3.5 w-3.5 text-orange shrink-0" />
                          <span>{item.dateStr}</span>
                        </div>
                      )}
                      {item.location && (
                        <div class="flex items-center gap-2 text-paper/70">
                          <MapPin class="h-3.5 w-3.5 text-paper/40 shrink-0" />
                          <span class="truncate">{item.location}</span>
                        </div>
                      )}
                    </div>
                  )}
                </div>

                <!-- Center QR Code Canvas Preview -->
                <div class="my-6 flex flex-col items-center">
                  <div
                    class="qr-preview-wrapper relative p-3 bg-white border border-paper/20 rounded-sm shadow-md transition-transform duration-300 group-hover:scale-102 cursor-pointer"
                    title="Klicken zum Vergrößern"
                    data-preview-trigger={item.id}
                  >
                    <canvas
                      data-qr-target={item.targetUrl}
                      data-qr-filename={item.filename}
                      class="qr-item-canvas w-40 h-40 block"
                    ></canvas>
                    <span class="absolute inset-0 bg-forest-950/0 hover:bg-forest-950/10 transition-colors flex items-center justify-center">
                      <span class="sr-only">Vergrößern</span>
                    </span>
                  </div>

                  <!-- Target URL Display -->
                  <a
                    href={item.targetUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-3 inline-flex items-center gap-1 font-mono text-[0.68rem] text-orange hover:underline truncate max-w-full"
                    title={item.targetUrl}
                  >
                    <span class="truncate">{item.targetUrl.replace(/^https?:\/\//, '')}</span>
                    <ExternalLink class="h-3 w-3 shrink-0" />
                  </a>
                </div>

                <!-- Bottom Actions -->
                <div class="border-t border-paper/10 pt-4 flex flex-col gap-2">
                  <button
                    type="button"
                    class="qr-card-download-btn inline-flex items-center justify-center gap-2 border-2 border-orange bg-orange/10 px-4 py-2.5 font-mono text-xs font-bold uppercase tracking-wider text-orange hover:bg-orange hover:text-forest-950 transition-all cursor-pointer"
                    data-filename={item.filename}
                  >
                    <Download class="h-3.5 w-3.5" />
                    <span>PNG Herunterladen</span>
                  </button>

                  <div class="flex items-center gap-2">
                    <button
                      type="button"
                      class="qr-card-copy-btn flex-1 inline-flex items-center justify-center gap-1.5 border border-paper/20 bg-forest-950 px-3 py-1.5 font-mono text-[0.7rem] uppercase tracking-wider text-paper/70 hover:border-paper hover:text-paper transition-colors cursor-pointer"
                      data-url={item.targetUrl}
                    >
                      <Copy class="h-3 w-3" />
                      <span class="copy-label">Link kopieren</span>
                    </button>
                    <button
                      type="button"
                      class="qr-card-hd-btn inline-flex items-center justify-center gap-1 border border-paper/20 bg-forest-950 px-3 py-1.5 font-mono text-[0.7rem] uppercase tracking-wider text-paper/70 hover:border-orange hover:text-orange transition-colors cursor-pointer"
                      data-url={item.targetUrl}
                      data-filename={`${item.filename}-hd`}
                      title="2048px Druck-HD herunterladen"
                    >
                      <span>HD 2048px</span>
                    </button>
                  </div>
                </div>
              </article>
            )
          })
        }
      </div>
    </Container>
  </section>

  <!-- Large Modal Preview -->
  <dialog
    id="qr-modal"
    class="backdrop:bg-forest-950/90 bg-transparent p-4 sm:p-6 max-w-xl w-full m-auto open:flex flex-col items-center justify-center"
  >
    <div class="relative w-full border-2 border-orange bg-forest-950 p-6 sm:p-8 shadow-2xl text-paper">
      <button
        id="qr-modal-close"
        type="button"
        class="absolute top-4 right-4 text-paper/60 hover:text-orange transition-colors p-2 cursor-pointer"
        aria-label="Schließen"
      >
        <X class="h-6 w-6" />
      </button>

      <div class="text-center">
        <span class="mono-label text-[0.65rem] text-orange">// DRUCK- &amp; FLYER-VORSCHAU</span>
        <h3 id="modal-title" class="display display-md text-paper mt-1">QR-Code</h3>
        <p id="modal-url" class="font-mono text-xs text-paper/60 mt-1 truncate max-w-md mx-auto"></p>
      </div>

      <div class="my-6 flex justify-center">
        <div class="p-4 bg-white border-4 border-paper shadow-2xl inline-block">
          <canvas id="modal-qr-canvas" class="w-64 h-64 sm:w-80 sm:h-80 block"></canvas>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <button
          type="button"
          id="modal-download-1024"
          class="inline-flex items-center gap-2 border-2 border-orange bg-orange px-5 py-2.5 font-mono text-xs font-bold uppercase tracking-wider text-forest-950 hover:bg-paper hover:border-paper transition-colors cursor-pointer"
        >
          <Download class="h-4 w-4" />
          <span>PNG 1024px</span>
        </button>
        <button
          type="button"
          id="modal-download-2048"
          class="inline-flex items-center gap-2 border border-paper/30 bg-forest-900 px-5 py-2.5 font-mono text-xs font-bold uppercase tracking-wider text-paper hover:border-orange hover:text-orange transition-colors cursor-pointer"
        >
          <Download class="h-4 w-4 text-orange" />
          <span>Print HD (2048px)</span>
        </button>
        <button
          type="button"
          id="modal-print-btn"
          class="inline-flex items-center gap-2 border border-paper/20 bg-forest-900 px-4 py-2.5 font-mono text-xs uppercase tracking-wider text-paper/80 hover:border-paper hover:text-paper transition-colors cursor-pointer"
        >
          <Printer class="h-4 w-4" />
          <span>Drucken</span>
        </button>
      </div>
    </div>
  </dialog>
</ContentLayout>

<script>
  import { renderQrToCanvas, downloadCanvasAsPng } from '../../scripts/qrcode-renderer'

  let activeModalUrl = ''
  let activeModalFilename = 'qr-smj-code'

  // Initialize all QR card canvases
  async function initCardCanvases() {
    const canvases = document.querySelectorAll<HTMLCanvasElement>('.qr-item-canvas')
    for (const canvas of canvases) {
      const url = canvas.dataset.qrTarget
      if (!url) continue
      try {
        await renderQrToCanvas(canvas, url, {
          size: 512,
          withLogo: true,
          darkColor: '#111713',
          lightColor: '#ffffff',
          logoSrc: '/logo.svg',
        })
      } catch (err) {
        console.error('Error rendering QR canvas:', err)
      }
    }
  }

  // Custom Generator Logic
  const customInput = document.getElementById('custom-url-input') as HTMLInputElement | null
  const customCanvas = document.getElementById('custom-qr-canvas') as HTMLCanvasElement | null
  const customLogoToggle = document.getElementById('custom-logo-toggle') as HTMLInputElement | null
  const customColorSelect = document.getElementById('custom-color-select') as HTMLSelectElement | null
  const customCaption = document.getElementById('custom-preview-caption')
  const customDownload1024 = document.getElementById('custom-download-1024')
  const customDownload2048 = document.getElementById('custom-download-2048')
  const customCopyBtn = document.getElementById('custom-copy-btn')
  const customCopyText = document.getElementById('custom-copy-text')

  async function updateCustomQR() {
    if (!customCanvas || !customInput) return
    const text = customInput.value.trim() || 'https://smj-wegweiser.de/'
    if (customCaption) customCaption.textContent = text

    const withLogo = customLogoToggle ? customLogoToggle.checked : true
    const colorMode = customColorSelect ? customColorSelect.value : 'classic'
    const darkColor = colorMode === 'forest' ? '#111713' : '#000000'

    try {
      await renderQrToCanvas(customCanvas, text, {
        size: 512,
        withLogo,
        darkColor,
        lightColor: '#ffffff',
        logoSrc: '/logo.svg',
      })
    } catch (e) {
      console.error('Custom QR render failed', e)
    }
  }

  if (customInput) customInput.addEventListener('input', updateCustomQR)
  if (customLogoToggle) customLogoToggle.addEventListener('change', updateCustomQR)
  if (customColorSelect) customColorSelect.addEventListener('change', updateCustomQR)

  if (customDownload1024 && customCanvas && customInput) {
    customDownload1024.addEventListener('click', async () => {
      const text = customInput.value.trim() || 'https://smj-wegweiser.de/'
      const withLogo = customLogoToggle ? customLogoToggle.checked : true
      const colorMode = customColorSelect ? customColorSelect.value : 'classic'
      const darkColor = colorMode === 'forest' ? '#111713' : '#000000'

      const offCanvas = document.createElement('canvas')
      await renderQrToCanvas(offCanvas, text, {
        size: 1024,
        withLogo,
        darkColor,
        lightColor: '#ffffff',
        logoSrc: '/logo.svg',
      })
      downloadCanvasAsPng(offCanvas, 'qr-smj-custom-1024.png')
    })
  }

  if (customDownload2048 && customInput) {
    customDownload2048.addEventListener('click', async () => {
      const text = customInput.value.trim() || 'https://smj-wegweiser.de/'
      const withLogo = customLogoToggle ? customLogoToggle.checked : true
      const colorMode = customColorSelect ? customColorSelect.value : 'classic'
      const darkColor = colorMode === 'forest' ? '#111713' : '#000000'

      const offCanvas = document.createElement('canvas')
      await renderQrToCanvas(offCanvas, text, {
        size: 2048,
        withLogo,
        darkColor,
        lightColor: '#ffffff',
        logoSrc: '/logo.svg',
      })
      downloadCanvasAsPng(offCanvas, 'qr-smj-custom-2048-hd.png')
    })
  }

  if (customCopyBtn && customInput && customCopyText) {
    customCopyBtn.addEventListener('click', async () => {
      const text = customInput.value.trim()
      if (!text) return
      try {
        await navigator.clipboard.writeText(text)
        customCopyText.textContent = 'Kopiert! ✓'
        setTimeout(() => {
          if (customCopyText) customCopyText.textContent = 'Link kopieren'
        }, 2000)
      } catch (err) {
        console.error('Clipboard copy error', err)
      }
    })
  }

  // Card Downloads and Copy buttons
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement
    const dlBtn = target.closest<HTMLButtonElement>('.qr-card-download-btn')
    if (dlBtn) {
      const card = dlBtn.closest('.qr-card') as HTMLElement | null
      const url = card?.dataset.url
      const filename = card?.dataset.filename || 'qr-smj-code'
      if (!url) return

      const offCanvas = document.createElement('canvas')
      await renderQrToCanvas(offCanvas, url, {
        size: 1024,
        withLogo: true,
        darkColor: '#111713',
        lightColor: '#ffffff',
        logoSrc: '/logo.svg',
      })
      downloadCanvasAsPng(offCanvas, `${filename}.png`)
      return
    }

    const hdBtn = target.closest<HTMLButtonElement>('.qr-card-hd-btn')
    if (hdBtn) {
      const url = hdBtn.dataset.url
      const filename = hdBtn.dataset.filename || 'qr-smj-hd'
      if (!url) return

      const offCanvas = document.createElement('canvas')
      await renderQrToCanvas(offCanvas, url, {
        size: 2048,
        withLogo: true,
        darkColor: '#111713',
        lightColor: '#ffffff',
        logoSrc: '/logo.svg',
      })
      downloadCanvasAsPng(offCanvas, `${filename}.png`)
      return
    }

    const copyBtn = target.closest<HTMLButtonElement>('.qr-card-copy-btn')
    if (copyBtn) {
      const url = copyBtn.dataset.url
      const label = copyBtn.querySelector('.copy-label')
      if (!url) return
      try {
        await navigator.clipboard.writeText(url)
        if (label) label.textContent = 'Kopiert! ✓'
        setTimeout(() => {
          if (label) label.textContent = 'Link kopieren'
        }, 2000)
      } catch (err) {
        console.error('Copy failed', err)
      }
      return
    }

    // Modal Trigger
    const trigger = target.closest<HTMLElement>('.qr-preview-wrapper')
    if (trigger) {
      const card = trigger.closest('.qr-card') as HTMLElement | null
      if (card) {
        openModal(card.dataset.url || '', card.dataset.title || '', card.dataset.filename || '')
      }
    }
  })

  // Modal Functions
  const modal = document.getElementById('qr-modal') as HTMLDialogElement | null
  const modalClose = document.getElementById('qr-modal-close')
  const modalTitle = document.getElementById('modal-title')
  const modalUrl = document.getElementById('modal-url')
  const modalCanvas = document.getElementById('modal-qr-canvas') as HTMLCanvasElement | null
  const modalDownload1024 = document.getElementById('modal-download-1024')
  const modalDownload2048 = document.getElementById('modal-download-2048')
  const modalPrintBtn = document.getElementById('modal-print-btn')

  async function openModal(url: string, title: string, filename: string) {
    if (!modal || !modalCanvas) return
    activeModalUrl = url
    activeModalFilename = filename

    if (modalTitle) modalTitle.textContent = title
    if (modalUrl) modalUrl.textContent = url

    await renderQrToCanvas(modalCanvas, url, {
      size: 1024,
      withLogo: true,
      darkColor: '#111713',
      lightColor: '#ffffff',
      logoSrc: '/logo.svg',
    })

    modal.showModal()
  }

  if (modalClose && modal) {
    modalClose.addEventListener('click', () => modal.close())
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close()
    })
  }

  if (modalDownload1024) {
    modalDownload1024.addEventListener('click', async () => {
      if (!activeModalUrl) return
      const offCanvas = document.createElement('canvas')
      await renderQrToCanvas(offCanvas, activeModalUrl, {
        size: 1024,
        withLogo: true,
        darkColor: '#111713',
        lightColor: '#ffffff',
        logoSrc: '/logo.svg',
      })
      downloadCanvasAsPng(offCanvas, `${activeModalFilename}-1024.png`)
    })
  }

  if (modalDownload2048) {
    modalDownload2048.addEventListener('click', async () => {
      if (!activeModalUrl) return
      const offCanvas = document.createElement('canvas')
      await renderQrToCanvas(offCanvas, activeModalUrl, {
        size: 2048,
        withLogo: true,
        darkColor: '#111713',
        lightColor: '#ffffff',
        logoSrc: '/logo.svg',
      })
      downloadCanvasAsPng(offCanvas, `${activeModalFilename}-2048-hd.png`)
    })
  }

  if (modalPrintBtn && modalCanvas) {
    modalPrintBtn.addEventListener('click', () => {
      const dataUrl = modalCanvas.toDataURL('image/png')
      const win = window.open('', '_blank')
      if (win) {
        win.document.documentElement.innerHTML = `
          <head>
            <title>${modalTitle?.textContent || 'SMJ QR-Code'}</title>
            <style>
              body { font-family: sans-serif; text-align: center; padding: 40px; background: #fff; color: #111; }
              h1 { margin-bottom: 8px; font-size: 24px; text-transform: uppercase; }
              p { color: #555; font-family: monospace; font-size: 14px; margin-bottom: 24px; }
              img { width: 320px; height: 320px; border: 1px solid #ddd; }
            </style>
          </head>
          <body>
            <h1>${modalTitle?.textContent || 'SMJ QR-Code'}</h1>
            <p>${activeModalUrl}</p>
            <img src="${dataUrl}" alt="QR Code" />
          </body>
        `
        win.focus()
        setTimeout(() => win.print(), 250)
      }
    })
  }

  // Instant Live Search & Filter
  const searchInput = document.getElementById('qr-search-input') as HTMLInputElement | null
  const searchClear = document.getElementById('qr-search-clear')
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.qr-filter-btn')
  const itemsCountEl = document.getElementById('qr-items-count')
  const noResultsEl = document.getElementById('qr-no-results')
  const resetFilterBtn = document.getElementById('qr-reset-filter-btn')
  const cards = document.querySelectorAll<HTMLElement>('.qr-card')

  let currentCategory = 'all'
  let searchQuery = ''

  function applyFilters() {
    let visibleCount = 0
    const q = searchQuery.toLowerCase().trim()

    cards.forEach((card) => {
      const cardCategory = card.dataset.category || ''
      const searchTokens = card.dataset.search || ''

      const matchesCategory =
        currentCategory === 'all' ||
        cardCategory === currentCategory ||
        (currentCategory === 'channel' && (cardCategory === 'channel' || cardCategory === 'page'))

      const matchesSearch = !q || searchTokens.includes(q)

      if (matchesCategory && matchesSearch) {
        card.classList.remove('hidden')
        visibleCount++
      } else {
        card.classList.add('hidden')
      }
    })

    if (itemsCountEl) {
      itemsCountEl.textContent = `${visibleCount} ${visibleCount === 1 ? 'Ziel' : 'Ziele'} gefunden`
    }

    if (noResultsEl) {
      if (visibleCount === 0) {
        noResultsEl.classList.remove('hidden')
      } else {
        noResultsEl.classList.add('hidden')
      }
    }

    if (searchClear) {
      if (searchQuery.length > 0) {
        searchClear.classList.remove('hidden')
      } else {
        searchClear.classList.add('hidden')
      }
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value
      applyFilters()
    })
  }

  if (searchClear && searchInput) {
    searchClear.addEventListener('click', () => {
      searchInput.value = ''
      searchQuery = ''
      applyFilters()
      searchInput.focus()
    })
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.className =
          'qr-filter-btn px-3 py-1 font-mono text-xs font-bold uppercase tracking-wider transition-colors shrink-0 bg-forest-900 text-paper/70 border border-paper/20 hover:border-orange hover:text-paper cursor-pointer'
      })
      btn.className =
        'qr-filter-btn px-3 py-1 font-mono text-xs font-bold uppercase tracking-wider transition-colors shrink-0 bg-orange text-forest-950 border border-orange cursor-pointer'
      currentCategory = btn.dataset.categoryFilter || 'all'
      applyFilters()
    })
  })

  if (resetFilterBtn && searchInput) {
    resetFilterBtn.addEventListener('click', () => {
      searchInput.value = ''
      searchQuery = ''
      currentCategory = 'all'
      filterBtns.forEach((b) => {
        if (b.dataset.categoryFilter === 'all') {
          b.className =
            'qr-filter-btn px-3 py-1 font-mono text-xs font-bold uppercase tracking-wider transition-colors shrink-0 bg-orange text-forest-950 border border-orange cursor-pointer'
        } else {
          b.className =
            'qr-filter-btn px-3 py-1 font-mono text-xs font-bold uppercase tracking-wider transition-colors shrink-0 bg-forest-900 text-paper/70 border border-paper/20 hover:border-orange hover:text-paper cursor-pointer'
        }
      })
      applyFilters()
    })
  }

  // Run on page load & view transitions
  initCardCanvases()
  updateCustomQR()
  document.addEventListener('astro:page-load', () => {
    initCardCanvases()
    updateCustomQR()
  })
</script>
