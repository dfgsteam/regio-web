---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/home/Hero.astro'
import ExpectSection from '../components/home/ExpectSection.astro'
import ExpeditionReel from '../components/home/ExpeditionReel.astro'
import DigitalDetoxSection from '../components/home/DigitalDetoxSection.astro'
import Pillars from '../components/home/Pillars.astro'
import EventsSection from '../components/home/EventsSection.astro'
import CampTeaser from '../components/home/CampTeaser.astro'
import ParentsSection from '../components/home/ParentsSection.astro'
import FaithSection from '../components/home/FaithSection.astro'
import JournalSection from '../components/home/JournalSection.astro'
import FinalCta from '../components/home/FinalCta.astro'
import Header from '../components/navigation/Header.astro'
import Footer from '../components/navigation/Footer.astro'

const siteUrl = Astro.site?.toString().replace(/\/$/, '')
const websiteStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: 'SMJ Regio Wegweiser',
  url: `${siteUrl}/`,
  inLanguage: 'de-DE',
  publisher: { '@id': `${siteUrl}/#organization` },
}

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Wer passt auf?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Unsere Leiter sind geschult, verantwortlich und selbst in der SMJ groß geworden. Jugend leitet Jugend – mit Rückhalt durch erfahrene Erwachsene.',
      },
    },
    {
      '@type': 'Question',
      name: 'Dürfen Handys mit auf das Zeltlager?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Unsere Lager sind bewusst handyfreie Zonen. Handys bleiben in der sicheren Verwahrung der Lagerleitung. So tauchen die Jungs voll ins echte Leben ein. Für Notfälle ist die Leitung 24/7 telefonisch erreichbar.',
      },
    },
    {
      '@type': 'Question',
      name: 'Was kostet das Zeltlager?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Wir halten die Teilnahmebeiträge so niedrig wie möglich. Bei Geschwistern oder finanziellen Engpässen finden wir immer einen Weg. Kein Junge bleibt aus Kostengründen zu Hause.',
      },
    },
    {
      '@type': 'Question',
      name: 'Was ist die SMJ eigentlich?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Die Schönstatt-Mannesjugend ist eine katholische Jugendgemeinschaft. Wir bieten Jungs Raum für Abenteuer, echte Freundschaft und Persönlichkeitsbildung – offen für alle, ohne Zwang.',
      },
    },
  ],
}
---

<BaseLayout
  title="SMJ Regio Wegweiser – Raus. Ins Abenteuer."
  description="Zeltlager. Lagerfeuer. Wettkämpfe. Freunde. Zehn Tage, die anders sind als alles davor. Die SMJ Regio Wegweiser – Abenteuer und Gemeinschaft für Jungs von 9 bis 14."
  structuredData={[websiteStructuredData, faqStructuredData]}
>
  <Header />
  <main>
    <Hero />
    <ExpectSection />
    <ExpeditionReel />
    <DigitalDetoxSection />
    <Pillars />
    <EventsSection />
    <CampTeaser />
    <ParentsSection />
    <FaithSection />
    <JournalSection />
    <FinalCta />
  </main>
  <Footer />
</BaseLayout>
