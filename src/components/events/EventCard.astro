---
import { formatAgeRange, formatDateRange } from '../../lib/events'
import type { Event } from '../../lib/events'

interface Props {
  event: Event
  href?: string
  featured?: boolean
}

const { event, href, featured = false } = Astro.props
const isCamp = event.category === 'camp' || event.title.toLowerCase().includes('zeltlager')
const isFeatured = featured || isCamp
const eventYear = event.start.getFullYear()
const isPast = event.end < new Date()

// Past camps link to their specific year page /abenteuer/zeltlager/[year]/
// Current camp links to /abenteuer/zeltlager/ (which is also reachable via /abenteuer/zeltlager/[year]/)
const campUrl = isPast ? `/abenteuer/zeltlager/${eventYear}/` : '/abenteuer/zeltlager/'
const targetUrl = href ?? (isCamp ? campUrl : `/abenteuer/${event.slug}/`)
const age = formatAgeRange(event.ageMin, event.ageMax)
---

<article
  class:list={[
    'group relative flex flex-col border-2 border-paper/15 bg-forest-900 p-6 transition-colors hover:border-orange sm:p-8',
    isFeatured && 'border-orange bg-forest-900/90 shadow-xl',
  ]}
>
  {isFeatured && (
    <span class="absolute -top-3 right-6 bg-orange px-3 py-1 font-mono text-[0.6rem] font-bold uppercase tracking-[0.2em] text-forest-950 shadow-md">
      {isCamp ? 'Jahreshighlight' : 'Highlight'}
    </span>
  )}

  <p class="mono-label">
    {isCamp ? 'HAUPTABENTEUER · ZELTLAGER' : event.category.toUpperCase()}
  </p>

  <h3 class="display text-2xl sm:text-[1.75rem] leading-[1.08] mt-3 text-paper break-words">
    <a href={targetUrl} class="after:absolute after:inset-0">
      {event.title}
    </a>
  </h3>

  {event.teaser && <p class="mt-3 text-sm leading-relaxed text-paper/70">{event.teaser}</p>}

  <dl class="mt-6 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 font-mono text-[0.7rem] uppercase tracking-[0.14em]">
    <dt class="text-muted">Wann</dt>
    <dd class="text-paper/90">{formatDateRange(event.start, event.end)}</dd>
    {event.location && (
      <>
        <dt class="text-muted">Wo</dt>
        <dd class="text-paper/90">{event.location}</dd>
      </>
    )}
    {age && (
      <>
        <dt class="text-muted">Alter</dt>
        <dd class="text-paper/90">{age}</dd>
      </>
    )}
  </dl>

  <span class="mt-auto pt-6 inline-flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-[0.2em] text-orange">
    {isCamp ? 'Zum Zeltlager-Erlebnis →' : 'Mehr Infos & Anmeldung →'}
  </span>
</article>
