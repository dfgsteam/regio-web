---
const year = new Date().getFullYear()

const columns = [
  {
    title: 'Entdecken',
    links: [
      { label: 'Start', href: '/' },
      { label: 'Abenteuer', href: '/abenteuer/' },
      { label: 'Zeltlager', href: '/abenteuer/zeltlager/' },
      { label: 'Journal', href: '/journal/' },
      { label: 'Galerie', href: '/galerie/' },
    ],
  },
  {
    title: 'Über uns',
    links: [
      { label: 'Über uns', href: '/ueber-uns/' },
      { label: 'Grundsätze', href: '/grundsaetze/' },
      { label: 'Team', href: '/team/' },
      { label: 'Kontakt', href: '/kontakt/' },
    ],
  },
]
---

<footer class="border-t border-paper/10 bg-forest-950 text-paper">
  <div class="mx-auto grid w-full max-w-6xl gap-10 px-5 py-14 sm:px-8 md:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
    <div>
      <span class="grid h-11 w-11 place-items-center border-2 border-orange font-display text-xl text-paper">
        SMJ
      </span>
      <p class="mt-4 font-display text-2xl uppercase leading-tight">
        Raus.<br />Ins Abenteuer.
      </p>
      <p class="mono-label mt-4">SMJ Regio Wegweiser</p>
      <p class="mono-label">Schönstatt-Mannesjugend</p>
    </div>

    {
      columns.map((column) => (
        <nav aria-label={column.title}>
          <h2 class="eyebrow mb-4">{column.title}</h2>
          <ul class="space-y-2.5">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-paper/80 transition-colors hover:text-orange">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <div>
      <h2 class="eyebrow mb-4">Kontakt</h2>
      <ul class="space-y-2.5 text-sm text-paper/80">
        <li>
          <a href="/kontakt/" class="transition-colors hover:text-orange">Zentrale Anlaufstelle</a>
        </li>
        <li>
          <a href="mailto:kontakt@smj-wegweiser.de" class="transition-colors hover:text-orange">
            kontakt@smj-wegweiser.de
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-paper/10">
    <div class="mx-auto flex w-full max-w-6xl flex-col items-start justify-between gap-3 px-5 py-5 sm:flex-row sm:items-center sm:px-8">
      <p class="mono-label">© {year} SMJ Regio Wegweiser</p>
      <div class="flex gap-6">
        <a href="/impressum/" class="mono-label transition-colors hover:text-orange">Impressum</a>
        <a href="/datenschutz/" class="mono-label transition-colors hover:text-orange">Datenschutz</a>
      </div>
    </div>
  </div>
</footer>
