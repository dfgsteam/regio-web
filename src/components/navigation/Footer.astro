---
import { Calendar, ExternalLink } from '@lucide/astro'
import Logo from '../common/Logo.astro'

const year = new Date().getFullYear()

const navigationLinks = [
  { label: 'Startseite', href: '/' },
  { label: 'Abenteuer & Aktionen', href: '/abenteuer/' },
  { label: 'Zeltlager 2026', href: '/abenteuer/zeltlager-2026/' },
  { label: 'Grundsätze & Säulen', href: '/grundsaetze/' },
  { label: 'Unser Team', href: '/team/' },
  { label: 'Aktuelles & Berichte', href: '/aktuelles/' },
  { label: 'Galerie', href: '/galerie/' },
]

const partnerLinks = [
  { label: 'Schönstatt Deutschland', href: 'https://www.schoenstatt.de/de/', external: true },
  { label: 'Schönstatt-Mannesjugend (SMJ)', href: 'https://www.smj-deutschland.de/', external: true },
  { label: 'Terminkalender abonnieren (iCal)', href: '/api/calendar.ics', external: false, icon: 'calendar' },
  { label: 'Kontakt & Anlaufstelle', href: '/kontakt/', external: false },
]

const socialLinks = [
  {
    name: 'Instagram',
    href: 'https://www.instagram.com/regio.wegweiser/',
    svg: `<svg viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current stroke-2 stroke-linecap-round stroke-linejoin-round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>`,
  },
  {
    name: 'Facebook',
    href: 'https://www.facebook.com/regiowegweiser',
    svg: `<svg viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current stroke-2 stroke-linecap-round stroke-linejoin-round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>`,
  },
  {
    name: 'YouTube',
    href: 'https://www.youtube.com/channel/UC1BbR9tT5hsZzEzPXbJ7pFw',
    svg: `<svg viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current stroke-2 stroke-linecap-round stroke-linejoin-round"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><polygon points="10 15 15 12 10 9 10 15" fill="currentColor"/></svg>`,
  },
]
---

<footer class="border-t border-paper/10 bg-forest-950 text-paper">
  <div class="mx-auto grid w-full max-w-6xl gap-12 px-5 py-16 sm:px-8 lg:grid-cols-[1.3fr_1fr_1.1fr_1.4fr]">
    <!-- Brand & Socials -->
    <div class="flex flex-col justify-between">
      <div>
        <Logo variant="full" size="lg" />
        <p class="mt-5 font-display text-2xl uppercase leading-tight">
          Raus.<br />Ins Abenteuer.
        </p>
        <p class="mono-label mt-4 text-xs text-paper/70">SMJ Regio Wegweiser</p>
        <p class="mono-label text-xs text-paper/50">Schönstatt-Mannesjugend Diözese Erfurt</p>
        <p class="mono-label text-[0.68rem] text-paper/40 mt-1">Pater-Kentenich-Weg 3 · 37308 Heilbad Heiligenstadt</p>
      </div>

      <!-- Social Media Buttons -->
      <div class="mt-8">
        <p class="eyebrow mb-3 text-[0.65rem]">Folge der Region</p>
        <div class="flex items-center gap-3">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`SMJ Regio Wegweiser auf ${social.name}`}
                class="flex h-10 w-10 items-center justify-center border border-paper/20 bg-forest-900 text-paper transition-all hover:border-orange hover:bg-orange hover:text-forest-950"
              >
                <Fragment set:html={social.svg} />
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Navigation Links -->
    <nav aria-label="Hauptnavigation">
      <h2 class="eyebrow mb-4">Navigation</h2>
      <ul class="space-y-2.5 text-sm">
        {
          navigationLinks.map((link) => (
            <li>
              <a href={link.href} class="text-paper/80 transition-colors hover:text-orange">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Verband & Netzwerk & Kalender -->
    <nav aria-label="Verband und Netzwerk">
      <h2 class="eyebrow mb-4">Netzwerk & Termine</h2>
      <ul class="space-y-3 text-sm">
        {
          partnerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                class="inline-flex items-center gap-1.5 text-paper/80 transition-colors hover:text-orange"
              >
                {link.icon === 'calendar' && <Calendar class="h-3.5 w-3.5 text-orange shrink-0" />}
                <span>{link.label}</span>
                {link.external && <ExternalLink class="h-3 w-3 text-paper/40 shrink-0" />}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Newsletter Subscription Form -->
    <div>
      <h2 class="eyebrow mb-4">Newsletter</h2>
      <p class="text-xs leading-relaxed text-paper/75">
        Immer wissen, wann Anmeldungen öffnen und was in der Region passiert. Kein Spam.
      </p>

      <form id="footer-newsletter-form" action="/api/newsletter.php" method="POST" class="mt-4 space-y-3" novalidate>
        <div class="relative">
          <input
            type="email"
            name="email"
            id="footer-newsletter-email"
            required
            placeholder="deine.mail@adresse.de"
            class="w-full border border-paper/20 bg-forest-900 px-3.5 py-2.5 font-mono text-xs text-paper placeholder:text-paper/40 focus:border-orange focus:outline-none"
          />
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
        </div>

        <button
          type="submit"
          class="w-full bg-orange px-4 py-2.5 font-mono text-xs font-bold uppercase tracking-[0.16em] text-forest-950 transition-all hover:bg-paper cursor-pointer"
        >
          Newsletter abonnieren
        </button>

        <p id="footer-newsletter-status" class="hidden font-mono text-[0.68rem]"></p>
      </form>
    </div>
  </div>

  <!-- Bottom Legal Bar -->
  <div class="border-t border-paper/10">
    <div class="mx-auto flex w-full max-w-6xl flex-col items-start justify-between gap-4 px-5 py-5 md:flex-row md:items-center sm:px-8">
      <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:gap-3">
        <p class="mono-label text-[0.7rem]">© {year} SMJ Regio Wegweiser</p>
        <span class="hidden text-paper/25 sm:inline">·</span>
        <a
          href="https://hndl24.de"
          target="_blank"
          rel="noopener noreferrer"
          class="mono-label text-[0.7rem] text-paper/60 transition-colors hover:text-orange inline-flex items-center gap-1"
        >
          <span>built by</span>
          <strong class="text-paper/90 font-bold hover:text-orange">hndl24</strong>
          <span class="text-paper/45">— Partner für einen modernen Webauftritt</span>
        </a>
      </div>
      <div class="flex gap-6">
        <a href="/impressum/" class="mono-label text-[0.7rem] transition-colors hover:text-orange">Impressum</a>
        <a href="/datenschutz/" class="mono-label text-[0.7rem] transition-colors hover:text-orange">Datenschutz</a>
      </div>
    </div>
  </div>
</footer>

<script>
  const form = document.getElementById('footer-newsletter-form') as HTMLFormElement | null
  const statusEl = document.getElementById('footer-newsletter-status')

  if (form && statusEl) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const emailInput = form.querySelector<HTMLInputElement>('input[name="email"]')
      const websiteInput = form.querySelector<HTMLInputElement>('input[name="website"]')
      const email = emailInput?.value.trim() ?? ''
      const website = websiteInput?.value.trim() ?? ''

      if (!email) return

      statusEl.className = 'font-mono text-[0.68rem] text-paper/70'
      statusEl.textContent = 'Wird eingetragen...'
      statusEl.classList.remove('hidden')

      try {
        const res = await fetch('/api/newsletter.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, website }),
        })
        const data = await res.json()
        if (res.ok && data.ok) {
          statusEl.className = 'font-mono text-[0.68rem] text-orange'
          statusEl.textContent = 'Eingetragen! Du erhältst in Kürze Updates.'
          form.reset()
        } else {
          statusEl.className = 'font-mono text-[0.68rem] text-red-400'
          statusEl.textContent = data.detail || 'Fehler beim Eintragen.'
        }
      } catch {
        statusEl.className = 'font-mono text-[0.68rem] text-red-400'
        statusEl.textContent = 'Netzwerkfehler. Bitte später erneut versuchen.'
      }
    })
  }
</script>
