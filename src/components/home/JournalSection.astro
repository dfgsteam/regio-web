---
import { getCollection } from 'astro:content'
import Container from '../common/Container.astro'
import Eyebrow from '../common/Eyebrow.astro'

const posts = await getCollection('posts', ({ data }) => !data.draft && !data.disabled && data.active !== false)
const latest = posts
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3)
---

<section id="journal" class="relative bg-forest-900 py-24 sm:py-32">
  <Container>
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <Eyebrow label="Aktuelles & Berichte" />
        <h2 class="display display-lg mt-6 text-paper">
          Aktuelles &<br />
          <span class="text-orange">Vereinsberichte.</span>
        </h2>
      </div>
      <a href="/aktuelles/" class="mb-2 border-b-2 border-orange pb-1 font-mono text-xs font-bold uppercase tracking-[0.2em] text-paper transition-colors hover:text-orange">
        Alle Beiträge →
      </a>
    </div>

    <div class="mt-14 space-y-6">
      {
        latest.map((post, index) => (
          <article class="journal-card group relative border-2 border-paper/15 bg-forest-950 p-6 sm:p-8 transition-colors hover:border-orange">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-8">
              <a href={`/aktuelles/${post.id}/`} class="relative block shrink-0 overflow-hidden border border-paper/20 bg-forest-900 aspect-[4/3] w-full sm:w-56">
                <img
                  src={post.data.image.src}
                  alt={post.data.image.alt}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </a>
              <div class="flex-1">
                <p class="mono-label">
                  {post.data.publishedAt.toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' })} · {post.data.author}
                </p>
                <h3 class="display display-sm mt-2 text-paper transition-colors group-hover:text-orange">
                  <a href={`/aktuelles/${post.id}/`}>
                    {post.data.title}
                  </a>
                </h3>
                <p class="mt-3 max-w-xl text-sm leading-relaxed text-paper/70">{post.data.description}</p>
                {index === 0 && (
                  <span class="mt-4 inline-block bg-orange px-3 py-1 font-mono text-[0.6rem] font-bold uppercase tracking-[0.2em] text-forest-950">
                    Neuester Beitrag
                  </span>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</section>

<script>
  import '../../scripts/animations/journal'
</script>
