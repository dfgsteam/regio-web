---
import Container from '../common/Container.astro'
import Eyebrow from '../common/Eyebrow.astro'
import { Zap, TreePine, Flame } from '@lucide/astro'

const analogPillars = [
  {
    icon: Zap,
    title: 'Taschenmesser statt Touchscreen',
    description:
      'Schnitzen, Holztürme bauen, Feuer ohne Streichhölzer entfachen: Bei uns machst du Dinge mit deinen eigenen Händen, die kein Algorithmus ersetzen kann.',
  },
  {
    icon: TreePine,
    title: 'Echte Kumpels statt Follower',
    description:
      'Zusammen im Zelt aufwachen, sich beim Geländespiel im Dickicht den Rücken freihalten und am Lagerfeuer Geschichten lauschen – Auge in Auge, ohne Filter.',
  },
  {
    icon: Flame,
    title: 'Kopf frei statt Dauer-Push',
    description:
      'Kein TikTok, keine Schulgruppen, kein Vergleichsdruck. Zehn Tage echter Ausstieg. Für Eltern: Im Notfall ist die Lagerleitung rund um die Uhr direkt erreichbar.',
  },
]
---

<section id="analog" class="relative overflow-hidden bg-forest-950 py-24 sm:py-36 border-t border-paper/10">
  <div class="texture-topo absolute inset-0 opacity-40" aria-hidden="true" />

  <Container class="relative">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
      <!-- Left Column: Header & Quote -->
      <div>
        <div class="flex flex-wrap items-center gap-3">
          <Eyebrow label="100% Analog · Handyfreie Zone" />
          <span class="stamp-distressed -rotate-2">Offline Zone · 0% Screen Time</span>
        </div>

        <h2 class="display display-lg mt-6 text-paper">
          Stecker raus.<br />
          <span class="text-orange">Echtes Leben an.</span>
        </h2>

        <p class="hand-note mt-4 text-2xl sm:text-3xl text-orange">
          // Dein Smartphone wird dich nicht vermissen. Versprochen.
        </p>

        <p class="mt-6 text-base leading-relaxed text-paper/80 sm:text-lg">
          Kein Display. Kein Akku-Stress. Kein Scrollen. Bei der SMJ Regio Wegweiser schalten wir das Smartphone bewusst ab, um das einzuschalten, was wirklich zählt: <strong class="text-paper">echte Natur, echte Herausforderungen und echte Gemeinschaft.</strong>
        </p>

        <div class="mt-10 border-l-2 border-orange bg-forest-900/80 p-6 shadow-xl">
          <p class="font-display text-xl uppercase leading-snug text-paper">
            „Nach zwei Tagen vermisst niemand mehr sein Smartphone. Nach zehn Tagen will keiner zurück an den Bildschirm.“
          </p>
          <p class="mono-label mt-3 text-xs text-orange">Erfahrung aus über 40 Jahren Zeltlager</p>
        </div>
      </div>

      <!-- Right Column: 3D Physical Card Stack Deck -->
      <div class="relative min-h-[440px] flex items-center justify-center">
        <div class="card-stack-deck relative w-full space-y-6 lg:space-y-0">
          {
            analogPillars.map((item, index) => {
              const Icon = item.icon
              return (
                <div
                  class:list={[
                    'card-stack-item border-2 border-paper/20 bg-forest-900 p-7 sm:p-8 transition-colors hover:border-orange',
                    index > 0 ? 'lg:absolute lg:inset-0' : 'relative',
                  ]}
                  style={`z-index: ${index + 1};`}
                >
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                      <span class="grid h-10 w-10 place-items-center border-2 border-orange bg-forest-950 text-orange">
                        <Icon class="h-5 w-5" />
                      </span>
                      <h3 class="display text-2xl text-paper">{item.title}</h3>
                    </div>
                    <span class="font-mono text-xs text-orange/60">PFEILER 0{index + 1}</span>
                  </div>
                  <p class="mt-5 text-sm leading-relaxed text-paper/80">{item.description}</p>
                  <div class="mt-6 flex items-center justify-between border-t border-paper/10 pt-4">
                    <span class="mono-label text-[0.68rem] text-paper/50">SMJ REGIO WEGWEISER</span>
                    <span class="mono-label text-[0.68rem] text-orange font-bold">100% ANALOG</span>
                  </div>
                </div>
              )
            })
          }
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  import '../../scripts/animations/card-stack'
</script>
