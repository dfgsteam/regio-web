---
import Container from '../common/Container.astro'
import Eyebrow from '../common/Eyebrow.astro'
import Button from '../common/Button.astro'
import EventCard from '../events/EventCard.astro'
import { Calendar } from '@lucide/astro'
import { eventProvider } from '../../lib/events'
import type { Event } from '../../lib/events'

type DisplayItem = { event: Event; href?: string; featured: boolean }

const allEvents = await eventProvider.getEvents()

const now = new Date()
const upcoming = allEvents
  .filter((event) => event.end >= now)
  .sort((a, b) => a.start.getTime() - b.start.getTime())

const display: DisplayItem[] = upcoming.slice(0, 3).map((event) => ({ event, featured: false }))
---

<section id="events" class="relative bg-forest-950 py-24 sm:py-32">
  <Container>
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <Eyebrow label="Events & Abenteuer" />
        <h2 class="display display-lg mt-6 text-paper">
          Dein nächstes<br />
          <span class="text-orange">Abenteuer.</span>
        </h2>
      </div>
      <div class="flex flex-wrap items-center gap-3 mb-2">
        <a
          href="https://www.whatsapp.com/channel/0029VaQxDPOF6smxyB2t4519"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border-2 border-green-500/50 bg-forest-900 px-4 py-2.5 font-mono text-xs font-bold uppercase tracking-[0.14em] text-paper transition-all hover:border-green-500 hover:text-green-400"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current text-green-500"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm5.79 14.07c-.24.68-1.41 1.25-1.95 1.33-.51.08-1.18.11-3.41-.81-2.85-1.18-4.69-4.08-4.83-4.27-.14-.19-1.16-1.54-1.16-2.94 0-1.4.73-2.09 1-2.37.24-.28.53-.35.71-.35.18 0 .35.01.5.01.16 0 .38-.06.59.45.24.58.82 2 .89 2.15.07.15.12.33.02.53-.1.2-.15.33-.3.51-.15.18-.31.4-.44.54-.15.15-.3.32-.13.62.17.3 1.05 1.73 2.26 2.81 1.56 1.39 2.87 1.82 3.28 2.02.41.2.65.17.89-.11.24-.28 1.03-1.2 1.3-1.61.27-.41.55-.35.92-.21.38.14 2.39 1.13 2.8 1.33.41.2.68.3.78.47.1.18.1 1.02-.14 1.7z"/></svg>
          <span>WhatsApp-Updates</span>
        </a>
        <a
          href="/api/calendar.ics"
          class="inline-flex items-center gap-2 border border-paper/20 bg-forest-900 px-4 py-2.5 font-mono text-xs font-bold uppercase tracking-[0.14em] text-paper transition-colors hover:border-orange hover:text-orange"
        >
          <Calendar class="h-4 w-4 text-orange" />
          <span>Kalender abonnieren</span>
        </a>
        <Button href="/abenteuer/" variant="ghost">
          Alle Abenteuer
        </Button>
      </div>
    </div>

    {
      display.length > 0 ? (
        <div class="mt-14 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {display.map((item) => (
            <EventCard event={item.event} href={item.href} featured={item.featured} />
          ))}
        </div>
      ) : (
        <p class="mt-14 max-w-lg font-mono text-sm uppercase tracking-[0.18em] text-muted">
          Gerade sind keine Abenteuer in Planung. Schau bald wieder vorbei.
        </p>
      )
    }
  </Container>
</section>
