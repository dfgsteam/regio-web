---
import { getCollection } from 'astro:content'
import Container from '../common/Container.astro'
import Eyebrow from '../common/Eyebrow.astro'
import Button from '../common/Button.astro'
import EventCard from '../events/EventCard.astro'
import { eventProvider } from '../../lib/events'
import type { Event } from '../../lib/events'

type DisplayItem = { event: Event; href?: string; featured: boolean }

const [allEvents, specialEvents] = await Promise.all([
  eventProvider.getEvents(),
  getCollection('specialEvents'),
])

const now = new Date()
const upcoming = allEvents
  .filter((event) => event.end >= now)
  .sort((a, b) => a.start.getTime() - b.start.getTime())

const featuredSpecial = specialEvents
  .filter((event) => event.data.active && event.data.featured)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())[0]

const providerIds = new Set(allEvents.map((event) => event.slug))
const specialNotInProvider: DisplayItem | null =
  featuredSpecial && !providerIds.has(featuredSpecial.data.slug)
    ? {
        event: {
          id: featuredSpecial.id,
          title: featuredSpecial.data.title,
          slug: featuredSpecial.data.slug,
          start: featuredSpecial.data.date.start,
          end: featuredSpecial.data.date.end,
          location: featuredSpecial.data.location.name,
          ageMin: featuredSpecial.data.age.min,
          ageMax: featuredSpecial.data.age.max,
          teaser: featuredSpecial.data.teaser,
          category: 'special' as const,
        },
        href: `/abenteuer/${featuredSpecial.data.slug}/`,
        featured: true,
      }
    : null

const display: DisplayItem[] = [
  ...(specialNotInProvider ? [specialNotInProvider] : []),
  ...upcoming.slice(0, 3).map((event) => ({ event, featured: false })),
]
---

<section id="events" class="relative bg-forest-950 py-24 sm:py-32">
  <Container>
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <Eyebrow label="Events & Abenteuer" />
        <h2 class="display display-lg mt-6 text-paper">
          Dein nächstes<br />
          <span class="text-orange">Abenteuer.</span>
        </h2>
      </div>
      <div class="flex flex-wrap items-center gap-3 mb-2">
        <a
          href="/api/calendar.ics"
          class="border border-paper/20 bg-forest-900 px-4 py-2.5 font-mono text-xs font-bold uppercase tracking-[0.14em] text-paper transition-colors hover:border-orange hover:text-orange"
        >
          📅 Kalender abonnieren
        </a>
        <Button href="/abenteuer/" variant="ghost">
          Alle Abenteuer
        </Button>
      </div>
    </div>

    {
      display.length > 0 ? (
        <div class="mt-14 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {display.map((item) => (
            <EventCard event={item.event} href={item.href} featured={item.featured} />
          ))}
        </div>
      ) : (
        <p class="mt-14 max-w-lg font-mono text-sm uppercase tracking-[0.18em] text-muted">
          Gerade sind keine Abenteuer in Planung. Schau bald wieder vorbei.
        </p>
      )
    }
  </Container>
</section>
