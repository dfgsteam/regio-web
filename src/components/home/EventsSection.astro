---
import Container from '../common/Container.astro'
import Eyebrow from '../common/Eyebrow.astro'
import Button from '../common/Button.astro'
import EventCard from '../events/EventCard.astro'
import { Calendar } from '@lucide/astro'
import { eventProvider } from '../../lib/events'
import type { Event } from '../../lib/events'

type DisplayItem = { event: Event; href?: string; featured: boolean }

const allEvents = await eventProvider.getEvents()

const now = new Date()
const upcoming = allEvents
  .filter((event) => event.end >= now)
  .sort((a, b) => a.start.getTime() - b.start.getTime())

const display: DisplayItem[] = upcoming.slice(0, 3).map((event) => ({ event, featured: false }))
---

<section id="events" class="relative bg-forest-950 py-24 sm:py-32">
  <Container>
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <Eyebrow label="Events & Abenteuer" />
        <h2 class="display display-lg mt-6 text-paper">
          Dein nächstes<br />
          <span class="text-orange">Abenteuer.</span>
        </h2>
      </div>
      <div class="flex flex-wrap items-center gap-3 mb-2">
        <a
          href="/api/calendar.ics"
          class="inline-flex items-center gap-2 border border-paper/20 bg-forest-900 px-4 py-2.5 font-mono text-xs font-bold uppercase tracking-[0.14em] text-paper transition-colors hover:border-orange hover:text-orange"
        >
          <Calendar class="h-4 w-4 text-orange" />
          <span>Kalender abonnieren</span>
        </a>
        <Button href="/abenteuer/" variant="ghost">
          Alle Abenteuer
        </Button>
      </div>
    </div>

    {
      display.length > 0 ? (
        <div class="mt-14 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {display.map((item) => (
            <EventCard event={item.event} href={item.href} featured={item.featured} />
          ))}
        </div>
      ) : (
        <p class="mt-14 max-w-lg font-mono text-sm uppercase tracking-[0.18em] text-muted">
          Gerade sind keine Abenteuer in Planung. Schau bald wieder vorbei.
        </p>
      )
    }
  </Container>
</section>
