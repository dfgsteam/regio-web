---
import Coordinates from '../common/Coordinates.astro'
import Logo from '../common/Logo.astro'
---

<section id="hero" class="relative h-svh min-h-[620px] overflow-hidden bg-forest-950">
  <div class="hero-bg absolute inset-0 overflow-hidden">
    <img
      src="/images/home/hero-camp.jpg"
      alt="Zeltlager der SMJ Regio Wegweiser im Wiesental"
      class="h-full w-full object-cover"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-forest-950/40" aria-hidden="true" />
  </div>

  <div class="hero-topo texture-topo absolute inset-0 opacity-0" aria-hidden="true" />
  <div class="texture-vignette pointer-events-none absolute inset-0 z-1" aria-hidden="true" />

  <div class="hero-content relative z-10 flex h-full flex-col items-center justify-center px-6 text-center">
    <!-- Hero Brand Emblem & Logo -->
    <div class="hero-logo-wrap mb-4 sm:mb-6 flex flex-col items-center">
      <div class="hero-logo-container relative flex items-center justify-center">
        <!-- Ambient Orange Backlight Glow -->
        <div class="hero-logo-glow absolute -inset-4 rounded-full bg-orange/20 blur-2xl pointer-events-none" aria-hidden="true" />
        
        <Logo
          size="hero"
          tone="light"
          class="hero-logo-img relative z-10 drop-shadow-[0_12px_24px_rgba(0,0,0,0.6)]"
        />
      </div>

      <div class="hero-eyebrow mt-4 flex flex-wrap items-center justify-center gap-3">
        <span class="eyebrow">SMJ Regio Wegweiser</span>
        <span class="stamp-distressed -rotate-2">Expedition · 2026</span>
      </div>
    </div>

    <h1 class="display display-xl text-paper">
      <span class="hero-line-1 block">Raus.</span>
      <span class="hero-line-2 block text-orange">Ins Abenteuer.</span>
    </h1>

    <p class="hand-note mt-3 text-2xl sm:text-3xl text-orange">
      // Raus aus der Komfortzone. Rein in den Wald.
    </p>

    <p class="hero-sub mt-6 max-w-md font-mono text-[0.7rem] uppercase leading-relaxed tracking-[0.28em] text-paper/80">
      Zeltlager. Lagerfeuer. Wettkämpfe. Freunde.<br />
      Zehn Tage, die anders sind als alles davor.
    </p>
  </div>

  <div class="hero-scrollhint absolute bottom-8 left-1/2 z-10 -translate-x-1/2 text-center" aria-hidden="true">
    <span class="font-mono text-[0.65rem] uppercase tracking-[0.3em] text-paper/70">Los geht's</span>
    <span class="mt-2 block font-display text-xl text-orange">↓</span>
  </div>

  <div class="absolute bottom-8 left-6 z-10 hidden sm:block">
    <Coordinates value="N 51° 22' 04.8 · E 10° 06' 55.6" />
  </div>

  <div class="absolute bottom-8 right-6 z-10 hidden sm:flex items-center gap-3">
    <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-paper/50">Folge uns:</span>
    <a
      href="https://www.instagram.com/regio.wegweiser/"
      target="_blank"
      rel="noopener noreferrer"
      class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-paper/75 transition-colors hover:text-orange"
    >
      Instagram
    </a>
    <span class="text-paper/30">·</span>
    <a
      href="https://www.facebook.com/regiowegweiser"
      target="_blank"
      rel="noopener noreferrer"
      class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-paper/75 transition-colors hover:text-orange"
    >
      Facebook
    </a>
    <span class="text-paper/30">·</span>
    <a
      href="https://www.youtube.com/channel/UC1BbR9tT5hsZzEzPXbJ7pFw"
      target="_blank"
      rel="noopener noreferrer"
      class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-paper/75 transition-colors hover:text-orange"
    >
      YouTube
    </a>
  </div>
</section>

<script>
  import '../../scripts/animations/hero'
</script>
