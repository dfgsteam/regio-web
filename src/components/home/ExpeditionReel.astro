---
import Container from '../common/Container.astro'
import Eyebrow from '../common/Eyebrow.astro'

const frames = [
  {
    src: '/images/home/reel-01-aufbruch.jpg',
    alt: 'Aufbruch und Wanderung mit Rucksack',
    label: 'Der Aufbruch',
    note: 'Unterwegs auf Pfaden abseits des Alltags',
  },
  {
    src: '/images/home/reel-02-lager.jpg',
    alt: 'Zeltstadt und Schwarzzelte im Wiesental',
    label: 'Das Lager',
    note: 'Zehn Tage Zeltstadt ohne Strom & Handy',
  },
  {
    src: '/images/home/reel-03-feuer.jpg',
    alt: 'Lagerfeuer und Kochen am offenen Feuer',
    label: 'Das Feuer',
    note: 'Funkenflug und Glut unterm Sternenhimmel',
  },
  {
    src: '/images/home/reel-04-gemeinschaft.jpg',
    alt: 'Gemeinschaft am Lagertisch',
    label: 'Die Gemeinschaft',
    note: 'Freundschaften und Zusammenhalt fürs Leben',
  },
  {
    src: '/images/home/reel-05-einsatz.jpg',
    alt: 'Geländespiel und Action im Wald',
    label: 'Der Einsatz',
    note: 'Taktik, Tempo & Teamgeist im Gelände',
  },
  {
    src: '/images/home/reel-06-nacht.jpg',
    alt: 'Nachtwache und Andacht bei Fackelschein',
    label: 'Die Nacht',
    note: 'Fackelschein, Nachtwache & Stille',
  },
]
---

<section id="expedition-reel" class="relative overflow-hidden bg-forest-950 py-24 lg:py-0">
  <div class="lg:hidden">
    <Container class="pb-4">
      <Eyebrow label="Lagerleben & Abenteuer" />
    </Container>
    <div class="flex flex-col gap-10 px-5 pt-8 sm:px-8">
      {
        frames.map((frame) => (
          <figure class="reveal">
            <div class="overflow-hidden border border-paper/15 bg-forest-900">
              <img src={frame.src} alt={frame.alt} loading="lazy" class="aspect-[5/3] w-full object-cover" />
            </div>
            <figcaption class="mt-3 flex flex-col gap-0.5">
              <span class="font-display text-2xl uppercase text-paper">{frame.label}</span>
              <span class="mono-label text-xs text-orange">{frame.note}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>

  <div class="reel-desktop hidden lg:block">
    <Container class="pb-8 pt-20">
      <div class="flex items-end justify-between">
        <Eyebrow label="Lagerleben & Abenteuer" />
      </div>
    </Container>

    <div class="reel-viewport relative overflow-hidden">
      <div class="reel-track flex w-max items-stretch gap-10 px-[8vw]">
        {
          frames.map((frame, index) => (
            <figure class="reel-frame relative w-[52vw] shrink-0 max-w-[860px]">
              <div class="relative overflow-hidden border-2 border-paper/20 bg-forest-900 shadow-2xl">
                <!-- Rough Corner Tape -->
                <div class="texture-tape absolute -top-3 left-6 z-10 h-6 w-24 -rotate-3" aria-hidden="true" />
                <div class="texture-tape absolute -bottom-3 right-6 z-10 h-6 w-24 rotate-2" aria-hidden="true" />
                
                <img src={frame.src} alt={frame.alt} loading="lazy" class="aspect-[5/3] w-full object-cover" />
                
                <span class="stamp-distressed absolute bottom-4 left-4 z-10 -rotate-1 bg-forest-950/90 text-[0.62rem]">
                  Expedition 0{index + 1}
                </span>
              </div>
              <figcaption class="mt-4 flex items-baseline justify-between">
                <span class="font-display text-4xl uppercase text-paper">{frame.label}</span>
                <span class="mono-label text-xs text-orange">{frame.note}</span>
              </figcaption>
            </figure>
          ))
        }

        <figure class="reel-end flex w-[70vw] shrink-0 items-center justify-center">
          <div class="text-center">
            <p class="eyebrow mb-6">Mitten im Geschehen</p>
            <p class="display display-lg text-paper">
              Und du<br />
              <span class="text-orange">mittendrin.</span>
            </p>
          </div>
        </figure>
      </div>
    </div>

    <div class="reel-progress h-1 w-full bg-paper/10">
      <div class="h-full w-full origin-left scale-x-0 bg-orange"></div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/animations/expedition-reel'
</script>
