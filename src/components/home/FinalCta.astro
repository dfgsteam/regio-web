---
import Container from '../common/Container.astro'
import Eyebrow from '../common/Eyebrow.astro'
import Button from '../common/Button.astro'
import Coordinates from '../common/Coordinates.astro'
import BrandIcon from '../common/BrandIcon.astro'

const socialChannels = [
  {
    name: 'WhatsApp Kanal',
    brand: 'whatsapp',
    handle: 'SMJ Regio Wegweiser',
    href: 'https://www.whatsapp.com/channel/0029VaQxDPOF6smxyB2t4519',
    description: 'Offizieller Kanal für Eltern & Teilnehmer. Termine, Packlisten & Live-Updates direkt aufs Smartphone.',
    featured: true,
  },
  {
    name: 'Instagram',
    brand: 'instagram',
    handle: '@regio.wegweiser',
    href: 'https://www.instagram.com/regio.wegweiser/',
    description: 'Fotos, Storys & Live-Eindrücke direkt aus dem Zeltlager und von Wochenenden.',
    featured: false,
  },
  {
    name: 'Facebook',
    brand: 'facebook',
    handle: 'SMJ Regio Wegweiser',
    href: 'https://www.facebook.com/regiowegweiser',
    description: 'Termine, Ankündigungen und Infos für Eltern, Freunde und Unterstützer.',
    featured: false,
  },
  {
    name: 'YouTube',
    brand: 'youtube',
    handle: 'SMJ Wegweiser Kanal',
    href: 'https://www.youtube.com/channel/UC1BbR9tT5hsZzEzPXbJ7pFw',
    description: 'Lagerfilme, Rückblicke und Dokumentationen unserer vergangenen Abenteuer.',
    featured: false,
  },
]
---

<section id="final-cta" class="texture-vignette relative overflow-hidden bg-forest-950 py-28 sm:py-36">
  <div class="absolute inset-0 opacity-40" aria-hidden="true">
    <img src="/images/home/final-cta-valley.jpg" alt="" loading="lazy" class="h-full w-full object-cover" />
    <div class="absolute inset-0 bg-forest-950/60" />
  </div>

  <Container class="relative text-center">
    <Eyebrow label="Das nächste Mal" class="justify-center" />
    <h2 class="display display-xl mt-8 text-paper">
      Nächstes Mal<br />
      <span class="text-orange">bist du dabei.</span>
    </h2>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <Button href="/abenteuer/" variant="primary" size="lg">
        Nächstes Abenteuer ansehen
      </Button>
      <Button href="/kontakt/" variant="ghost" size="lg">
        Fragen? Schreib uns.
      </Button>
    </div>

    <!-- Social Media Strip on Homepage -->
    <div class="mt-20 border-t border-paper/10 pt-16 text-left">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow mb-2">Social Media · Community</p>
          <h3 class="display text-2xl sm:text-3xl text-paper">
            Folge den <span class="text-orange">Wegweisern.</span>
          </h3>
        </div>
        <p class="max-w-md text-xs leading-relaxed text-paper/70">
          Aktuelle Bilder, Storys, WhatsApp-Updates und Videos von unterwegs – folge unseren offiziellen Kanälen:
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          socialChannels.map((channel) => (
            <a
              href={channel.href}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[
                'group flex flex-col justify-between border-2 p-6 transition-all',
                channel.featured
                  ? 'border-green-500/50 bg-forest-900 hover:border-green-500 hover:bg-forest-900'
                  : 'border-paper/15 bg-forest-900/90 hover:border-orange hover:bg-forest-900',
              ]}
            >
              <div>
                <div class="flex items-center justify-between">
                  <BrandIcon
                    name={channel.brand}
                    class:list={[
                      'h-6 w-6 fill-current transition-transform group-hover:scale-110',
                      channel.featured ? 'text-green-400' : 'text-orange',
                    ]}
                  />
                  <span class="font-mono text-xs text-paper/50 transition-colors group-hover:text-orange">↗</span>
                </div>
                <h4 class="display text-xl text-paper mt-4 transition-colors group-hover:text-orange">
                  {channel.name}
                </h4>
                <p class="font-mono text-xs text-orange/90 mt-0.5">{channel.handle}</p>
                <p class="mt-3 text-xs leading-relaxed text-paper/75">{channel.description}</p>
              </div>
              <span class="mono-label mt-6 text-[0.65rem] text-paper/60 transition-colors group-hover:text-paper">
                {channel.featured ? 'Kanal abonnieren →' : 'Zum Profil →'}
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <div class="mt-16 flex justify-center">
      <Coordinates value="N 51° 22' 04.8 · E 10° 06' 55.6" />
    </div>
  </Container>
</section>
