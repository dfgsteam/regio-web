---
import type { CollectionEntry } from 'astro:content'
import Container from '../common/Container.astro'
import Eyebrow from '../common/Eyebrow.astro'
import Button from '../common/Button.astro'
import { getCurrentCamp, getCampRegistration } from '../../lib/camps'

interface Props {
  camp?: CollectionEntry<'camps'>
}

const { camp: propCamp } = Astro.props
const camp = propCamp ?? (await getCurrentCamp())
if (!camp) return null

const { year, motto, date, age, location, theme } = camp.data
const campRegistration = await getCampRegistration(camp.data)
const days = Math.round((date.end.getTime() - date.start.getTime()) / 86_400_000) + 1
const teaserImage = theme.assets.teaser || theme.assets.hero
---

<section
  id="camp-teaser"
  class="camp-theme relative overflow-hidden py-24 sm:py-36 border-t border-paper/10"
  style={`--camp-bg: ${theme.colors.background}; --camp-fg: ${theme.colors.foreground}; --camp-accent: ${theme.colors.accent};`}
>
  <div class="texture-topo absolute inset-0 opacity-60" aria-hidden="true" />

  <Container class="relative">
    <div class="flex flex-col items-start gap-12 lg:flex-row lg:items-center lg:gap-16">
      <!-- Left Column: Info & Facts -->
      <div class="camp-info-col lg:flex-1">
        <div class="flex flex-wrap items-center gap-3">
          <Eyebrow label={`Zeltlager ${year}`} />
          <span class="stamp-distressed -rotate-2">Eichsfeld · Wiesental</span>
        </div>

        <h2 class="display display-lg mt-6 camp-fg">
          Das große<br />
          <span class="camp-accent">Ding.</span>
        </h2>

        <p class="hand-note mt-3 text-2xl sm:text-3xl text-orange">
          // 10 Tage im Wald. Lagerfeuer, Nachtwache & echte Kumpels.
        </p>

        <p class="mt-6 font-mono text-sm uppercase tracking-[0.28em] camp-fg/75">
          {days} Tage. Kein Alltag.
        </p>
        <p class="camp-accent mt-2 font-display text-4xl uppercase sm:text-5xl">
          {motto}
        </p>

        <dl class="mt-10 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] camp-fg">
          <dt class="opacity-60">Datum</dt>
          <dd>{date.start.toLocaleDateString('de-DE')} – {date.end.toLocaleDateString('de-DE')}</dd>
          <dt class="opacity-60">Ort</dt>
          <dd>{location.name}</dd>
          <dt class="opacity-60">Alter</dt>
          <dd>{age.min}–{age.max} Jahre</dd>
        </dl>

        <div class="mt-12 flex flex-wrap gap-4">
          <Button href="/abenteuer/zeltlager/" variant="camp" size="lg">
            Zum Zeltlager
          </Button>
          {campRegistration.state === 'open' && campRegistration.url && (
            <span data-camp-registration data-closes-at={campRegistration.closesAt.toISOString()}>
              <Button href={campRegistration.url} variant="ghost" size="lg">Anmeldung</Button>
            </span>
          )}
          {campRegistration.state === 'full' && <span class="font-mono text-xs font-bold uppercase tracking-wider camp-accent">Ausgebucht</span>}
        </div>
      </div>

      <!-- Right Column: Camp Artwork Teaser -->
      <div class="w-full lg:w-[48%] flex justify-center [perspective:1200px]">
        <a
          href="/abenteuer/zeltlager/"
          class="camp-artwork-card group relative block w-full max-w-md overflow-hidden border-2 camp-border bg-forest-950 shadow-2xl transition-all duration-500 hover:border-camp-accent hover:shadow-[0_20px_50px_rgba(0,0,0,0.8)]"
          aria-label={`Zum Zeltlager ${year} – ${motto}`}
        >
          <!-- Corner Accents -->
          <div class="absolute -top-1 -left-1 w-4 h-4 border-t-2 border-l-2 border-camp-accent z-10 pointer-events-none" />
          <div class="absolute -top-1 -right-1 w-4 h-4 border-t-2 border-r-2 border-camp-accent z-10 pointer-events-none" />
          <div class="absolute -bottom-1 -left-1 w-4 h-4 border-b-2 border-l-2 border-camp-accent z-10 pointer-events-none" />
          <div class="absolute -bottom-1 -right-1 w-4 h-4 border-b-2 border-r-2 border-camp-accent z-10 pointer-events-none" />

          <!-- Artwork Image Container -->
          <div class="relative overflow-hidden aspect-[4/3] sm:aspect-[5/4] bg-forest-950">
            <img
              src={teaserImage}
              alt={`Zeltlager ${year} – ${motto}`}
              loading="lazy"
              class="h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-forest-950/80 via-transparent to-black/20 pointer-events-none" />

            <span class="absolute bottom-4 left-4 bg-[color:var(--camp-bg)]/90 border border-paper/20 px-3.5 py-1.5 font-mono text-[0.65rem] font-bold uppercase tracking-[0.24em] camp-fg">
              Zeltlager {year}
            </span>
          </div>

          <!-- Bottom Action Bar -->
          <div class="p-4 sm:p-5 flex items-center justify-between border-t border-paper/10 bg-forest-950/90">
            <div>
              <p class="font-display text-lg uppercase tracking-wide text-paper group-hover:text-camp-accent transition-colors">
                {motto}
              </p>
              <p class="font-mono text-[0.65rem] uppercase tracking-wider text-paper/60">
                10 Tage Outdoor · Wiesental
              </p>
            </div>
            <span class="font-mono text-xs font-bold uppercase tracking-wider camp-accent group-hover:translate-x-1 transition-transform">
              Entdecken →
            </span>
          </div>
        </a>
      </div>
    </div>
  </Container>
</section>

<script>
  import '../../scripts/animations/camp-unfold'
  import '../../scripts/registration-cutoff'
</script>
