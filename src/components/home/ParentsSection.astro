---
import Container from '../common/Container.astro'
import Eyebrow from '../common/Eyebrow.astro'
import Button from '../common/Button.astro'
import BrandIcon from '../common/BrandIcon.astro'

const questions = [
  {
    title: 'Wer passt auf?',
    answer:
      'Unsere Leiter sind geschult, verantwortlich und selbst in der SMJ groß geworden. Jugend leitet Jugend – mit Rückhalt durch erfahrene Erwachsene.',
  },
  {
    title: 'Dürfen Handys mit?',
    answer:
      'Unsere Lager sind bewusst handyfreie Zonen. Handys bleiben in der sicheren Verwahrung der Lagerleitung. So tauchen die Jungs voll ins echte Leben ein. Für Notfälle ist die Leitung 24/7 telefonisch erreichbar.',
  },
  {
    title: 'Was kostet das Zeltlager?',
    answer:
      'Wir halten die Teilnahmebeiträge so niedrig wie möglich. Bei Geschwistern oder finanziellen Engpässen finden wir immer einen Weg. Kein Junge bleibt aus Kostengründen zu Hause.',
  },
  {
    title: 'Was ist die SMJ eigentlich?',
    answer:
      'Die Schönstatt-Mannesjugend ist eine katholische Jugendgemeinschaft. Wir bieten Jungs Raum für Abenteuer, echte Freundschaft und Persönlichkeitsbildung – offen für alle, ohne Zwang.',
  },
]
---

<section id="eltern" class="texture-paper bg-sand py-24 sm:py-32">
  <Container>
    <Eyebrow label="Für Eltern" muted />
    <h2 class="display display-lg mt-6 text-forest-950">
      Und was sagen<br />
      <span class="text-orange">deine Eltern dazu?</span>
    </h2>

    <p class="hand-note-dark mt-4 text-2xl sm:text-3xl">
      // Keine versteckten Kosten. Volle Transparenz & 24/7 Ansprechpartner.
    </p>

    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {
        questions.map((question, index) => (
          <article class="border-2 border-forest-950/15 bg-paper p-7 sm:p-9">
            <p class="font-mono text-[0.65rem] uppercase tracking-[0.24em] text-muted">
              Frage {String(index + 1).padStart(2, '0')}
            </p>
            <h3 class="display display-sm mt-3 text-forest-950">{question.title}</h3>
            <p class="mt-4 text-sm leading-relaxed text-forest-950/75">{question.answer}</p>
          </article>
        ))
      }
    </div>

    <!-- WhatsApp Channel Direct Parent Hub -->
    <div class="mt-10 border-2 border-forest-950/20 bg-forest-950 p-6 sm:p-8 text-paper flex flex-col md:flex-row items-start md:items-center justify-between gap-6 shadow-xl">
      <div class="flex items-start gap-4">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center border border-green-500/40 bg-green-500/10 text-green-400">
          <BrandIcon name="whatsapp" class="h-6 w-6 fill-current" />
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="inline-block h-2 w-2 rounded-full bg-green-500 animate-pulse"></span>
            <span class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.2em] text-green-400">Direkter Info-Kanal für Eltern & Teilnehmer</span>
          </div>
          <h3 class="display text-xl text-paper mt-1">Immer bestens informiert per WhatsApp</h3>
          <p class="mt-2 text-xs sm:text-sm leading-relaxed text-paper/75 max-w-xl">
            Termine, Packlisten, Abfahrtszeiten und Live-Bilder direkt auf dein Smartphone – 100% datenschutzfreundlich und ohne Werbe-Algorithmen.
          </p>
        </div>
      </div>

      <a
        href="https://www.whatsapp.com/channel/0029VaQxDPOF6smxyB2t4519"
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 inline-flex items-center gap-2 border-2 border-green-500 bg-green-500 px-5 py-3 font-mono text-xs font-bold uppercase tracking-wider text-forest-950 hover:bg-paper hover:border-paper transition-colors shadow-lg"
      >
        <span>WhatsApp-Kanal beitreten</span>
        <span>↗</span>
      </a>
    </div>

    <div class="mt-12 flex flex-wrap items-center gap-6">
      <Button href="/team/" variant="paper" size="lg">
        Das Team kennenlernen
      </Button>
      <a href="/ueber-uns/" class="border-b-2 border-forest-950 pb-1 font-mono text-xs font-bold uppercase tracking-[0.2em] text-forest-950 transition-colors hover:text-orange hover:border-orange">
        Wofür wir stehen →
      </a>
    </div>
  </Container>
</section>
