---
import { Picture } from 'astro:assets'

interface Props {
  src: string | ImageMetadata
  alt: string
  ratio?: string
  class?: string
  loading?: 'lazy' | 'eager'
  caption?: string
  sizes?: string
}

const { src, alt, ratio = '3:2', class: className, loading = 'lazy', caption, sizes = '(min-width: 1024px) 50vw, 100vw' } = Astro.props

const [ratioW, ratioH] = ratio.split(':').map(Number)
---

<figure class:list={['relative overflow-hidden bg-forest-900', className]} style={`aspect-ratio: ${ratioW} / ${ratioH}`}>
  {typeof src === 'string' ? (
    <img src={src} alt={alt} loading={loading} class="h-full w-full object-cover" />
  ) : (
    <Picture
      src={src}
      alt={alt}
      formats={['avif']}
      fallbackFormat="webp"
      widths={[320, 480, 640, 960, 1200]}
      sizes={sizes}
      loading={loading}
      class="h-full w-full object-cover"
      pictureAttributes={{ class: 'absolute inset-0 block h-full w-full' }}
    />
  )}
  <slot />
  {caption && (
    <figcaption class="mono-label absolute bottom-3 left-3 bg-forest-950/70 px-2 py-1 text-[0.6rem]">
      {caption}
    </figcaption>
  )}
</figure>
