---
interface Props {
  variant?: 'icon' | 'full' | 'badge'
  tone?: 'original' | 'theme' | 'monochrome'
  size?: 'sm' | 'md' | 'lg' | 'xl'
  class?: string
}

const {
  variant = 'icon',
  tone = 'theme',
  size = 'md',
  class: className,
} = Astro.props

const sizeClasses = {
  sm: 'h-8 w-auto',
  md: 'h-10 w-auto',
  lg: 'h-14 w-auto',
  xl: 'h-20 w-auto',
}[size]

const colors = {
  original: {
    cross: '#134675',
    sign: '#60A238',
    pole: '#60A238',
    text: '#FFFFFF',
    border: '#FFFFFF',
  },
  theme: {
    cross: 'currentColor',
    sign: '#FF5A1F',
    pole: '#FF5A1F',
    text: '#111713',
    border: '#111713',
  },
  monochrome: {
    cross: 'currentColor',
    sign: 'currentColor',
    pole: 'currentColor',
    text: 'var(--color-forest-950, #111713)',
    border: 'transparent',
  },
}[tone]
---

{variant === 'badge' ? (
  <div class:list={['relative inline-flex items-center justify-center', className]}>
    <svg
      viewBox="0 0 240 240"
      class="h-full w-full max-w-full drop-shadow-md"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-label="SMJ Regio Wegweiser Badge"
    >
      <circle cx="120" cy="120" r="114" stroke="#FF5A1F" stroke-width="2.5" stroke-dasharray="8 4" opacity="0.8" />
      <circle cx="120" cy="120" r="106" stroke="#F1EBDD" stroke-width="1" opacity="0.3" />
      <circle cx="120" cy="120" r="98" fill="#111713" stroke="#F1EBDD" stroke-width="1.5" opacity="0.95" />

      <path id="badge-text-path" d="M 30,120 A 90,90 0 1,1 210,120 A 90,90 0 1,1 30,120" fill="none" />
      <text fill="#F1EBDD" font-family="'Space Mono', monospace" font-size="8.5" font-weight="700" letter-spacing="3.2">
        <textPath href="#badge-text-path" startOffset="50%" text-anchor="middle">
          SMJ REGIO WEGWEISER · EICHSFELD ·
        </textPath>
      </text>

      <g transform="translate(30, 36) scale(0.9)">
        <g fill={tone === 'original' ? colors.cross : '#F1EBDD'} opacity={tone === 'original' ? '1' : '0.85'}>
          <path d="M 74 54 A 48 48 0 0 1 126 54 L 120 64 A 36 36 0 0 0 80 64 Z" />
          <path d="M 146 74 A 48 48 0 0 1 146 126 L 136 120 A 36 36 0 0 0 136 80 Z" />
          <path d="M 126 146 A 48 48 0 0 1 74 146 L 80 136 A 36 36 0 0 0 120 136 Z" />
          <path d="M 54 126 A 48 48 0 0 1 54 74 L 64 80 A 36 36 0 0 0 64 120 Z" />

          <path d="M 88 12 L 112 12 L 112 36 L 106 36 L 106 70 L 94 70 L 94 36 L 88 36 Z" />
          <path d="M 88 188 L 112 188 L 112 164 L 106 164 L 106 130 L 94 130 L 94 164 L 88 164 Z" />
          <path d="M 12 88 L 12 112 L 36 112 L 36 106 L 70 106 L 70 94 L 36 94 L 36 88 Z" />
          <path d="M 188 88 L 188 112 L 164 112 L 164 106 L 130 106 L 130 94 L 164 94 L 164 88 Z" />
        </g>

        <g stroke={tone === 'original' ? '#FFFFFF' : '#111713'} stroke-width="4" stroke-linejoin="round">
          <path d="M 100 16 L 82 48 L 88 48 L 88 74 L 112 74 L 112 48 L 118 48 Z" fill="none" />
          <rect x="94" y="126" width="12" height="66" fill="none" />
          <path d="M 8 100 L 46 72 Q 100 80 154 72 L 192 100 L 154 128 Q 100 120 46 128 Z" fill="none" />
        </g>

        <g fill={colors.sign}>
          <path d="M 100 16 L 82 48 L 88 48 L 88 74 L 112 74 L 112 48 L 118 48 Z" />
          <path d="M 96 52 A 4 4 0 0 1 104 52 L 104 64 L 96 64 Z" fill={tone === 'original' ? '#FFFFFF' : '#111713'} />
          <rect x="95" y="124" width="10" height="68" fill={colors.pole} />
          <path d="M 8 100 L 46 72 Q 100 80 154 72 L 192 100 L 154 128 Q 100 120 46 128 Z" />
        </g>

        <text
          x="100"
          y="106"
          fill={colors.text}
          font-family="system-ui, -apple-system, sans-serif"
          font-weight="800"
          font-size="19"
          text-anchor="middle"
          letter-spacing="0.5"
        >
          WEGWEISER
        </text>
      </g>
    </svg>
  </div>
) : (
  <div class:list={['relative inline-flex items-center gap-3', className]}>
    <svg
      viewBox="0 0 200 200"
      class:list={[sizeClasses, 'shrink-0 drop-shadow-sm']}
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-label="SMJ Regio Wegweiser Logo"
    >
      <g fill={tone === 'original' ? colors.cross : (tone === 'theme' ? '#F1EBDD' : 'currentColor')} opacity={tone === 'original' ? '1' : '0.85'}>
        <path d="M 74 54 A 48 48 0 0 1 126 54 L 120 64 A 36 36 0 0 0 80 64 Z" />
        <path d="M 146 74 A 48 48 0 0 1 146 126 L 136 120 A 36 36 0 0 0 136 80 Z" />
        <path d="M 126 146 A 48 48 0 0 1 74 146 L 80 136 A 36 36 0 0 0 120 136 Z" />
        <path d="M 54 126 A 48 48 0 0 1 54 74 L 64 80 A 36 36 0 0 0 64 120 Z" />

        <path d="M 88 12 L 112 12 L 112 36 L 106 36 L 106 70 L 94 70 L 94 36 L 88 36 Z" />
        <path d="M 88 188 L 112 188 L 112 164 L 106 164 L 106 130 L 94 130 L 94 164 L 88 164 Z" />
        <path d="M 12 88 L 12 112 L 36 112 L 36 106 L 70 106 L 70 94 L 36 94 L 36 88 Z" />
        <path d="M 188 88 L 188 112 L 164 112 L 164 106 L 130 106 L 130 94 L 164 94 L 164 88 Z" />
      </g>

      <g stroke={tone === 'original' ? '#FFFFFF' : '#111713'} stroke-width="4.5" stroke-linejoin="round">
        <path d="M 100 16 L 82 48 L 88 48 L 88 74 L 112 74 L 112 48 L 118 48 Z" fill="none" />
        <rect x="94" y="126" width="12" height="66" fill="none" />
        <path d="M 8 100 L 46 72 Q 100 80 154 72 L 192 100 L 154 128 Q 100 120 46 128 Z" fill="none" />
      </g>

      <g fill={colors.sign}>
        <path d="M 100 16 L 82 48 L 88 48 L 88 74 L 112 74 L 112 48 L 118 48 Z" />
        <path d="M 96 52 A 4 4 0 0 1 104 52 L 104 64 L 96 64 Z" fill={tone === 'original' ? '#FFFFFF' : '#111713'} />
        <rect x="95" y="124" width="10" height="68" fill={colors.pole} />
        <path d="M 8 100 L 46 72 Q 100 80 154 72 L 192 100 L 154 128 Q 100 120 46 128 Z" />
      </g>

      <text
        x="100"
        y="106"
        fill={colors.text}
        font-family="system-ui, -apple-system, sans-serif"
        font-weight="800"
        font-size="19"
        text-anchor="middle"
        letter-spacing="0.5"
      >
        WEGWEISER
      </text>
    </svg>

    {variant === 'full' && (
      <span class="flex flex-col leading-tight">
        <span class="font-mono text-[0.6rem] font-bold uppercase tracking-[0.28em] text-orange">SMJ Regio</span>
        <span class="font-display text-lg uppercase tracking-wider text-paper">Wegweiser</span>
      </span>
    )}
  </div>
)}
