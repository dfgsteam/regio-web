---
interface Props {
  variant?: 'icon' | 'full' | 'badge' | 'stamp' | 'watermark'
  tone?: 'light' | 'white' | 'dark' | 'auto'
  size?: 'sm' | 'md' | 'lg' | 'xl' | '2xl' | 'hero'
  class?: string
}

const {
  variant = 'icon',
  tone = 'light',
  size = 'md',
  class: className,
} = Astro.props

const sizeClasses = {
  sm: 'h-8 w-auto',
  md: 'h-10 w-auto',
  lg: 'h-14 w-auto',
  xl: 'h-18 w-auto',
  '2xl': 'h-20 sm:h-24 md:h-28 w-auto',
  hero: 'h-20 sm:h-28 md:h-36 w-auto',
}[size]

const isDark = tone === 'dark'
const logoSrc = isDark ? '/logo_wegweiser_dark.svg' : '/logo_wegweiser_white.svg'
---

{variant === 'stamp' ? (
  <div class:list={['relative inline-flex items-center justify-center select-none', className]}>
    <div
      class:list={[
        'relative flex flex-col items-center justify-center rounded border-2 border-dashed px-3 py-2 font-mono uppercase tracking-[0.2em] shadow-sm backdrop-blur-xs',
        isDark
          ? 'border-forest-950/70 bg-paper/40 text-forest-950'
          : 'border-orange/70 bg-forest-950/60 text-orange',
      ]}
    >
      <img
        src={logoSrc}
        alt=""
        class:list={[sizeClasses, 'shrink-0 object-contain opacity-95']}
        loading="lazy"
        decoding="async"
      />
      <span class="mt-1.5 font-mono text-[0.55rem] font-bold tracking-[0.25em]">REGIO WEGWEISER</span>
    </div>
  </div>
) : variant === 'watermark' ? (
  <div class:list={['pointer-events-none select-none opacity-10', className]} aria-hidden="true">
    <img
      src={logoSrc}
      alt=""
      class="h-full w-full object-contain"
      loading="lazy"
      decoding="async"
    />
  </div>
) : variant === 'badge' ? (
  <div class:list={['relative inline-flex items-center justify-center', className]}>
    <svg
      viewBox="0 0 240 240"
      class="h-full w-full max-w-full drop-shadow-md"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-label="SMJ Regio Wegweiser Badge"
    >
      <circle cx="120" cy="120" r="114" stroke="#FF5A1F" stroke-width="2.5" stroke-dasharray="8 4" opacity="0.8" />
      <circle cx="120" cy="120" r="106" stroke="#F1EBDD" stroke-width="1" opacity="0.3" />
      <circle cx="120" cy="120" r="98" fill="#111713" stroke="#F1EBDD" stroke-width="1.5" opacity="0.95" />

      <path id="badge-text-path" d="M 30,120 A 90,90 0 1,1 210,120 A 90,90 0 1,1 30,120" fill="none" />
      <text fill="#F1EBDD" font-family="'Space Mono', monospace" font-size="8.5" font-weight="700" letter-spacing="3.2">
        <textPath href="#badge-text-path" startOffset="50%" text-anchor="middle">
          SMJ REGIO WEGWEISER · EICHSFELD ·
        </textPath>
      </text>

      <g transform="translate(48, 48) scale(0.44)">
        <image href="/logo_wegweiser_white.svg" width="328" height="288" />
      </g>
    </svg>
  </div>
) : (
  <div class:list={['relative inline-flex items-center gap-3 sm:gap-4', className]}>
    <img
      src={logoSrc}
      alt="SMJ Regio Wegweiser Logo"
      class:list={[sizeClasses, 'shrink-0 object-contain drop-shadow-sm']}
      loading="eager"
      decoding="async"
    />

    {variant === 'full' && (
      <span class="flex flex-col leading-tight">
        <span class:list={[
          'font-mono font-bold uppercase text-orange',
          size === '2xl' || size === 'hero' ? 'text-[0.75rem] tracking-[0.3em]' : 'text-[0.6rem] tracking-[0.28em]'
        ]}>
          SMJ Regio
        </span>
        <span class:list={[
          'font-display uppercase tracking-wider',
          size === '2xl' || size === 'hero' ? 'text-2xl sm:text-3xl' : 'text-lg',
          isDark ? 'text-forest-950' : 'text-paper'
        ]}>
          Wegweiser
        </span>
      </span>
    )}
  </div>
)}
