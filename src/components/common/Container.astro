---
interface Props {
  size?: 'default' | 'narrow' | 'wide'
  class?: string
}

const { size = 'default', class: className } = Astro.props

const widths = {
  default: 'max-w-6xl',
  narrow: 'max-w-3xl',
  wide: 'max-w-7xl',
}
---

<div class:list={['mx-auto w-full px-5 sm:px-8', widths[size], className]}>
  <slot />
</div>
