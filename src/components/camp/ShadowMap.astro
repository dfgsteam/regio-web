---
import Container from '../common/Container.astro'

const waypoints = [
  { name: 'Basislager Wiesenthal', coords: 'N 51° 22\' 44"', x: 130, y: 310, note: 'Zeltdorf & Feuerstelle' },
  { name: 'Schattenforst', coords: 'N 51° 23\' 50"', x: 320, y: 220, note: 'Geländespiel-Areal' },
  { name: 'Glutschlucht', coords: 'N 51° 25\' 10"', x: 520, y: 280, note: 'Späherposten' },
  { name: 'Hohe Wacht', coords: 'N 51° 26\' 15"', x: 680, y: 130, note: 'Nachtwache' },
  { name: 'Das Bundesfeuer', coords: 'N 51° 27\' 00"', x: 800, y: 200, note: 'Abschlusskreis' },
]
---

<section id="shadow-map-section" class="camp-bg py-16 sm:py-24 border-t camp-border">
  <Container>
    <div class="flex flex-wrap items-end justify-between gap-6 mb-10">
      <div>
        <p class="eyebrow mb-2">Nachtmission & Späherkarte</p>
        <h2 class="display display-md camp-fg">Die geheime Karte des Wiesenthals.</h2>
      </div>
      <div class="inline-flex items-center gap-2 border border-orange/40 bg-forest-950 px-4 py-2 font-mono text-xs text-orange">
        <span>🔦 Fackelkegel aktiv (Scrollen oder Maus bewegen)</span>
      </div>
    </div>

    <div class="relative overflow-hidden border-2 camp-border bg-forest-950 p-6 sm:p-10 shadow-2xl">
      <svg viewBox="0 0 920 440" class="h-auto w-full cursor-crosshair select-none" role="img" aria-label="Karte des Zeltlagergeländes mit interaktivem Fackelkegel">
        <defs>
          <!-- Dynamic Torchlight Spotlight Gradient -->
          <radialGradient id="torch-gradient" cx="130" cy="310" r="170" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#FF9A24" stop-opacity="0.85" />
            <stop offset="35%" stop-color="#FF5A1F" stop-opacity="0.5" />
            <stop offset="65%" stop-color="#D73B17" stop-opacity="0.2" />
            <stop offset="100%" stop-color="#000000" stop-opacity="0" />
          </radialGradient>

          <!-- Torchlight Mask -->
          <mask id="torch-mask">
            <rect width="920" height="440" fill="#222222" />
            <circle id="torch-glow-circle" cx="130" cy="310" r="170" fill="url(#torch-gradient)" />
          </mask>
        </defs>

        <!-- Background Ambient Map Grid & Contours -->
        <g fill="none" stroke="var(--camp-fg)" stroke-opacity="0.08" stroke-width="1.5">
          <ellipse cx="460" cy="220" rx="90" ry="60" />
          <ellipse cx="460" cy="220" rx="190" ry="120" />
          <ellipse cx="460" cy="220" rx="310" ry="190" />
          <ellipse cx="460" cy="220" rx="430" ry="260" />
          <ellipse cx="250" cy="140" rx="140" ry="90" />
          <ellipse cx="700" cy="300" rx="170" ry="100" />
        </g>

        <!-- Secret Trail & Connecting Path -->
        <path
          d="M130 310 Q 230 270 320 220 T 520 280 T 680 130 T 800 200"
          fill="none"
          stroke="var(--camp-accent)"
          stroke-width="3"
          stroke-linecap="round"
          stroke-dasharray="4 8"
          opacity="0.7"
        />

        <!-- Waypoints & Markers -->
        {
          waypoints.map((point, index) => (
            <g class="waypoint-node">
              <circle
                cx={point.x}
                cy={point.y}
                r="11"
                fill="var(--camp-bg)"
                stroke="var(--camp-accent)"
                stroke-width="3"
              />
              <circle cx={point.x} cy={point.y} r="4" fill="var(--camp-accent)" />

              <text
                x={point.x + (point.x > 700 ? -18 : 18)}
                y={point.y - 12}
                text-anchor={point.x > 700 ? 'end' : 'start'}
                font-family="'Anton', sans-serif"
                font-size="17"
                fill="var(--camp-fg)"
                letter-spacing="1"
              >
                0{index + 1} {point.name}
              </text>
              <text
                x={point.x + (point.x > 700 ? -18 : 18)}
                y={point.y + 7}
                text-anchor={point.x > 700 ? 'end' : 'start'}
                font-family="'Space Mono', monospace"
                font-size="11"
                fill="var(--camp-accent)"
                letter-spacing="1.5"
              >
                {point.coords} · {point.note}
              </text>
            </g>
          ))
        }

        <!-- Torchlight Spotlight Overlay (Adds warm light glow on revealed area) -->
        <circle
          id="torch-center-beam"
          cx="130"
          cy="310"
          r="160"
          fill="url(#torch-gradient)"
          style="mix-blend-mode: screen; pointer-events: none;"
        />

        <!-- Kompassrose -->
        <g transform="translate(830, 70)">
          <circle r="30" fill="none" stroke="var(--camp-fg)" stroke-opacity="0.25" stroke-width="1.5" />
          <path d="M0 -22 L 6 0 L 0 22 L -6 0 Z" fill="var(--camp-accent)" />
          <path d="M-22 0 L 0 -6 L 22 0 L 0 6 Z" fill="var(--camp-fg)" opacity="0.5" />
          <text y="-36" text-anchor="middle" font-family="'Space Mono', monospace" font-size="12" fill="var(--camp-fg)" letter-spacing="2">
            N
          </text>
        </g>

        <!-- Massstab -->
        <g font-family="'Space Mono', monospace" font-size="10" fill="var(--camp-fg)" opacity="0.6">
          <line x1="60" y1="400" x2="160" y2="400" stroke="var(--camp-fg)" stroke-width="1.5" />
          <line x1="60" y1="394" x2="60" y2="406" stroke="var(--camp-fg)" stroke-width="1.5" />
          <line x1="160" y1="394" x2="160" y2="406" stroke="var(--camp-fg)" stroke-width="1.5" />
          <text x="60" y="418">0 KM</text>
          <text x="135" y="418">5 KM</text>
        </g>
      </svg>

      <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-paper/10 pt-4">
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] camp-fg/70">
          🔦 Tipp: Bewege die Maus oder deinen Finger über die Karte, um geheime Pfade zu beleuchten.
        </p>
        <span class="mono-label text-[0.68rem] text-orange">Nachtwache · 08.–17. Juli 2026</span>
      </div>
    </div>
  </Container>
</section>

<script>
  import '../../scripts/animations/torchlight'
</script>
