---
import Container from '../common/Container.astro'

const waypoints = [
  { name: 'Basislager', coords: 'N 51° 22\' 44"', x: 14, y: 78 },
  { name: 'Grenzfluss', coords: 'N 51° 24\' 02"', x: 36, y: 55 },
  { name: 'Nebelpass', coords: 'N 51° 25\' 31"', x: 58, y: 34 },
  { name: 'Verlorenes Tal', coords: 'N 51° 27\' 09"', x: 82, y: 18 },
]
---

<section class="camp-bg py-16 sm:py-24">
  <Container>
    <p class="eyebrow mb-4">Die Route</p>
    <h2 class="display display-md camp-fg mb-10">Zehn Tage durch unbekanntes Land.</h2>

    <div class="relative overflow-hidden border camp-border bg-forest-950/60 p-6 sm:p-10">
      <svg viewBox="0 0 900 420" class="h-auto w-full" role="img" aria-label="Karte der Expeditionsroute mit vier Stationen">
        <!-- Topo hintergrund -->
        <g fill="none" stroke="var(--camp-fg)" stroke-opacity="0.08" stroke-width="1.5">
          <ellipse cx="450" cy="210" rx="60" ry="45" />
          <ellipse cx="450" cy="210" rx="130" ry="95" />
          <ellipse cx="450" cy="210" rx="210" ry="150" />
          <ellipse cx="450" cy="210" rx="300" ry="210" />
          <ellipse cx="450" cy="210" rx="410" ry="280" />
        </g>

        <!-- Route -->
        <path
          d="M126 328 C 180 300, 220 280, 324 231 C 400 194, 430 190, 522 143 C 590 110, 660 96, 738 76"
          fill="none"
          stroke="var(--camp-accent)"
          stroke-width="3.5"
          stroke-linecap="round"
          stroke-dasharray="2 10"
        />
        <circle cx="126" cy="328" r="10" fill="var(--camp-bg)" stroke="var(--camp-accent)" stroke-width="3" />
        <circle cx="738" cy="76" r="13" fill="var(--camp-accent)" />

        <!-- Waypoints -->
        {
          waypoints.map((point) => (
            <g>
              <circle cx={point.x * 9} cy={point.y * 4.2} r="7" fill="var(--camp-bg)" stroke="var(--camp-accent)" stroke-width="2.5" />
              <text x={point.x * 9 + 14} y={point.y * 4.2 + 4} font-family="'Space Mono', monospace" font-size="15" fill="var(--camp-fg)" letter-spacing="3">
                {point.name}
              </text>
              <text x={point.x * 9 + 14} y={point.y * 4.2 + 22} font-family="'Space Mono', monospace" font-size="11" fill="var(--camp-fg)" opacity="0.55" letter-spacing="2">
                {point.coords}
              </text>
            </g>
          ))
        }

        <!-- Skala -->
        <g font-family="'Space Mono', monospace" font-size="11" fill="var(--camp-fg)" opacity="0.5">
          <line x1="60" y1="380" x2="160" y2="380" stroke="var(--camp-fg)" stroke-width="1.5" />
          <text x="60" y="398">0</text>
          <text x="130" y="398">10 KM</text>
        </g>
      </svg>

      <p class="mt-4 text-center font-mono text-[0.65rem] uppercase tracking-[0.3em] camp-fg/60">
        Feldnote: Die Karte ist unvollständig. Absichtlich.
      </p>
    </div>
  </Container>
</section>
