---
import { resolveCampForUrl } from '../../lib/camps'
import FieldNote from '../common/FieldNote.astro'

interface Props {
  quote?: string
}

const camp = await resolveCampForUrl(Astro.url.pathname)
if (!camp) return null

const { motto, story, year } = camp.data
const { quote } = Astro.props

const defaultQuote =
  year === 2027
    ? 'Eine Legende. Drei Felsen. Ein verborgenes Geheimnis.'
    : 'Zehn Tage, die anders sind als alles davor.'

const noteQuote = quote ?? defaultQuote
const paragraphs = story ? story.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean) : []
---

<section class="camp-bg overflow-x-clip py-16 sm:py-24 border-t camp-border">
  <div class="mx-auto grid w-full max-w-6xl items-start gap-12 px-5 sm:px-8 lg:grid-cols-[1.2fr_1fr]">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.25em] camp-accent font-bold mb-3">
        // DAS LAGERMOTTO · {year}
      </p>
      <h2 class="display display-lg camp-fg uppercase">{motto}</h2>
      {paragraphs.length > 0 && (
        <div class="prose-rough mt-8 max-w-2xl space-y-4 text-base sm:text-lg leading-relaxed" style="color: color-mix(in oklab, var(--camp-fg) 85%, transparent)">
          {paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      )}
    </div>
    <FieldNote meta={`FIELD NOTE · ${year}`} rotate="2deg" class="w-[calc(100%-1rem)] justify-self-start lg:mt-10 lg:w-auto">
      {noteQuote}
    </FieldNote>
  </div>
</section>
