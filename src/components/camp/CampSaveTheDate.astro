---
import Container from '../common/Container.astro'
import { Calendar, Sparkles, Clock, ArrowRight, ShieldCheck } from '@lucide/astro'
import { resolveCampForUrl } from '../../lib/camps'
import { formatDateRange } from '../../lib/events'

const camp = await resolveCampForUrl(Astro.url.pathname)
if (!camp) return null

const { date } = camp.data
const dateLabel = formatDateRange(date.start, date.end)
---

<section id="save-the-date" class="camp-bg relative py-16 sm:py-24 border-t camp-border overflow-hidden">
  <!-- Topographic ambient texture -->
  <div class="texture-topo absolute inset-0 opacity-20 pointer-events-none" aria-hidden="true" />

  <Container class="relative">
    <div class="max-w-3xl mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 border border-[color:var(--camp-accent)]/40 bg-[color:var(--camp-bg)] px-3 py-1 font-mono text-xs uppercase tracking-widest camp-accent mb-4">
        <Calendar class="h-3.5 w-3.5" />
        <span>Terminvormerkung · Zeltlager 2028</span>
      </div>

      <h2 class="display text-3xl sm:text-5xl md:text-6xl camp-fg tracking-tight uppercase leading-[1.05]">
        Zehn Tage draußen.<br />
        <span class="camp-accent">Termin jetzt vormerken.</span>
      </h2>

      <p class="mt-5 text-sm sm:text-base leading-relaxed text-paper/80 font-sans max-w-2xl">
        Für die Urlaubsplanung aller Familien steht der Zeitraum für unser großes Sommerzeltlager 2028 bereits fest: 
        Vom <strong>{dateLabel}</strong> schlagen wir im Wiesental bei Thalwenden wieder unsere Zelte auf. 
        Zehn Tage ohne Bildschirm, dafür mit echter Gemeinschaft, Lagerfeuer und Abenteuern im Wald.
      </p>
    </div>

    <!-- 3 Key Info Blocks for Parents -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      <!-- Card 1: Fixed Dates -->
      <article class="border-2 camp-border bg-forest-950/60 p-6 sm:p-8 flex flex-col justify-between relative">
        <div>
          <div class="flex items-center justify-between border-b camp-border pb-4 mb-5">
            <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] camp-accent">
              01 · Urlaubsplanung
            </span>
            <Calendar class="h-4 w-4 camp-accent" />
          </div>
          <h3 class="font-display text-xl sm:text-2xl camp-fg uppercase">
            {dateLabel}
          </h3>
          <p class="mt-3 text-xs sm:text-sm leading-relaxed text-paper/75 font-sans">
            Zehn Tage mitten in den Sommerferien auf unserem traditionellen Zeltplatz bei Thalwenden. So können Eltern und Familien ihren Sommerurlaub frühzeitig und verlässlich darauf abstimmen.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t camp-border flex items-center gap-2 font-mono text-[0.68rem] text-paper/60 uppercase tracking-wider">
          <Clock class="h-3.5 w-3.5 text-orange" />
          <span>Sommerferien 2028</span>
        </div>
      </article>

      <!-- Card 2: Theme in Development -->
      <article class="border-2 camp-border bg-forest-950/60 p-6 sm:p-8 flex flex-col justify-between relative">
        <div>
          <div class="flex items-center justify-between border-b camp-border pb-4 mb-5">
            <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] camp-accent">
              02 · Motto & Story
            </span>
            <Sparkles class="h-4 w-4 camp-accent" />
          </div>
          <h3 class="font-display text-xl sm:text-2xl camp-fg uppercase">
            Motto in Vorbereitung
          </h3>
          <p class="mt-3 text-xs sm:text-sm leading-relaxed text-paper/75 font-sans">
            Wie jedes Zeltlager wird auch 2028 von einer eigenen packenden Spielhandlung begleitet. Unser Leitungsteam erarbeitet das Lagermotto in den kommenden Monaten – sobald das Thema steht, wird diese Seite mit Plakat und allen Details aktualisiert.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t camp-border flex items-center gap-2 font-mono text-[0.68rem] text-paper/60 uppercase tracking-wider">
          <Sparkles class="h-3.5 w-3.5 text-orange" />
          <span>Wird rechtzeitig enthüllt</span>
        </div>
      </article>

      <!-- Card 3: Registration Timeline -->
      <article class="border-2 camp-border bg-forest-950/60 p-6 sm:p-8 flex flex-col justify-between relative">
        <div>
          <div class="flex items-center justify-between border-b camp-border pb-4 mb-5">
            <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] camp-accent">
              03 · Anmeldestart
            </span>
            <ShieldCheck class="h-4 w-4 camp-accent" />
          </div>
          <h3 class="font-display text-xl sm:text-2xl camp-fg uppercase">
            Startet Anfang 2028
          </h3>
          <p class="mt-3 text-xs sm:text-sm leading-relaxed text-paper/75 font-sans">
            Die reguläre Online-Anmeldung öffnet rechtzeitig im Vorfeld des Zeltlagers. Der Teilnahmebeitrag wird sich im gewohnten Rahmen (ca. 189 € inkl. Vollverpflegung und Betreuung) bewegen.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t camp-border flex items-center gap-2 font-mono text-[0.68rem] text-paper/60 uppercase tracking-wider">
          <ShieldCheck class="h-3.5 w-3.5 text-orange" />
          <span>Jugend leitet Jugend</span>
        </div>
      </article>
    </div>

    <!-- Parent Action Banner -->
    <div class="mt-10 border-2 camp-border bg-forest-950/90 p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="max-w-xl">
        <h4 class="font-display text-lg sm:text-xl camp-fg uppercase">
          Termin jetzt im Familienkalender sichern
        </h4>
        <p class="mt-1 text-xs sm:text-sm text-paper/70 font-sans leading-relaxed">
          Abonniere unseren Terminkalender oder lade den Termin direkt in deinen Kalender (Google, Apple, Outlook), um keine Neuigkeiten zu verpassen.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
        <a
          href="/api/calendar.ics"
          class="inline-flex items-center justify-center gap-2 border-2 border-[color:var(--camp-accent)] bg-[color:var(--camp-accent)] px-5 py-3 font-mono text-xs font-bold uppercase tracking-wider text-forest-950 transition-all hover:bg-paper hover:border-paper hover:text-forest-950 text-center"
        >
          <Calendar class="h-4 w-4" />
          <span>Termin herunterladen (.ics)</span>
        </a>

        <a
          href="/abenteuer/zeltlager-2027/"
          class="inline-flex items-center justify-center gap-2 border border-paper/30 bg-transparent px-5 py-3 font-mono text-xs font-bold uppercase tracking-wider text-paper transition-all hover:bg-paper/10 hover:border-paper text-center"
        >
          <span>Zeltlager 2027 ansehen</span>
          <ArrowRight class="h-4 w-4" />
        </a>
      </div>
    </div>
  </Container>
</section>
