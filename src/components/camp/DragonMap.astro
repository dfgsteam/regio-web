---
import Container from '../common/Container.astro'
import { Compass } from '@lucide/astro'

const waypoints = [
  { id: 'pforte', name: '01 Torii-Pforte', coords: 'N 51° 22\' 04.8"', x: 120, y: 320, note: 'Eingang ins Tal · Handy-Abgabe & Aufbruch' },
  { id: 'zeltdorf', name: '02 Zeltdorf der Drachenwacht', coords: 'N 51° 22\' 30"', x: 280, y: 220, note: 'Basislager · Jurten, Küchenfeuer & Fahnenmast' },
  { id: 'felsen', name: '03 Die Drei Felsen', coords: 'N 51° 23\' 15"', x: 490, y: 150, note: 'Sandstein-Massiv · Klettern & alte Siegel' },
  { id: 'schlucht', name: '04 Schlucht der Flüsternden Winde', coords: 'N 51° 23\' 45"', x: 670, y: 270, note: 'Geländespiel-Areal · Nachtmissionen & Tarnung' },
  { id: 'schrein', name: '05 Schrein des Bundesfeuers', coords: 'N 51° 24\' 10"', x: 810, y: 170, note: 'Heiliger Kreis · Nachtwache & Bundesfeuer' },
]
---

<section id="dragon-map-section" class="camp-bg py-16 sm:py-24 border-t camp-border relative overflow-hidden">
  <Container>
    <div class="flex flex-wrap items-end justify-between gap-6 mb-10">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.25em] text-[#E62E2D] font-bold">
          // KARTIERUNG WIESENTHAL
        </p>
        <h2 class="display text-3xl sm:text-5xl mt-2 camp-fg uppercase">
          Die Karte des Drachentals.
        </h2>
      </div>

      <div class="inline-flex items-center gap-2 border border-[#E62E2D]/40 bg-[#090D12] px-4 py-2 font-mono text-xs text-paper">
        <Compass class="h-4 w-4 text-[#E62E2D]" />
        <span>Geländekarte Thalwenden · 5 Stationen</span>
      </div>
    </div>

    <!-- Map Board -->
    <div class="relative overflow-hidden border-2 border-paper/15 bg-[#090D12] p-4 sm:p-8 shadow-2xl">
      <!-- Background Torii Watermark -->
      <div class="absolute right-4 bottom-4 opacity-5 pointer-events-none select-none" aria-hidden="true">
        <svg viewBox="0 0 100 80" class="h-64 w-80 text-white fill-current">
          <path d="M5 10 C 30 0, 70 0, 95 10 L 92 18 C 70 12, 30 12, 8 18 Z" />
          <rect x="15" y="24" width="70" height="6" />
          <rect x="25" y="10" width="8" height="65" />
          <rect x="67" y="10" width="8" height="65" />
        </svg>
      </div>

      <!-- SVG Map Display -->
      <svg
        viewBox="0 0 920 440"
        class="h-auto w-full select-none"
        role="img"
        aria-label="Karte des Zeltlagers 2027 im Wiesental"
      >
        <defs>
          <!-- Gradient for Dragon Path -->
          <linearGradient id="dragon-path-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#E62E2D" stop-opacity="0.9" />
            <stop offset="50%" stop-color="#FF5A1F" stop-opacity="0.9" />
            <stop offset="100%" stop-color="#E62E2D" stop-opacity="0.9" />
          </linearGradient>
        </defs>

        <!-- Topographic Contour Lines -->
        <g fill="none" stroke="var(--camp-fg)" stroke-opacity="0.08" stroke-width="1.5">
          <ellipse cx="460" cy="220" rx="100" ry="60" />
          <ellipse cx="460" cy="220" rx="220" ry="130" />
          <ellipse cx="460" cy="220" rx="350" ry="200" />
          <ellipse cx="460" cy="220" rx="440" ry="260" />
          <ellipse cx="220" cy="140" rx="130" ry="80" />
          <ellipse cx="720" cy="310" rx="150" ry="90" />
        </g>

        <!-- Connecting Dragon Trail -->
        <path
          d="M120 320 Q 200 280 280 220 T 490 150 T 670 270 T 810 170"
          fill="none"
          stroke="url(#dragon-path-gradient)"
          stroke-width="3"
          stroke-dasharray="6 8"
        />

        <!-- Waypoint Nodes -->
        {
          waypoints.map((point) => (
            <g class="cursor-pointer group" transform={`translate(${point.x}, ${point.y})`}>
              <!-- Outer Pulse Ring -->
              <circle r="16" fill="none" stroke="#E62E2D" stroke-width="1.5" opacity="0.3" class="animate-ping" style="animation-duration: 3s;" />
              <!-- Core Marker -->
              <circle r="8" fill="#090D12" stroke="#E62E2D" stroke-width="3" />
              <circle r="3" fill="#E62E2D" />

              <!-- Label Box -->
              <g transform="translate(18, -12)">
                <rect x="-4" y="-12" width="220" height="34" fill="#090D12" fill-opacity="0.85" stroke="var(--camp-fg)" stroke-opacity="0.15" stroke-width="1" />
                <text font-family="'Anton', sans-serif" font-size="14" fill="var(--camp-fg)" letter-spacing="1">
                  {point.name}
                </text>
                <text y="14" font-family="'Space Mono', monospace" font-size="9" fill="#E62E2D" letter-spacing="1">
                  {point.coords}
                </text>
              </g>
            </g>
          ))
        }

        <!-- Scale & Compass -->
        <g transform="translate(60, 400)" font-family="'Space Mono', monospace" font-size="10" fill="var(--camp-fg)" opacity="0.5">
          <line x1="0" y1="0" x2="100" y2="0" stroke="var(--camp-fg)" stroke-width="1.5" />
          <line x1="0" y1="-4" x2="0" y2="4" stroke="var(--camp-fg)" stroke-width="1.5" />
          <line x1="100" y1="-4" x2="100" y2="4" stroke="var(--camp-fg)" stroke-width="1.5" />
          <text x="0" y="16">0</text>
          <text x="80" y="16">1000 M</text>
        </g>
      </svg>

      <!-- Waypoint Detail Cards (Mobile & Desktop Accessible List) -->
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 pt-6 border-t border-paper/10">
        {
          waypoints.map((pt) => (
            <div class="border border-paper/10 bg-[#090D12]/60 p-4">
              <span class="font-mono text-[0.65rem] uppercase text-[#E62E2D] font-bold block">
                {pt.coords}
              </span>
              <h4 class="font-display text-lg text-paper uppercase mt-0.5">
                {pt.name}
              </h4>
              <p class="font-sans text-xs text-paper/70 mt-1">
                {pt.note}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</section>
