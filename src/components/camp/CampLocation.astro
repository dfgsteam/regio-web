---
import Container from '../common/Container.astro'
import Eyebrow from '../common/Eyebrow.astro'
import PrivacyMap from '../common/PrivacyMap.astro'
---

<section class="camp-bg border-t camp-border py-20">
  <Container>
    <div class="grid gap-12 lg:grid-cols-[1fr_1.3fr] lg:items-center">
      <div>
        <Eyebrow label="Lagerplatz & Anfahrt" />
        <h2 class="display display-md mt-4 camp-fg">
          Das Wiesental<br />
          <span class="camp-accent">bei Thalwenden.</span>
        </h2>

        <p class="mt-6 text-sm leading-relaxed camp-fg/80">
          Unser traditioneller Zeltlagerplatz liegt idyllisch und abgelegen zwischen bewaldeten Hängen und Sandsteinfelsen im Wiesental bei Thalwenden (Gemeinde Uder im Eichsfeld).
        </p>

        <div class="mt-8 space-y-4 border-l-2 border-orange pl-5">
          <div>
            <p class="mono-label text-xs">Genaue Adresse für Anfahrt & Navi</p>
            <p class="mt-1 font-display text-lg camp-fg">
              Birkenfelder Str.<br />
              37318 Uder (Ortsteil Thalwenden)
            </p>
          </div>
          <div>
            <p class="mono-label text-xs">Koordinaten</p>
            <p class="mt-1 font-mono text-sm camp-fg/80">
              N 51° 22' 04.8" · E 10° 06' 55.6"
            </p>
          </div>
        </div>

        <p class="mt-6 font-mono text-xs text-paper/60">
          * Ausgeschilderte Zufahrt ab Ortseingang Thalwenden. Parkmöglichkeiten für Eltern bei Anreise und Abreise sind vor Ort eingerichtet.
        </p>
      </div>

      <PrivacyMap
        title="Zeltlagerplatz Wiesental"
        address="Birkenfelder Str., 37318 Uder (Ortsteil Thalwenden)"
        coordinates="N 51° 22' 04.8'' · E 10° 06' 55.6''"
        mapQuery="Wiesental Thalwenden"
        ratio="4/3"
      />
    </div>
  </Container>
</section>
