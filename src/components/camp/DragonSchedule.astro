---
import Container from '../common/Container.astro'
import { Calendar, Tent, Compass, Trophy, Flame, Sparkles } from '@lucide/astro'

const highlights = [
  {
    number: '01',
    title: 'Lagerbau & Zeltstadt errichten',
    subtitle: 'Aus Stangen, Planen und Seilen ein Zuhause schaffen',
    summary:
      'Gleich zu Beginn packen alle mit an: Gemeinsam errichten wir unser Basislager im Wiesental. Jurten und Mannschaftszelte aufbauen, das traditionelle Lagertor zimmern, den Fahnenmast stellen und Feuerstellen anlegen.',
    pillar: 'Gemeinschaft & Lebensschule',
    tags: ['Lagerbau', 'Teamwork', 'Outdoor-Handwerk'],
    icon: Tent,
  },
  {
    number: '02',
    title: 'Lager-Olympiade & Geländespiele',
    subtitle: 'Wettkampf, Taktik und Mut im Gelände',
    summary:
      'Sport, Teamgeist und fairer Wettstreit: Bei der großen Lager-Olympiade messen wir uns in Parkour-Staffeln, Speerweitwurf, Ringen und Wikingerschach. Dazu kommen packende Geländespiele im Wald rund um die Sandsteinfelsen.',
    pillar: 'Mann sein & Lebensschule',
    tags: ['Olympiade', 'Geländespiel', 'Fairness'],
    icon: Trophy,
  },
  {
    number: '03',
    title: 'Der große 2-Tages-Haijk',
    subtitle: 'Orientierung nach Karte & Kompass mit Biwak',
    summary:
      'Eines der größten Highlights: In kleinen Zeltgruppen packen wir die Rucksäcke für eine 2-Tages-Wanderung durch die unberührte Natur des Eichsfelds. Kochen auf dem Gaskocher und Übernachten unter freiem Sternenhimmel inklusive.',
    pillar: 'Lebensschule & Liebesbündnis',
    tags: ['2-Tage-Tour', 'Orientierung', 'Biwak'],
    icon: Compass,
  },
  {
    number: '04',
    title: 'Turnier, Casinoabend & Schwimmbad',
    subtitle: 'Klassiker für Spaß, Abkühlung und Zockerei',
    summary:
      'Der legendäre Fußball-Klassiker: Jungs gegen die Leiterrunde auf dem Bolzplatz! Zur Erholung und Erfrischung geht es ins Schwimmbad, und abends verwandelt sich das Großzelt in ein stilechtes Casino mit bunten Spieltischen.',
    pillar: 'Gemeinschaft & Mann sein',
    tags: ['Fußballturnier', 'Schwimmbad', 'Casinoabend'],
    icon: Sparkles,
  },
  {
    number: '05',
    title: 'Nachtwache & Das Große Bundesfeuer',
    subtitle: 'Lagerfeuerrunden, Zeltlagermesse & Abschlussfest',
    summary:
      'Nachts am Wachfeuer sitzen und auf das Lager aufpassen, eine feierliche Zeltlagermesse unter offenem Himmel erleben, die Zeltlager-Abzeichen empfangen und das gigantische Bundesfeuer entzünden, das bis tief in die Nacht lodert.',
    pillar: 'Apostel sein & Liebesbündnis',
    tags: ['Nachtwache', 'Bundesfeuer', 'Zeltlagermesse'],
    icon: Flame,
  },
]
---

<section id="dragon-schedule" class="camp-bg relative py-20 sm:py-28 overflow-hidden border-t camp-border">
  <Container class="relative">
    <!-- Header -->
    <div class="max-w-3xl mb-14 sm:mb-16">
      <div class="flex items-center gap-2 mb-3">
        <span class="font-mono text-xs uppercase tracking-[0.25em] text-[#E62E2D] font-bold">
          // PROGRAMM-HIGHLIGHTS · ZELTLAGER 2027
        </span>
      </div>
      <h2 class="display text-3xl sm:text-5xl md:text-6xl camp-fg tracking-tight uppercase">
        Was dich im Tal<br />
        <span class="text-[#E62E2D]">des Drachen erwartet.</span>
      </h2>
      <p class="mt-4 font-mono text-xs sm:text-sm text-paper/70 uppercase tracking-widest leading-relaxed">
        Zehn Tage draußen im Wiesental. Der genaue Tagesablauf wird wie jedes Jahr vom Leiterteam finalisiert – auf diese 5 großen Säulen kannst du dich jetzt schon freuen:
      </p>
    </div>

    <!-- 5 Highlights Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        highlights.map((item, index) => {
          const Icon = item.icon
          const isLarge = index === 0 || index === 4
          return (
            <div
              class:list={[
                'relative flex flex-col justify-between border-2 border-paper/15 bg-[#090D12]/90 p-6 sm:p-7 hover:border-[#E62E2D]/60 transition-all duration-300 group',
                isLarge ? 'md:col-span-2 lg:col-span-1' : '',
              ]}
            >
              <div>
                <!-- Top Row: Number & Icon -->
                <div class="flex items-center justify-between border-b border-paper/10 pb-4 mb-5">
                  <span class="font-display text-3xl text-paper/40 group-hover:text-[#E62E2D] transition-colors">
                    {item.number}
                  </span>
                  <div class="bg-[#E62E2D]/15 text-[#E62E2D] p-2.5 border border-[#E62E2D]/30 group-hover:bg-[#E62E2D] group-hover:text-paper transition-all">
                    <Icon class="h-5 w-5" />
                  </div>
                </div>

                <!-- Title & Subtitle -->
                <h3 class="font-display text-xl sm:text-2xl text-paper uppercase tracking-wide group-hover:text-[#E62E2D] transition-colors">
                  {item.title}
                </h3>
                <p class="font-mono text-xs text-orange mt-1 tracking-wider uppercase">
                  {item.subtitle}
                </p>

                <!-- Summary -->
                <p class="mt-4 text-xs sm:text-sm leading-relaxed text-paper/80 font-sans">
                  {item.summary}
                </p>

                <!-- Tags -->
                <div class="mt-5 flex flex-wrap gap-2">
                  {item.tags.map((tag) => (
                    <span class="border border-paper/15 px-2 py-0.5 font-mono text-[0.62rem] uppercase tracking-wider text-paper/60">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Footer: Pillar -->
              <div class="mt-6 pt-3 border-t border-paper/10 flex items-center justify-between">
                <span class="font-mono text-[0.62rem] uppercase tracking-wider text-paper/40">
                  Säule:
                </span>
                <span class="font-mono text-[0.62rem] font-bold uppercase tracking-wider text-[#E62E2D] bg-[#E62E2D]/10 px-2 py-0.5 border border-[#E62E2D]/20">
                  {item.pillar}
                </span>
              </div>
            </div>
          )
        })
      }
    </div>

    <!-- Parent / General Note Callout -->
    <div class="mt-12 border-2 border-paper/15 bg-[#090D12] p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div class="flex items-start gap-4">
        <div class="bg-[#E62E2D]/20 text-[#E62E2D] p-3 border border-[#E62E2D]/40 flex-shrink-0">
          <Calendar class="h-6 w-6" />
        </div>
        <div>
          <h4 class="font-display text-lg sm:text-xl text-paper uppercase">
            Flexible Programmgestaltung
          </h4>
          <p class="font-sans text-xs sm:text-sm text-paper/70 mt-1 max-w-2xl leading-relaxed">
            Diese 5 Programmpunkte bilden den bewährten Kern unseres Zeltlagers. Die genauen Tage und Uhrzeiten passt das Leiterteam vor Ort flexibel an die Wetterbedingungen und die Gruppendynamik an.
          </p>
        </div>
      </div>

      <a
        href="#anmeldung"
        class="flex-shrink-0 border-2 border-[#E62E2D] bg-[#E62E2D] px-6 py-3 font-mono text-xs font-bold uppercase tracking-wider text-paper hover:bg-paper hover:text-forest-950 transition-all text-center"
      >
        Jetzt Platz sichern →
      </a>
    </div>
  </Container>
</section>
