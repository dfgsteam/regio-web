---
import BaseLayout from './BaseLayout.astro'
import Header from '../components/navigation/Header.astro'
import Footer from '../components/navigation/Footer.astro'
import type { CollectionEntry } from 'astro:content'
import { getCampRegistration } from '../lib/camps'

interface Props {
  camp: CollectionEntry<'camps'>['data']
}

const { camp } = Astro.props
const registration = await getCampRegistration(camp)

const siteUrl = Astro.site?.toString().replace(/\/$/, '')

const eventStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: camp.title,
  description: camp.story ?? camp.motto,
  image: new URL(camp.theme.assets.hero, Astro.site).toString(),
  startDate: camp.date.start.toISOString(),
  endDate: camp.date.end.toISOString(),
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  typicalAgeRange: `${camp.age.min}-${camp.age.max}`,
  organizer: { '@type': 'Organization', '@id': `${siteUrl}/#organization` },
  location: {
    '@type': 'Place',
    name: camp.location.name,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Birkenfelder Str.',
      addressLocality: 'Uder (Ortsteil Thalwenden)',
      postalCode: '37318',
      addressRegion: 'Thüringen',
      addressCountry: 'DE',
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: 51.368,
      longitude: 10.1154,
    },
  },
  offers: registration.state === 'open' && registration.url
    ? {
        '@type': 'Offer',
        url: registration.url,
        availability: 'https://schema.org/InStock',
        validThrough: registration.deadline?.toISOString(),
      }
    : registration.state === 'full'
      ? { '@type': 'Offer', availability: 'https://schema.org/SoldOut' }
      : undefined,
}

const breadcrumbStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Startseite',
      item: `${siteUrl}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Abenteuer',
      item: `${siteUrl}/abenteuer/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: `Zeltlager ${camp.year}`,
      item: `${siteUrl}/abenteuer/zeltlager-${camp.year}/`,
    },
  ],
}

const faqStructuredData =
  camp.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: camp.faq.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      }
    : undefined
---

<BaseLayout
  title={`${camp.title} – ${camp.motto}`}
  description={`${camp.motto}: ${camp.date.start.toLocaleDateString('de-DE')} – ${camp.date.end.toLocaleDateString('de-DE')} in ${camp.location.name}. Für ${camp.age.min}–${camp.age.max} Jahre.`}
  image={camp.theme.assets.hero}
  imageAlt={`Zeltlager ${camp.year} – ${camp.motto}`}
  structuredData={[eventStructuredData, faqStructuredData, breadcrumbStructuredData].filter(Boolean)}
>
  <Header />
  <div
    class="camp-theme"
    style={`--camp-bg: ${camp.theme.colors.background}; --camp-fg: ${camp.theme.colors.foreground}; --camp-accent: ${camp.theme.colors.accent};`}
  >
    <main>
      <slot />
    </main>
  </div>
  <Footer />
</BaseLayout>
